				BT.switch = function(folder, title, key, tooltip, session)
					local store = session and BT.session or BT.cfg
					BT.store[key] = store
					BT.sw[key] = folder.AddSwitch(title, function(enabled)
						if not BT.syncing then
							BT.set(key, enabled)
						end
					end, store, key, tooltip and { Tooltip = tooltip } or nil)
				end

				-- BuffTools -> Atlas: something was changed in the BuffTools menu, mirror it into the switches.
				-- Ignored until BT.push has run (BuffTools boots with its own saved values, Atlas must not take those over).
				BT.sync = function(vis, force)
					if BT.syncing or type(vis) ~= "table" or not (BT.ready or force) then
						return
					end

					local changed = false
					BT.syncing = true

					for key, sw in pairs(BT.sw) do
						local value = vis[key]
						local store = BT.store[key]

						if type(value) == "boolean" and store[key] ~= value then
							store[key] = value
							sw.SetSilent(value)

							if store == BT.cfg then
								changed = true
							end
						end
					end

					BT.syncing = false

					if changed then
						saveConfig()
					end
				end

				getgenv().BuffToolsSync = function(vis)
					BT.sync(vis)
				end

				-- runs once BuffTools is up: first time it adopts BuffTools' own settings, afterwards Atlas settings win
				BT.push = function()
					local e = btApi()

					if not (e and type(e.setOption) == "function") then
						return
					end

					if not BT.cfg.init then
						BT.cfg.init = true

						pcall(function()
							local options = e.getOptions()
							BT.sync(options, true)

							if type(options.speedVal) == "number" then
								BT.syncing = true
								BT.cfg.speedVal = options.speedVal

								if BT.speed then
									BT.speed.Set(options.speedVal)
								end

								BT.syncing = false
							end

							if (options.rbcLang == "en" or options.rbcLang == "ru") and BT.lang then
								BT.syncing = true
								BT.lang.Set(options.rbcLang)
								BT.syncing = false
							end
						end)

						saveConfig()
					else
						BT.syncing = true

						for key, value in pairs(BT.cfg) do
							if key ~= "init" then
								pcall(e.setOption, key, value)
							end
						end

						BT.syncing = false
					end

					if type(e.setHudVisible) == "function" then
						pcall(e.setHudVisible, cfg.misc.bufftoolshud ~= false)

-- BuffTools is its own ScreenGui, so the game interface can be hidden and dragged
-- without touching our tiles. Offsets are saved in bufftools_hud.json.
ExtraUI.bss = { off = {}, handles = nil, targets = nil, orig = {}, moveMode = false, gen = 0, conns = {} }

ExtraUI.bssGuis = function()

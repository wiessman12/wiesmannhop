local pathLinks = nil
local cannonLinks = nil
local jumpLinks = nil
local handlers = {}

local function findPath(from, to, useCannon, nodes, links)
	local nodePositions = nodes or pathNodes
	local nodeLinks = links or pathLinks
	local startNode = nil
	local goalNode = nil
	local huge = math.huge
	local huge2 = math.huge
	local filterList = {}
	local Leaderboards = workspace:FindFirstChild("Leaderboards")

	if Leaderboards then
		table.insert(filterList, Leaderboards)
	end

	for _, descendant in pairs(workspace.Decorations:GetDescendants()) do
		if descendant:IsA("Model") then
			table.insert(filterList, descendant)
		end
	end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = { workspace.Map, filterList, workspace.Gates }
	raycastParams.FilterType = Enum.RaycastFilterType.Include

	for k, nodePosition in pairs(nodePositions) do
		local magnitude = (from - nodePosition).magnitude
		local magnitude2 = (to - nodePosition).magnitude

		if not (not (magnitude < huge) or not (magnitude < 100) or workspace:Raycast(from, nodePosition - from, raycastParams)) then
			huge = magnitude
			startNode = k
		end

		if magnitude2 < huge2 then
			huge2 = magnitude2
			goalNode = k
		end
	end

	if not startNode or not goalNode then
		return
	end
	local magnitude = (to - from).magnitude
	local goalPosition = nodePositions[goalNode]
	local openSet = { [startNode] = { 0, magnitude, magnitude } }
	local closedSet = {}
	local cameFrom = {}
	local huge3 = math.huge

	while true do
		local currentNode = nil
		local currentG = nil
		local currentH = nil
		local huge4 = math.huge

		for k, openEntry in pairs(openSet) do
			local entryG = openEntry[1]
			local entryH = openEntry[2]
			local entryF = openEntry[3]

			if entryF < huge4 then
				currentNode = k
				currentG = entryG
				currentH = entryH
				huge4 = entryF
			end
		end

		if not currentNode then
			return
		end

		if currentH < huge3 then
			huge3 = currentH
		end

		openSet[currentNode] = nil
		closedSet[currentNode] = true
		if currentNode == goalNode then
			break
		end
		local currentPosition = nodePositions[currentNode]

		for k, link in pairs(nodeLinks[currentNode]) do
			local neighborPosition = nodePositions[k]

			if not closedSet[k] then
				local baseCost = currentG
				local newCost

				if not useCannon or link.label == "" or link.label == "Jump" or link.label == "Jump1" or link.label == "CoconutJump" or link.label == "MultiJump" or link.label == "Drop" or link.label == "Wait" or (from - to).magnitude < 300 then
					newCost = baseCost + (neighborPosition - currentPosition).magnitude
				else
					newCost = baseCost + (from - currentPosition).magnitude * 0.7
				end

				if not openSet[k] then
					local v92 = newCost
					local magnitude2 = useCannon and 0 or (neighborPosition - goalPosition).magnitude
					openSet[k] = { v92, magnitude2, v92 + magnitude2 }
					cameFrom[k] = { parent = currentNode, connection = link }
				elseif newCost < openSet[k][1] then
					openSet[k][1] = newCost
					openSet[k][3] = newCost + openSet[k][2]
					cameFrom[k] = { parent = currentNode, connection = link }
				end
			end
		end
	end

	local pathPoints = {}
	local parent = goalNode

	while true do
		local cameFromEntry = cameFrom[parent]

		if not cameFromEntry then
			break
		else
			table.insert(pathPoints, 1, { Position = nodePositions[parent], Label = cameFromEntry.connection.label })
			parent = cameFromEntry.parent
		end
	end

	table.insert(pathPoints, { Position = to, Label = "" })
	return pathPoints
end

local function walkTo(target, timeout, range)
	if getHumanoid().Health == 0 then
		error("return", 0)
	end

	if range ~= 0 then
		if distanceTo(target, true) < (range or 5) then
			return
		end
	end

	getHumanoid():MoveTo(target)
	local now, finished = os.clock()

	connections:Add("movetofinished", getHumanoid().MoveToFinished:Connect(function()
		finished = true
		connections:Cancel("movetofinished")
	end))

	if timeout == true then
		timeout = 2 + distanceTo(target, true) / getHumanoid().WalkSpeed
	end

	while not finished do
		if not (not (os.clock() - now < (timeout or 5)) or not (getHumanoid().Health > 0)) then
			if range == 0 then
				RunService.Heartbeat:Wait()
				continue
			elseif (range or 5) < distanceTo(target, true) then
				RunService.Heartbeat:Wait()
				continue
			end
		end

		break
	end

	if range == 0 then
		local elapsed = os.clock() - now
		local timeLimit = timeout or 5

		if timeLimit <= elapsed then
			error("return", 0)
		end
	elseif not ((range or 5) < distanceTo(target, true)) then
		if (timeout or 5) <= os.clock() - now then
			error("return", 0)
			return
		end
	else
		error("return", 0)
		return
	end
end


				return
			end

			while not matchGame.Grid.InputActive and os.clock() - now < 4 do
				RunService.Heartbeat:Wait()
			end

			while not (not (attempts < 20) or countLabel.Text == "0" or not (#tileList > 0)) do
				attempts += 1
				local pairA = nil
				local pairB = nil
				local skipTiles = {}

				for i, tile in ipairs(tileList) do

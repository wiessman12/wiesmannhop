					local PALETTE = {
						{ 220, 50, 50 }, { 240, 130, 40 }, { 245, 210, 60 }, { 140, 215, 70 }, { 40, 170, 90 }, { 30, 175, 165 },
						{ 50, 200, 230 }, { 70, 150, 240 }, { 45, 90, 200 }, { 85, 70, 190 }, { 150, 70, 200 }, { 210, 70, 170 },
						{ 250, 130, 180 }, { 200, 50, 100 }, { 130, 85, 55 }, { 110, 25, 35 }, { 20, 35, 90 }, { 20, 70, 45 },
						{ 245, 245, 245 }, { 190, 190, 195 }, { 120, 120, 125 }, { 60, 60, 65 }, { 30, 30, 34 }, { 10, 10, 12 },
					}

					local function parseColor(text)
						local s = string.gsub(tostring(text), "%s", "")
						s = string.lower(s)

						local hex = string.match(s, "^#?(%x%x%x%x%x%x)$")

						if hex then
							return tonumber(string.sub(hex, 1, 2), 16), tonumber(string.sub(hex, 3, 4), 16), tonumber(string.sub(hex, 5, 6), 16)
						end

						local short = string.match(s, "^#(%x%x%x)$")

						if short then
							local r, g, b = string.sub(short, 1, 1), string.sub(short, 2, 2), string.sub(short, 3, 3)
							return tonumber(r .. r, 16), tonumber(g .. g, 16), tonumber(b .. b, 16)
						end

						local r, g, b = string.match(s, "^rgb%((%d+),(%d+),(%d+)%)$")

						if not r then
							r, g, b = string.match(s, "^(%d+)[,;](%d+)[,;](%d+)$")
						end

						if r then
							r, g, b = tonumber(r), tonumber(g), tonumber(b)

							if r <= 255 and g <= 255 and b <= 255 then
								return r, g, b
							end
						end

						return nil
					end


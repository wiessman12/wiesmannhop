	local function findEggTile(eggGui, eggImage)
		for _, child in ipairs(eggGui.EggsBox.EggsFrame:GetChildren()) do
			if child.Name ~= "GuiTile" then
				continue
			end
			local objCard = child.StageGrow.StagePop.StageFlip.ObjCard
			if objCard.ObjContent.ObjImage.Image ~= eggImage then
				continue
			end

			if objCard.ObjContent.ObjImage.ImageTransparency ~= 0 then
				continue
			end
			return objCard.ObjButton
		end
	end


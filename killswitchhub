  if ExtraUI.boostPrompt then
    ExtraUI.boostPrompt.Visible = ExtraUI.boost.watch == true
    ExtraUI.boostPrompt.Text = txt
    ExtraUI.boostPrompt.TextColor3 = ready and Color3.fromRGB(120, 220, 140) or Color3.fromRGB(255, 214, 214)
  end
end


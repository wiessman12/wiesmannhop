				elseif not (sproutType ~= "Rare" or v123.rarity ~= "Basic") then
					v123 = { rarity = sproutType, v = k, field = field }
				elseif sproutType ~= "Moon" or not (v123.rarity == "Basic" or v123.rarity == "Rare") then

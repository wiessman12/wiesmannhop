				if not (not printerTime or not (workspace:GetServerTimeNow() - printerTime <= 3600)) then
					setTimer(name, os.time() + (3600 - (workspace:GetServerTimeNow() - printerTime)))
					return
				end
			end

			local selectedCount = 0
			local eggType = nil

			if cfg.toys.printereggs then
				for k in pairs(cfg.toys.printereggs) do
					selectedCount += 1
				end
			end

			if selectedCount == 0 then
				controls["Auto Sticker Printer"].Set(false)
				ui.Notify("Auto Sticker Printer", "No egg types selected")
				return
			end

			local inventoryItems = inventory:Fetch()

			for k in pairs(cfg.toys.printereggs) do

  end
end)


local MapCut = { shown = true, saved = {}, radius = 55 }

local Speed = {
  on = false,
  target = ExtraUI.speedVal or 90, -- custom value is typed in the FPS tab and saved in the config
  hipBase = nil,
  physSaved = nil,
  physSet = false,
}

function Speed.hum()
  local char = player.Character
  if not char then return nil end
  return char:FindFirstChildOfClass("Humanoid")
end

function Speed.root()
  local char = player.Character
  return char and char:FindFirstChild("HumanoidRootPart")
end

-- Soft anti-glide: stance + friction only. Do NOT rewrite velocity —
-- BSS haste / custom move breaks if we clamp AssemblyLinearVelocity.
function Speed.clearAntiGlide()
  local h = Speed.hum()
  local root = Speed.root()
  if h and type(Speed.hipBase) == "number" then
    pcall(function()
      h.HipHeight = Speed.hipBase
    end)
  end
  Speed.hipBase = nil
  if root and Speed.physSet then
    pcall(function()
      if Speed.physSaved ~= nil then
        root.CustomPhysicalProperties = Speed.physSaved
      end
    end)
  end
  Speed.physSet = false
  Speed.physSaved = nil
end

function Speed.applyAntiGlide(h, root)
  if not h or not root then return end
  if type(Speed.hipBase) ~= "number" then
    Speed.hipBase = h.HipHeight
  end
  local want = math.max(Speed.hipBase, 2.2)
  if math.abs(h.HipHeight - want) > 0.05 then
    pcall(function()
      h.HipHeight = want
    end)
  end
  if not Speed.physSet then
    Speed.physSaved = root.CustomPhysicalProperties
    Speed.physSet = true
    pcall(function()
      root.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.7, 0, 1, 1)
    end)
  end
end

function Speed.apply()
  local h = Speed.hum()
  if not h then return end
  if Speed.on then
    h.WalkSpeed = Speed.target
    Speed.applyAntiGlide(h, Speed.root())
  else
    -- never force 16 — that kills BSS haste and feels like a snail
    Speed.clearAntiGlide()
  end
end

function Speed.set(on)
  Speed.on = on == true
  ExtraUI.vis.speed = Speed.on
  Speed.apply()
end

-- custom walk speed: any number 1..500 (NaN / junk is ignored); re-applied at once when the toggle is on
function Speed.setTarget(v)
  v = tonumber(v)
  if not v or v ~= v then return false end
  v = math.clamp(math.floor(v * 10 + 0.5) / 10, 1, 500)
  Speed.target = v
  ExtraUI.speedVal = v
  if Speed.on then Speed.apply() end
  savePositions()
  return true
end

function Speed.start()
  Speed.on = ExtraUI.vis.speed == true
  -- only touch WalkSpeed when the toggle is actually on
  if Speed.on then
    Speed.apply()
  end
  Session.track(RunService.Heartbeat:Connect(function()
    if not Session.alive or not Speed.on then return end
    local h = Speed.hum()
    if not h then return end
    if math.abs(h.WalkSpeed - Speed.target) > 0.05 then
      h.WalkSpeed = Speed.target
    end
    local root = Speed.root()
    if root then
      Speed.applyAntiGlide(h, root)
    end
  end))
  Session.track(player.CharacterAdded:Connect(function()
    Speed.clearAntiGlide()
    task.wait(0.35)
    if Session.alive and Speed.on then
      Speed.apply()
    end
  end))
end

-- Body scale anti-glider (no skin change) — FPS tab toggle
local AntiGlider = {
  on = false,
  -- per-axis scales while On (Off = 1 on every axis)
  WIDTH_SCALE = 1.6,
  DEPTH_SCALE = 1.0,
  HEIGHT_SCALE = 2.0,
  HEAD_SCALE = 1.0,
}
AntiGlider.names = { "BodyWidthScale", "BodyDepthScale", "BodyHeightScale", "HeadScale" }
AntiGlider.value = function(name)
  if not AntiGlider.on then return 1 end
  if name == "BodyWidthScale" then return AntiGlider.WIDTH_SCALE end
  if name == "BodyDepthScale" then return AntiGlider.DEPTH_SCALE end
  if name == "BodyHeightScale" then return AntiGlider.HEIGHT_SCALE end
  return AntiGlider.HEAD_SCALE
end

function AntiGlider.setVal(char, hum, name, value)
  local v = char:FindFirstChild(name) or hum:FindFirstChild(name)
  if not v then
    v = Instance.new("NumberValue")
    v.Name = name
    v.Value = 1
    v.Parent = hum
  end
  if v:IsA("NumberValue") or v:IsA("IntValue") then
    v.Value = value
  end
end

function AntiGlider.apply(char)
  if not char then return end
  local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
  if not hum then return end
  pcall(function()
    hum.AutomaticScalingEnabled = false
  end)
  for i = 1, #AntiGlider.names do
    local nm = AntiGlider.names[i]
    AntiGlider.setVal(char, hum, nm, AntiGlider.value(nm))
  end
  task.wait(0.1)
  pcall(function()
    hum.AutomaticScalingEnabled = true
  end)
end

function AntiGlider.set(on)

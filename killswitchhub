						local keypoints = {}

						for i = 0, 6 do
							keypoints[#keypoints + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((i % 6) / 6, 1, 1))
						end

						return ColorSequence.new(keypoints)
					end)()

					local function readRecent()
						local list = {}

						for hex in string.gmatch(tostring(cust.recent or DEFAULT_RECENT), "%x%x%x%x%x%x") do
							list[#list + 1] = string.upper(hex)
						end

						if #list == 0 then
							for hex in string.gmatch(DEFAULT_RECENT, "%x%x%x%x%x%x") do
								list[#list + 1] = hex
							end
						end

						return list
					end

					local function pushRecent(r, g, b)
						local hex = string.format("%02X%02X%02X", byte(r), byte(g), byte(b))
						local list = readRecent()

						for i = #list, 1, -1 do
							if list[i] == hex then
								table.remove(list, i)
							end
						end

						table.insert(list, 1, hex)

						while #list > 6 do
							table.remove(list)
						end

						cust.recent = table.concat(list, ",")

						for _, redraw in ipairs(recentViews) do
							redraw()
						end
					end


	discord.Split = function(payload, extraEmbeds, text, title)
		local charCount = 0
		local existingLength = 0

		for _, embed in ipairs(payload.embeds) do
			if embed.description then
				existingLength += #embed.description
			end
		end

		for _, embed in ipairs(payload.embeds) do
			for _, field in ipairs(embed.fields) do
				existingLength += #field.value
			end
		end

		local parts = text:split("\n")
		local embedIndex = #payload.embeds + 1
		local partIndex = 1
		local chunk = {}

		while partIndex <= #parts do
			if not (existingLength + charCount + #parts[partIndex] + 1 < 3800) then
				table.insert(extraEmbeds, {
					description = "```" .. table.concat(chunk, "\n") .. "```",
					author = { name = title, icon_url = getUrl("icon.png") },
				})

				return
			end

			table.insert(chunk, parts[partIndex])
			charCount += #parts[partIndex]
			partIndex += 1
		end

		if #chunk > 0 then
			payload.embeds[embedIndex] = {
				description = "```" .. table.concat(chunk, "\n") .. "```",
				author = { name = title, icon_url = getUrl("icon.png") },
			}
		end
	end


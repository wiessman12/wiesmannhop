	isPathClear = function(target, avoid, v71, v72, v73)
		local position2 = getRootPart().Position
		local offset = target - position2
		local magnitude = offset.magnitude
		local unit = offset.unit

		for k, radius in pairs(avoid) do
			local timestamp = nil

			if radius > 100 then
				timestamp = radius
				radius = 24
			end

			local position3

			if type(k) ~= "vector" then
				if k.Name == true then
					position3 = k.Position
				else
					local Plane = k:FindFirstChild("Plane")

					if not Plane then
						position3 = k.Position
					else
						position3 = Plane.Position
					end
				end
			else
				position3 = k
			end

			if (target - position3).magnitude < radius then
				return true
			end

			if not v72 and not (radius ~= 24 or not (2.2 - (os.time() - timestamp) < magnitude / getHumanoid().WalkSpeed)) then
				return true
			end

			if v71 then
				if not ((v73 and radius - 6 or radius) < (position2 - position3).magnitude) then
					continue
				end
			end

			if not ((position3 - (position2 + offset * math.clamp((position3 - position2):Dot(unit) / magnitude, 0, 1))).magnitude < radius) then
				continue
			end
			return true
		end
	end

	randomFieldPosition = function(constraints, widen, v71)
		local x = vector.X
		local z = vector.Z

		if not constraints.avoid and not constraints.range then
			local y = position.Y
			local z2 = position.Z
			return Vector3.new(position.X + math.random(-x / 2, x / 2), y, z2 + math.random(-z / 2, z / 2))
		end

		if widen then
			x += 20
			z += 20
		end

		local attempts = 0
		local vector3, vector4, vector5

		while true do
			if not (attempts < 100) then
				if not constraints.avoid or not constraints.range then
					if v71 then
						local attempts2 = 0

						while true do
							if not (attempts2 < 100) then
								task.wait(0.1)
								return
							else
								local y = position.Y
								local z2 = position.Z
								vector3 = Vector3.new(position.X + math.random(-x / 2, x / 2), y, z2 + math.random(-z / 2, z / 2))
								attempts2 += 1
								if not isPathClear(vector3, constraints.avoid, true, true) then
									break
								end
							end
						end

						return vector3
					end
				else
					local attempts2 = 0

					while true do
						if not (attempts2 < 100) then
							task.wait(0.1)
							return
						else
							local y = position.Y
							local z2 = position.Z
							vector4 = Vector3.new(position.X + math.random(-x / 2, x / 2), y, z2 + math.random(-z / 2, z / 2))
							attempts2 += 1
							if not isPathClear(vector4, constraints.avoid, true, constraints.rbc) then
								break
							end
						end
					end

					return vector4
				end

				task.wait(0.1)
				return
			else
				local y = position.Y
				local z2 = position.Z
				vector5 = Vector3.new(position.X + math.random(-x / 2, x / 2), y, z2 + math.random(-z / 2, z / 2))
				attempts += 1

				if not constraints.avoid then
					if not constraints.avoid and (constraints.origin - vector5).magnitude < constraints.range then
						return vector5
					end
					continue
				end

				if not constraints.range then
					if not isPathClear(vector5, constraints.avoid, true, constraints.rbc) then
						return vector5
					end

					if not constraints.avoid and (constraints.origin - vector5).magnitude < constraints.range then
						return vector5
					end
					continue
				end

				if not ((constraints.origin - vector5).magnitude < constraints.range) then
					if not constraints.avoid and (constraints.origin - vector5).magnitude < constraints.range then
						return vector5
					end
					continue
				end

				if not isPathClear(vector5, constraints.avoid, true, constraints.rbc) then
					return vector5
				end

				if not constraints.avoid and (constraints.origin - vector5).magnitude < constraints.range then
					break
				end
			end
		end

		return vector5
	end


      end
    else
      local remain = item.iv - (now - (item.last or 0))
      if (item.last or 0) == 0 then remain = 0 end
      txt = ExtraUI.fmtCd(remain)
    end
    if item._cd ~= txt then
      item._cd = txt
      item.cd.Text = txt
    end
    item.cd.TextColor3 = on and Color3.fromRGB(255, 236, 242) or Color3.fromRGB(160, 140, 165)
  end
end


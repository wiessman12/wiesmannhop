	local function killMondo(v126, v127)
		local mondo = tracked.mondo

		if not mondo and cfg.combat.mondoprep then
			local text = workspace.Clock.SurfaceGui.TextLabel.Text
			local minutesText, secondsText = string.match(text, "(%d+):(%d+)")

			if not minutesText and not secondsText then
				secondsText = string.match(text, "%d+")
			end

			local secondsRemaining

			if not minutesText then
				secondsRemaining = tonumber(secondsText)
			else
				secondsRemaining = tonumber(minutesText) * 60 + tonumber(secondsText)
			end

			if not secondsRemaining or cfg.combat.mondopreptime < secondsRemaining then
				return
			end
			logger.log("Preparing to kill Mondo Chick")

			if not (not cfg.combat.demonmask or not cfg.combat.dmwhitelist or not cfg.combat.dmwhitelist["Mondo Chick"]) then
				if not localPlayer.Character:FindFirstChild("Demon Mask") then
					equipAccessory("Demon Mask")
				end
			end

			setField("Mountain Top Field")
			local now = os.clock()

			while not tracked.mondo and os.clock() - now < 60 do
				if not RunService.Heartbeat:Wait() then
					break
				end
				reportStatus(1, "Mountain Top Field")
				goToField()

				if not (not cfg.autofarm.autosprinkler or farmState.field == currentField.Name) then
					farmState:Handle()
				end

				if cfg.face.shiftlock then
					input:handleShiftLock(true)
				end

				farmStep({})
			end

			if not tracked.mondo then
				return
			end
			mondo = tracked.mondo
		elseif not mondo then
			return
		end

		local HumanoidRootPart = mondo:FindFirstChild("HumanoidRootPart")
		if not HumanoidRootPart then
			return
		end

		if not v126 and cfg.combat.mondochicktime < 15 then
			local scale = nil

			for _, child in ipairs(mondo.Head.GuiAttachment.MonsterGui:GetChildren()) do
				if not (child.Name ~= "BarRow" or not child:FindFirstChild("Bar") or not string.find(child.Bar.NumberLabel.Text, "Time")) then

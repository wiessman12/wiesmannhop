							end
						end
					end
				end

				if not pairA or not pairB then
					local randomIndex = math.random(#tileList)
					local randomTile = tileList[randomIndex]
					local retries = 0

					while not (not skipTiles[randomTile] and not matchedFlags[randomIndex]) do
						if retries > 100 then
							error("return", 0)
						end

						retries += 1
						randomIndex = math.random(#tileList)
						randomTile = tileList[randomIndex]
					end

					local now2 = os.clock()
					secureCall(gameApi.MemoryMatch, matchGame, secureCall(matchGame.Grid.GetTileAtIndex, matchGame.Grid, randomIndex))

					while not matchGame.Grid.InputActive and not matchGame.Finished and os.clock() - now2 < 2 do
						RunService.Heartbeat:Wait()
					end

					task.wait(0.15)
				else
					local objCard = pairA[1].StageGrow.StagePop.StageFlip.ObjCard.ObjContent.GuiTile.StageGrow.StagePop.StageFlip.ObjCard
					local objCard2 = pairB[1].StageGrow.StagePop.StageFlip.ObjCard.ObjContent.GuiTile.StageGrow.StagePop.StageFlip.ObjCard
					local now2 = os.clock()

					if not objCard.ObjBorder.Visible then
						secureCall(gameApi.MemoryMatch, matchGame, secureCall(matchGame.Grid.GetTileAtIndex, matchGame.Grid, pairA[2]))

						while not matchGame.Grid.InputActive and not matchGame.Finished and os.clock() - now2 < 2 do
							RunService.Heartbeat:Wait()
						end

						task.wait(0.15)
					end

					if not objCard2.ObjBorder.Visible then
						secureCall(gameApi.MemoryMatch, matchGame, secureCall(matchGame.Grid.GetTileAtIndex, matchGame.Grid, pairB[2]))

						while not matchGame.Grid.InputActive and not matchGame.Finished and os.clock() - now2 < 2 do
							RunService.Heartbeat:Wait()
						end

						task.wait(0.15)
					end

					matchedFlags[pairA[2]] = true
					matchedFlags[pairB[2]] = true
				end
			end

			local now2 = os.clock()

			while not (not gameGui.MinigameLayer.Visible or not (os.clock() - now2 < 6)) do
				RunService.Heartbeat:Wait()
			end

			task.wait(0.1)

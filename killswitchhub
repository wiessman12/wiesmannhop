local function stopHubTweens()
  for i = 1, #hubTweens do
    local tw = hubTweens[i]
    pcall(function() tw:Cancel() end)
  end
  hubTweens = {}
end

local function openHub()
  stopHubTweens()
  hub.Visible = true
  hubDim.Visible = true
  hubShadow.Visible = true
  hub.AnchorPoint = Vector2.new(0.5, 0.5)
  local goal = hub.Position
  hub.Position = goal + UDim2.fromOffset(0, 22)
  hubScale.Scale = 0.92
  hub.BackgroundTransparency = 0.22
  hubDim.BackgroundTransparency = 1
  hubShadow.BackgroundTransparency = 0.85
  local info = TweenInfo.new(0.26, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
  local tPos = TweenService:Create(hub, info, { Position = goal, BackgroundTransparency = 0.04 })
  local tScale = TweenService:Create(hubScale, info, { Scale = 1 })
  local tDim = TweenService:Create(hubDim, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.38 })
  local tSh = TweenService:Create(hubShadow, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.5 })
  hubTweens = { tPos, tScale, tDim, tSh }
  tPos:Play()
  tScale:Play()
  tDim:Play()
  tSh:Play()
  syncHubShadow()
  if type(ExtraUI.refreshHubStatus) == "function" then ExtraUI.refreshHubStatus() end

				local cardImageId = string.match(objCard.ObjContent.ObjImage.Image, "%d+")

				if cardImageId ~= "3690982763" then
					local matchCount, firstMatch, secondMatch = matcher.Get(tileList, matchedFlags, cardImageId, TextCount, true)

					if matchCount == 2 then
						matchedFlags[firstMatch[2]] = true
						matchedFlags[secondMatch[2]] = true
					end
				end
			end


	handlers["Glue Dispenser"] = function(target)
		if distanceTo(target) > 500 then
			goTo(workspace.Toys["Gummy Bee Claimer"].Platform.Position + Vector3.new(-2, 0, 8), "Gummy Bee Claimer")

			if cfg.vars.movement == "Tween" then
				task.wait(0.2)
			end

			waitForLanding()
			disableJumpRequests()
			task.wait(1)
			inventory:Use("Gumdrops")
			local now = os.clock()

			while distanceTo(target) > 500 and os.clock() - now < 4 do
				RunService.Heartbeat:Wait()
			end

			if distanceTo(target) > 500 then
				error("return", 0)
			end
		end

		walkTo(target, true, 10)
	end

	handlers.MultiJump = function(target)
		local now = os.clock()

		while distanceTo(target, true) > 8 do
			if not RunService.Heartbeat:Wait() then
				break
			end

			if os.clock() - now > 2 or getHumanoid().Health == 0 then
				error("return", 0)
			else
				getHumanoid():MoveTo(target)
				local y = target.Y

				if math.abs(getRootPart().Position.Y - y) > 2 then
					disableJumpRequests()
				end
			end
		end
	end

	handlers.CoconutJump = function(target)
		local now = os.clock()

		while true do
			local heartbeat

			if distanceTo(target, true) > 4 then
				heartbeat = RunService.Heartbeat

				if heartbeat:Wait() then
					if os.clock() - now > 2 or getHumanoid().Health == 0 then
						error("return", 0)
					else
						getHumanoid():MoveTo(target)
						disableJumpRequests()
					end

					continue
				end

				break
			end

			local y = target.Y

			if math.abs(getRootPart().Position.Y - y) > 2 then
				heartbeat = RunService.Heartbeat

				if heartbeat:Wait() then
					if os.clock() - now > 2 or getHumanoid().Health == 0 then
						error("return", 0)
					else
						getHumanoid():MoveTo(target)
						disableJumpRequests()
					end

					continue
				end
			end

			break
		end
	end


FieldFx.SmilePanel = { items = {}, n = 0, open = false, rows = {}, root = nil, arrow = nil, body = nil, tw = nil,
  cw = 150, ew = 156, hh = 24, rh = 16, max = 12 }
do
  local P = FieldFx.SmilePanel
  local CW, EW, HH, RH = P.cw, P.ew, P.hh, P.rh
  local HONEY, HSTROKE = Color3.fromRGB(255, 226, 128), Color3.fromRGB(14, 13, 12)

  function P.layout()
    local n = #P.items
    local h = P.open and (HH + RH * math.max(n, 1) + 4) or HH
    local w = P.open and EW or CW
    if P.tw then pcall(function() P.tw:Cancel() end) end
    if P.root then
      pinOnScreen(P.root, w, h)
      P.tw = TweenService:Create(P.root, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(w, h),
      })
      P.tw:Play()
      local tw = P.tw
      tw.Completed:Connect(function()
        if P.tw == tw and P.root then pinOnScreen(P.root, w, h) end
      end)
    end
    if P.arrow then P.arrow.Text = P.open and "›" or "‹" end
    if P.body then P.body.Visible = P.open end
  end

  local function newRow(i)
    local fr = Instance.new("Frame")
    fr.BackgroundTransparency = 1
    fr.BorderSizePixel = 0
    fr.Size = UDim2.new(1, -8, 0, RH)
    fr.Position = UDim2.fromOffset(6, (i - 1) * RH)
    fr.ZIndex = 8
    fr.Parent = P.body
    local tx = Instance.new("TextLabel")
    tx.BackgroundTransparency = 1
    tx.Font = Enum.Font.GothamBold
    tx.TextSize = 12
    tx.TextColor3 = HONEY
    tx.TextXAlignment = Enum.TextXAlignment.Left
    tx.Position = UDim2.fromOffset(0, 0)
    tx.Size = UDim2.new(1, 0, 1, 0)
    tx.ZIndex = 8
    tx.Parent = fr
    tx.TextStrokeColor3 = HSTROKE
    tx.TextStrokeTransparency = 0.1
    useFont(tx)
    P.rows[i] = { fr = fr, tx = tx }
    return P.rows[i]
  end

  function P.paint()
    if not P.body then return end
    local items = P.items
    local icon = FieldFx.Notif.asset()
    if P.hic then P.hic.Image = icon end
    for i = 1, math.max(#items, #P.rows, 1) do
      local row = P.rows[i] or newRow(i)
      local it = items[i]
      if it then
        row.tx.Text = "+" .. FieldFx.Notif.fmt(it.g)
        row.tx.TextColor3 = HONEY
        row.fr.Visible = true
      elseif i == 1 then
        row.tx.Text = "—"
        row.tx.TextColor3 = Theme.muted
        row.fr.Visible = true
      else
        row.fr.Visible = false
      end
    end
    P.layout()
  end

  function P.add(amount)
    P.n = P.n + 1
    P.items[#P.items + 1] = { n = P.n, g = amount }
    while #P.items > P.max do table.remove(P.items, 1) end
    P.paint()
  end

  function P.clear()
    P.items = {}
    P.n = 0
    P.paint()
  end

  local root = Instance.new("Frame")
  root.Name = "__smilelog"
  root:SetAttribute("BTTile", true)
  root.Size = UDim2.fromOffset(CW, HH)
  local sp = savedPos["__smilelog"]
  root.Position = sp and UDim2.new(sp.sx or 0, sp.x, sp.sy or 0, sp.y) or UDim2.new(1, -CW, 0.28, 0)
  root.Active = true
  root.BackgroundColor3 = Color3.fromRGB(10, 10, 12)

							end
						end)

						hit.MouseButton1Click:Connect(function()
							popup.Visible = not popup.Visible

							if popup.Visible and not panelBuilt then
								buildPanel()
							end

							folder.Refresh()
						end)

						setColor(num(prefix .. "r", defaults[1]), num(prefix .. "g", defaults[2]), num(prefix .. "b", defaults[3]), true)

						local api = {}

						api.Set = function(r, g, b)
							setColor(r, g, b)
						end

						api.Redraw = function()
							setColor(num(prefix .. "r", defaults[1]), num(prefix .. "g", defaults[2]), num(prefix .. "b", defaults[3]), true)
						end

						pickers[prefix] = api
						return api
					end


	do
		local function amuletStatKind(statText)
			if string.find(statText, "+Passive:") then
				return "+Passive:"
			end

			if string.find(statText, "-%d*%%") then
				return "-%"
			end

			if string.find(statText, "%%") then
				return "+%"
			end

			if not string.find(statText, "+") then
				return "x"
			end
			return "+"
		end

		local function amuletMatches(modConfig, amuletTitle)
			local popupLines = {}

			for match in string.gmatch(localPlayer.PlayerGui.ScreenGui.RewardsPopUp.AmuletFrame.InfoNew.Text, "[^\r\n]+") do
				table.insert(popupLines, match)
			end

			if not state.amulets then
				state.amulets = HttpService:JSONDecode(game:HttpGet(getUrl("amulets.json")))
			end

			local amuletPools = state.amulets[amuletTitle]
			local hasMods = nil

			for _, modGroup in pairs(modConfig) do
				for k, modEntry in pairs(modGroup) do
					if not (k == "Amount" or not modEntry[1]) then
						hasMods = true
						break
					end
				end
			end

			if not hasMods then
				ui.Notify("Auto " .. amuletPools, "No mods configured")
				return
			end

			for k, groupMods in pairs(modConfig) do
				local poolInfo = amuletPools[tonumber(string.match(k, "%d+"))]
				local select = poolInfo and poolInfo.Select or 1
				local wantedCount = 0
				local requiredCount = 0
				local matchedCount = 0

				for k2, modOption in pairs(groupMods) do
					if not (k2 == "Amount" or not modOption[1]) then
						wantedCount += 1

						if modOption[2] then
							requiredCount += 1
						end
					end
				end

				if select < requiredCount then
					ui.Notify("Auto " .. amuletPools, "Required mods exceed pool amount")
					return
				end

				if not (wantedCount > 0) then
					continue
				end
				local neededMatches = wantedCount

				if select < neededMatches then
					neededMatches = select
				end

				for k2, wantedMod in pairs(groupMods) do
					if not (k2 == "Amount" or not wantedMod[1]) then
						for _, popupLine in ipairs(popupLines) do
							if string.match(popupLine, "%s(.+)") ~= string.match(k2, "%s(.+)") or amuletStatKind(popupLine) ~= amuletStatKind(k2) then
								continue
							end
							local amountText, percentSign, statName = string.match(string.gsub(popupLine, ",", ""), "([x+%-]?%d+%.?%d*)(%%?) (.+)")

							if not amountText then
								if not string.match(popupLine, "%+Passive: (.+)") then
									continue
								end
								matchedCount += 1
								break
							end

							local lineValue = tonumber(string.sub(amountText, 2)) or tonumber(amountText)

							if string.find(popupLine, "%", 1, true) then
								lineValue /= 100
							end

							if wantedMod[3] <= lineValue then
								matchedCount += 1
								break
							end

							if not wantedMod[2] then
								continue
							end
							return
						end
					end

					if matchedCount ~= neededMatches then
						continue
					end
					break
				end

				if matchedCount ~= neededMatches then
					return
				end
			end

			return true
		end


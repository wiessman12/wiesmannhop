function Region.paintPing()
  local ms
  pcall(function()
    local sec = player:GetNetworkPing()
    if type(sec) == "number" and sec >= 0 then
      ms = sec * 1000
    end
  end)
  if type(ms) ~= "number" then
    pcall(function()
      local folder = game:GetService("Stats").Network.ServerStatsItem
      local item = folder:FindFirstChild("NetworkPing")
      if item then
        local v = item:GetValue()
        if type(v) == "number" then
          ms = v < 10 and (v * 1000) or v
        end
      end
    end)
  end
  if type(ms) ~= "number" then
    Region.ping.Text = "—"
    Region.ping.TextColor3 = Color3.fromRGB(138, 128, 128)
    return
  end
  ms = math.floor(ms + 0.5)
  Region.ping.Text = tostring(ms) .. " ms"
  if ms < 100 then
    Region.ping.TextColor3 = Color3.fromRGB(98, 214, 120)
  else
    Region.ping.TextColor3 = Color3.fromRGB(240, 196, 72)
  end
end


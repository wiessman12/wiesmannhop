			do
				local function buildCustomization(tab)
					if type(cfg.customization) ~= "table" then
						cfg.customization = {}
					end

					local cust = cfg.customization
					local weak = { __mode = "k" }
					local sliders = {}
					local switches = {}
					local pickers = {}
					local fontDropdown = nil

					local registry = {
						accent = setmetatable({}, weak),
						bg = setmetatable({}, weak),
						bg2 = setmetatable({}, weak),
						panel = setmetatable({}, weak),
						input = setmetatable({}, weak),
						track = setmetatable({}, weak),
					}

					local texts = setmetatable({}, weak)
					local gradients = setmetatable({}, weak)
					local FONTS = { "Default", "Gotham", "Ubuntu", "Code", "Arcade", "Nunito", "Highway", "SciFi" }

					----------------------------------------------------------------
					-- helpers
					----------------------------------------------------------------
					local function num(key, default)
						local value = tonumber(cust[key])

						if value == nil then
							return default
						end

						return value
					end

					local function byte(value)
						return math.clamp(math.floor((tonumber(value) or 0) + 0.5), 0, 255)
					end

					local function rgbOf(prefix, r, g, b)
						return Color3.fromRGB(byte(num(prefix .. "r", r)), byte(num(prefix .. "g", g)), byte(num(prefix .. "b", b)))
					end

					local function colorKey(color)
						return math.floor(color.R * 255 + 0.5) * 65536 + math.floor(color.G * 255 + 0.5) * 256 + math.floor(color.B * 255 + 0.5)
					end

					local function hexOf(color)
						return string.format("%02X%02X%02X", byte(color.R * 255), byte(color.G * 255), byte(color.B * 255))
					end

					local function shift(color, dr, dg, db)
						return Color3.fromRGB(byte(color.R * 255 + dr), byte(color.G * 255 + dg), byte(color.B * 255 + db))
					end

					local function setIf(object, property, value)
						local current = object[property]
						local valueType = typeof(value)

						if valueType == "number" then
							if math.abs(current - value) > 0.001 then
								object[property] = value
							end
						elseif valueType == "Color3" then
							if colorKey(current) ~= colorKey(value) then
								object[property] = value
							end
						elseif current ~= value then
							object[property] = value
						end
					end

					local function isText(inst)
						return inst:IsA("TextButton") or inst:IsA("TextLabel") or inst:IsA("TextBox")
					end

					-- original palette of the menu -> role
					local ROLE_BY_KEY = {
						[colorKey(Color3.fromRGB(41, 74, 122))] = "accent",
						[colorKey(Color3.fromRGB(21, 22, 23))] = "bg",
						[colorKey(Color3.fromRGB(30, 30, 30))] = "bg2",
						[colorKey(Color3.fromRGB(42, 42, 42))] = "panel",
						[colorKey(Color3.fromRGB(52, 53, 56))] = "input",
						[colorKey(Color3.fromRGB(65, 67, 71))] = "track",
					}

					if typeof(_G.uicolor) == "Color3" then
						ROLE_BY_KEY[colorKey(_G.uicolor)] = "accent"
					end

					local function palette()
						local accent = rgbOf("accent", 41, 74, 122)
						local accent2 = rgbOf("grad", 70, 110, 180)

						if cust.rainbow == true then
							local hue = (os.clock() * 0.08) % 1
							accent = Color3.fromHSV(hue, 0.7, 0.9)
							accent2 = Color3.fromHSV((hue + 0.18) % 1, 0.7, 0.9)
						end

						local bg = rgbOf("bg", 21, 22, 23)
						local panel = rgbOf("panel", 42, 42, 42)

						return {
							accent = accent,
							accent2 = accent2,
							bg = bg,
							bg2 = shift(bg, 9, 8, 7),
							bgend = rgbOf("bgend", 30, 34, 48),
							panel = panel,
							input = shift(panel, 10, 11, 14),
							track = shift(panel, 23, 25, 29),
						}
					end

					----------------------------------------------------------------
					-- menu styling
					----------------------------------------------------------------
					local function setGradient(inst, enabled, color0, color1, rotation)
						local gradient = inst:FindFirstChild("AtlasGradient")

						if enabled then
							if not gradient then
								gradient = Instance.new("UIGradient")
								gradient.Name = "AtlasGradient"
								gradient.Parent = inst
							end

							gradient.Color = ColorSequence.new(color0, color1)
							gradient.Rotation = rotation
							gradients[gradient] = rotation
						elseif gradient then
							gradient:Destroy()
						end
					end

					local function setBackground(inst, color)
						if inst.BackgroundColor3 ~= color then
							inst.BackgroundColor3 = color
						end
					end

					local function styleInstance(inst, role, pal)
						if role == "accent" then
							-- UIGradient also tints text, so text buttons keep a solid accent color
							if cust.gradient == true and not isText(inst) then
								setBackground(inst, Color3.new(1, 1, 1))
								setGradient(inst, true, pal.accent, pal.accent2, num("gradrotation", 0))
							else
								setBackground(inst, pal.accent)
								setGradient(inst, false)
							end
						elseif role == "bg" then
							if cust.bggradient == true and not isText(inst) then
								setBackground(inst, Color3.new(1, 1, 1))
								setGradient(inst, true, pal.bg, pal.bgend, num("bgrotation", 90))
							else
								setBackground(inst, pal.bg)
								setGradient(inst, false)
							end
						else
							setBackground(inst, pal[role])

							if role == "panel" then
								local value = math.clamp(num("paneltransparency", 0), 0, 90) / 100

								if value > 0 then
									inst.BackgroundTransparency = value
									inst:SetAttribute("AtlasPT", true)
								elseif inst:GetAttribute("AtlasPT") then
									inst.BackgroundTransparency = 0
									inst:SetAttribute("AtlasPT", nil)
								end
							end
						end
					end

					local function fontFor(originalName, choice)
						if choice == "Gotham" and string.find(originalName, "Bold") then
							return Enum.Font.GothamBold
						end

						local ok, font = pcall(function()
							return Enum.Font[choice]
						end)

						if ok and font then
							return font
						end

						return nil
					end

					local function styleText(inst)
						local choice = cust.font
						local original = inst:GetAttribute("AtlasFont0")

						if type(choice) ~= "string" or choice == "Default" then
							if original then
								pcall(function()
									inst.Font = Enum.Font[original]
								end)

								inst:SetAttribute("AtlasFont0", nil)
							end

							return
						end

						if not original then
							original = inst.Font.Name
							inst:SetAttribute("AtlasFont0", original)
						end

						local font = fontFor(original, choice)

						if font then
							inst.Font = font
						end
					end

					local function classify(inst, pal)
						if not inst:IsA("GuiObject") or inst:GetAttribute("AtlasIgnore") then
							return
						end

						local role = inst:GetAttribute("AtlasRole")

						if not role then
							role = ROLE_BY_KEY[colorKey(inst.BackgroundColor3)]

							if role then
								inst:SetAttribute("AtlasRole", role)
							end
						end


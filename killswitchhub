					table.insert(payload.badges, {
						name = k,
						tier = setData.LastTier and tierNames[setData.LastTier] or "Junior",
						value = math.floor(setData.CurrentAmount),
						goal = setData.GoalAmount,
					})
				end
			end

			local beequips = { case = {}, storage = {}, inbox = {} }
			local hasBeequips = nil

			for _, category in ipairs({ "Case", "Storage", "Inbox" }) do
				for _, beequipSlot in ipairs(playerCache.Beequips[category]) do
					local beequip = category == "Case" and secureCall(beequipSlot.FetchBeequip, beequipSlot, playerCache) or beequipSlot
					local typeDef = secureCall(beequip.GetTypeDef, beequip)
					hasBeequips = true
					local mods, hiveMods, abilities = secureCall(beequip.GenerateModifiers, beequip)
					local waxes = {}
					local stats = {}
					local potential = math.round(beequip.Q * 5 * 1000) / 1000

					if beequip.W then
						for _, waxEntry in ipairs(beequip.W) do
							table.insert(waxes, { wax_type = secureCall(gameApi.WaxTypes, waxEntry[1]).Name .. " Wax", success = waxEntry[2] })
						end
					end

					for _, mod in pairs(mods) do
						local statDef = secureCall(gameApi.BeeStatMods, mod.Stat)
						local modText = secureCall(statDef.Desc, mod)
						local isPercent = string.find(modText, "%", 1, true) ~= nil
						local value = mod.Value
						local modifier = "+"

						if not (not isPercent or not string.find(modText, "%-%d")) then
							if value < 1 then
								value = 1 - value
							end

							modifier = "-%"
							value *= 100
						elseif not isPercent then
							if statDef.Op == "Mul" then
								modifier = "x"
							end
						else
							if value > 1 then
								value -= 1
							end

							modifier = "+%"
							value *= 100
						end

						table.insert(stats, {

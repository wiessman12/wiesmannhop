		if not sprout and not (not cfg.sprouts.plant or not cfg.sprouts.amount or not (not not (cfg.sprouts.left > 0) and (cfg.autofarm.field1 ~= "Mountain Top Field" or not tracked.mondo) and (cfg.autofarm.field1 ~= "Coconut Field" or mobCooldown(monsterSpawners.CoconutCrab)) and (not cfg.sprouts.plantday and not cfg.sprouts.plantnight or not ((not cfg.sprouts.plantnight or not (Lighting.ClockTime >= 19 or Lighting.ClockTime <= 5)) and (not cfg.sprouts.plantday or not (Lighting.ClockTime < 19) or not (Lighting.ClockTime > 5)))))) then
			local sproutCount = 0

			for k in pairs(tracked.sprouts) do
				sproutCount += 1
			end

			local field = getFieldAt(getRootPart().Position)
			local inFarmField = field and field.Name == cfg.autofarm.field1

			if inventory:Has({ ["Magic Bean"] = 1 }, inFarmField, inFarmField) then
				reportStatus(1, cfg.autofarm.field1)
				logger.log("Planting sprout in", cfg.autofarm.field1)
				setField(cfg.autofarm.field1)
				goToField()

				if inventory:Use("Magic Bean") then
					local sprouts = cfg.sprouts
					sprouts.left = sprouts.left - 1
					controls["Sprouts Left"].Text = "Amount Left: " .. cfg.sprouts.left
					inventory.time["Magic Bean"] = os.clock() - 24
					saveConfig()

					local function countSprouts()
						local sproutTotal = 0

						for k in pairs(tracked.sprouts) do
							sproutTotal += 1
						end

						return sproutTotal
					end

					local now = os.clock()

					while countSprouts() <= sproutCount and os.clock() - now < 2 do
						RunService.Heartbeat:Wait()
					end

					if sproutCount < countSprouts() then
						farmSprouts()
					end
				end
			end
		elseif sprout then
			local stats = discord.stats
			stats["Total Sprouts"] = stats["Total Sprouts"] + 1
			logger.log("Sprout: Found in", sproutField.Name, "(" .. sproutType .. ")")
			setField(sproutField.Name)
			local now = os.clock()

			while not (not sprout.Parent or not (os.clock() - now < 300)) do
				if not RunService.Heartbeat:Wait() then
					break
				end

				if not cfg.convert.convertHoney and not cfg.convert.convertHiveBalloon or not shouldConvert(true) then
					local newSprout, newSproutType = findSprout()

					if not (not newSprout or not (newSprout ~= sprout and not ((newSproutType ~= "Rare" or sproutType ~= "Basic") and (newSproutType ~= "Moon" or not (sproutType == "Basic" or sproutType == "Rare")) and (newSproutType ~= "Epic" or not (sproutType == "Basic" or sproutType == "Rare" or sproutType == "Moon"))))) then
						error("return", 0)
					end

					reportStatus(1, sproutField.Name)
					goToField()

					if sproutField.Name ~= "Mountain Top Field" or not tracked.mondo then
						if cfg.combat.avoidmobs then
							getAggroMobs()
						end

						if not (not cfg.autofarm.autosprinkler or farmState.field == sproutField.Name) then
							farmState:Handle()
						end

						farmStep({})
					else
						local avoidList = { [tracked.mondo.HumanoidRootPart.Position] = 40 }

						for k, avoidRadius in pairs(tracked.avoid) do
							avoidList[k] = avoidRadius
						end

						farmStep({ avoid = avoidList, skipoverlap = true })
					end
				elseif shouldConvert() then
					convertHoney()
				end
			end

			if os.clock() - now >= 300 then
				tracked.sprouts[sprout] = nil
				error("return", 0)
			end

			if not cfg.sprouts.plant or cfg.autofarm.field1 ~= sproutField.Name or not cfg.sprouts.amount or not (not not (cfg.sprouts.left > 0) and (sproutField.Name ~= "Mountain Top Field" or not tracked.mondo) and (sproutField.Name ~= "Coconut Field" or mobCooldown(monsterSpawners.CoconutCrab)) and (not cfg.sprouts.plantday and not cfg.sprouts.plantnight or not ((not cfg.sprouts.plantnight or not (Lighting.ClockTime >= 19 or Lighting.ClockTime <= 5)) and (not cfg.sprouts.plantday or not (Lighting.ClockTime < 19) or not (Lighting.ClockTime > 5))))) then
				local now2 = os.clock()

				while os.clock() - now2 < 20 do
					if not RunService.Heartbeat:Wait() then
						break
					end
					goToField()
					farmStep({ loot = true })
				end
			else
				local now2 = os.clock()

				while os.clock() - now2 < 20 do
					if not RunService.Heartbeat:Wait() then
						break
					end
					goToField()

					if cfg.sprouts.collect then
						farmStep({ loot = true })
					end

					if not (not cfg.sprouts.plant or not (not not (cfg.sprouts.left > 0) and (sproutField.Name ~= "Mountain Top Field" or not tracked.mondo) and (sproutField.Name ~= "Coconut Field" or mobCooldown(monsterSpawners.CoconutCrab)) and (not cfg.sprouts.plantday and not cfg.sprouts.plantnight or not ((not cfg.sprouts.plantnight or not (Lighting.ClockTime >= 19 or Lighting.ClockTime <= 5)) and (not cfg.sprouts.plantday or not (Lighting.ClockTime < 19) or not (Lighting.ClockTime > 5)))))) then
						local sproutInField = nil

						for k in pairs(tracked.sprouts) do
							if getFieldAt(k.Position) == sproutField then
								sproutInField = true
							end
						end

						if not sproutInField and inventory:Use("Magic Bean") then
							local sprouts = cfg.sprouts
							sprouts.left = sprouts.left - 1
							controls["Sprouts Left"].Text = "Amount Left: " .. cfg.sprouts.left
							inventory.time["Magic Bean"] = os.clock() - 24
							saveConfig()
							local stats2 = discord.stats
							stats2["Total Sprouts"] = stats2["Total Sprouts"] + 1
							logger.log("Planting sprout in", sproutField.Name)
							now2 = os.clock()
						end
					end
				end
			end
		end
	end


					local THEME_FLAG = { gradient = true, bggradient = true, gradanimated = true, outline = true, rainbow = true }

					local function exportTheme()
						local out = {}

						for key in pairs(THEME_NUM) do
							out[key] = num(key, 0)
						end

						for key in pairs(THEME_FLAG) do
							out[key] = cust[key] == true
						end

						out.font = type(cust.font) == "string" and cust.font or "Default"
						local ok = false

						if setclipboard then
							ok = pcall(setclipboard, HttpService:JSONEncode(out))
						end

						ui.Notify("Customization", ok and "Theme copied to clipboard" or "Clipboard is not supported")
					end

					local function importTheme(text)
						if type(text) ~= "string" or text == "" then
							return
						end

						local ok, data = pcall(HttpService.JSONDecode, HttpService, text)

						if not ok or type(data) ~= "table" then
							ui.Notify("Customization", "Invalid theme data")
							return
						end

						local count = 0

						for key, value in pairs(data) do
							local range = THEME_NUM[key]

							if range and type(value) == "number" then
								local clamped = math.clamp(value, range[1], range[2])

								if sliders[key] then
									setSlider(key, clamped)
								else
									cust[key] = math.floor(clamped + 0.5)
								end

								count += 1
							elseif THEME_FLAG[key] and type(value) == "boolean" then
								setSwitch(key, value)
								count += 1
							elseif key == "font" and type(value) == "string" and table.find(FONTS, value) then
								setFont(value)
								count += 1
							end
						end

						for _, picker in pairs(pickers) do
							picker.Redraw()
						end

						saveConfig()
						requestApply()
						ui.Notify("Customization", count > 0 and "Theme imported" or "Nothing to import")
					end


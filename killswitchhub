-- Reload: re-runs a LOCAL copy of this script (nothing is downloaded). Save the file as
-- workspace/BuffTools/BuffTools_clean.lua, or set getgenv().BuffToolsPath = "<path inside workspace>" before running.
-- Without a saved copy the button does nothing, so you never lose a running HUD by accident.
Session.reload = function()
  -- embedded in Atlas: reload from the built-in copy instead of a file
  local embedded = Session.env and Session.env.BuffToolsLoader
  if type(embedded) == "function" then
    Session.unload()
    task.defer(embedded)
    return
  end
  local path = (Session.env and Session.env.BuffToolsPath) or "BuffTools/BuffTools_clean.lua"
  local code
  pcall(function()
    if type(isfile) == "function" and type(readfile) == "function" and isfile(path) then
      code = readfile(path)
    end
  end)
  if type(code) ~= "string" or #code < 50 then
    print("[BuffTools] reload: no local copy at " .. tostring(path) .. " - script left running")
    return
  end
  Session.unload()
  task.defer(function()
    local fn
    pcall(function() fn = loadstring(code) end)
    if not fn then
      pcall(function()
        if type(load) == "function" then fn = load(code) end
      end)
    end
    if fn then task.spawn(fn) end
  end)
end

-- Change one option the same way its switch in the BuffTools menu does (used by the Atlas BuffTools tab).
ExtraUI.setOption = function(key, value)
  if not Session.alive then return false end
  local vis = ExtraUI.vis
  if key == "speedVal" then
    return Speed.setTarget(value)
  end
  if type(key) ~= "string" or vis[key] == nil then return false end
  if key == "rbcLang" then
    RBC.setLang(value)
    savePositions()
    return true
  end
  value = value == true
  if key == "speed" then
    Speed.set(value)
    if ExtraUI.paintSpeed then pcall(ExtraUI.paintSpeed, Speed.on) end
  elseif key == "antiGlider" then
    AntiGlider.set(value)
  elseif key == "night" then
    ExtraUI.Night.set(value)
  elseif key == "stickDrink" then
    StickBug.setDrink(value)
  elseif key == "stickTp" then
    StickBug.setTp(value)
  elseif key == "rbcTips" then
    RBC.setTips(value)
  elseif key == "antiTex" or key == "antiBee" or key == "antiBalls" or key == "antiPlayers" then
    vis[key] = value
    ExtraUI.AntiLag.set(key, value)
  elseif key == "tokenTimers" or key == "beams" then
    vis[key] = value
    ExtraUI.applyVisuals()
  elseif key == "fps" then
    vis.fps = value
    if type(ExtraUI.applyFps) == "function" then ExtraUI.applyFps() end
  elseif key == "bssHide" then
    vis.bssHide = value
    ExtraUI.bssApply()
  else
    vis[key] = value
    ExtraUI.apply()
  end
  local paint = ExtraUI.rowPaint[key]
  if paint then pcall(paint, true) end
  savePositions()
  return true
end


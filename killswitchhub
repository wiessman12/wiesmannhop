-- Sticker Stack: look the object up by name (Toys / NPCs first, then the shallow and deep workspace walk)
function ExtraUI.Bless.isStack(inst)
  local flat = inst.Name:lower():gsub("[%s%p_]", "")
  return flat:find("stickerstack", 1, true) ~= nil
end

function ExtraUI.Bless.findStack()
  local B = ExtraUI.Bless
  if B.stack and B.stack.Parent then return B.stack end
  B.stack = nil
  local function scan(root)
    if not root then return nil end
    for _, d in ipairs(root:GetDescendants()) do
      if (d:IsA("Model") or d:IsA("BasePart")) and B.isStack(d) then return d end
    end
    return nil
  end
  for _, nm in ipairs({ "Toys", "NPCs", "Stands", "Map", "Decorations" }) do
    local hit = scan(Workspace:FindFirstChild(nm))
    if hit then B.stack = hit return hit end
  end
  for _, ch in ipairs(Workspace:GetChildren()) do
    if (ch:IsA("Model") or ch:IsA("BasePart")) and B.isStack(ch) then B.stack = ch return ch end
  end
  local n = 0
  for _, d in ipairs(Workspace:GetDescendants()) do
    n = n + 1
    if n % 3000 == 0 then task.wait() end
    if (d:IsA("Model") or d:IsA("BasePart")) and B.isStack(d) then B.stack = d return d end
  end
  return nil
end

function ExtraUI.Bless.tpStack()
  local B = ExtraUI.Bless
  local inst = B.findStack()
  local pos = inst and B.posOf(inst)
  if not pos then return false, "Sticker Stack not found (walk closer so it streams in)" end
  if B.tp(pos + Vector3.new(0, 6, 0)) then return true end
  return false, "no character"
end

-- Hive balloon: nearest balloon to our hive spawn
function ExtraUI.Bless.findBalloon()
  local B = ExtraUI.Bless
  local now = os.clock()
  if B.balloon and B.balloon.Parent and now - (B.balloonAt or 0) < 5 then return B.balloon end
  B.balloonAt = now
  B.balloon = nil
  local folder = Workspace:FindFirstChild("Balloons")
  local hcf = B.hiveCF()
  if not folder or not hcf then return nil end
  local host = folder:FindFirstChild("HiveBalloons") or folder
  local best, bd = nil, 160
  for _, ch in ipairs(host:GetChildren()) do
    if ch:IsA("Model") or ch:IsA("BasePart") then
      local pos = B.posOf(ch)
      if pos then
        local d = (pos - hcf.Position).Magnitude
        if d < bd then best, bd = ch, d end
      end
    end
  end
  B.balloon = best
  return best
end

function ExtraUI.Bless.balloonInfo()
  local B = ExtraUI.Bless
  local bal = B.findBalloon()
  if not bal then return nil end
  local hits, texts = {}, {}
  for k, v in pairs(bal:GetAttributes()) do
    if tostring(k):lower():find("bless", 1, true) then hits[#hits + 1] = tostring(k) .. " " .. tostring(v) end
  end
  for _, d in ipairs(bal:GetDescendants()) do
    if d:IsA("ValueBase") and d.Name:lower():find("bless", 1, true) then
      hits[#hits + 1] = d.Name .. " " .. tostring(d.Value)
    elseif d:IsA("TextLabel") and d.Text ~= "" then
      local t = d.Text:gsub("<[^>]+>", "")
      if t:lower():find("bless", 1, true) then
        hits[#hits + 1] = t
      elseif #texts < 3 then
        texts[#texts + 1] = t
      end
    end
  end
  if #hits > 0 then return table.concat(hits, " · ") end
  if #texts > 0 then return table.concat(texts, " | ") end
  return "balloon found, no blessing text"
end

function ExtraUI.Bless.readout()
  local B = ExtraUI.Bless
  local lines = {}
  local name, combo, left = ExtraUI.buffMatch("blessing")
  if name then
    local t = name .. " x" .. tostring(math.max(1, combo))
    if type(left) == "number" then t = t .. " · " .. ExtraUI.fmtCd(left) end
    lines[#lines + 1] = "Buff: " .. t
  else
    lines[#lines + 1] = "Buff: no Blessing now"
  end
  local info = B.balloonInfo()
  lines[#lines + 1] = "Hive balloon: " .. (info or "not found near your hive")
  return table.concat(lines, "\n")
end


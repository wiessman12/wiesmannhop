					local function applyOutline(pal)
						local stroke = mobileToggleButton:FindFirstChild("AtlasOutline")

						if cust.outline ~= true then
							if stroke then
								stroke:Destroy()
							end

							return
						end

						if not stroke then
							stroke = Instance.new("UIStroke")
							stroke.Name = "AtlasOutline"
							stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
							stroke.Parent = mobileToggleButton
						end

						stroke.Thickness = math.clamp(num("outlinethickness", 2), 1, 6)
						local gradient = stroke:FindFirstChild("AtlasGradient")

						if cust.gradient == true then
							stroke.Color = Color3.new(1, 1, 1)

							if not gradient then
								gradient = Instance.new("UIGradient")
								gradient.Name = "AtlasGradient"
								gradient.Parent = stroke
							end

							gradient.Color = ColorSequence.new({
								ColorSequenceKeypoint.new(0, pal.accent),
								ColorSequenceKeypoint.new(0.5, pal.accent2),
								ColorSequenceKeypoint.new(1, pal.accent),
							})

							local rotation = num("gradrotation", 0)
							gradient.Rotation = rotation
							gradients[gradient] = rotation
						else
							stroke.Color = pal.accent

							if gradient then
								gradient:Destroy()
							end
						end
					end

					local acc = 0

					local function step(dt)
						acc += dt

						if cust.rainbow == true and acc >= 0.07 then
							acc = 0
							local pal = palette()

							for inst in pairs(registry.accent) do
								styleInstance(inst, "accent", pal)
							end

							applyOutline(pal)
						end

						if cust.gradanimated == true then
							local rotation = (os.clock() * 40) % 360

							for gradient, base in pairs(gradients) do
								if gradient.Parent then
									gradient.Rotation = base + rotation
								end
							end
						end
					end

					local function updateLoop()
						local needed = cust.rainbow == true or (cust.gradanimated == true and (cust.gradient == true or cust.bggradient == true or cust.outline == true))
						local running = connections:Get("customthemeloop")

						if needed and not running then
							connections:Add("customthemeloop", RunService.Heartbeat:Connect(function(dt)
								pcall(step, dt)
							end))
						elseif not needed and running then
							connections:Cancel("customthemeloop")
						end
					end

					local function applyTheme()
						local pal = palette()

						for role, set in pairs(registry) do
							for inst in pairs(set) do
								styleInstance(inst, role, pal)
							end
						end

						for inst in pairs(texts) do
							styleText(inst)
						end

						applyWindow()
						applyOutline(pal)
						updateLoop()
					end

					local applyQueued = false

					local function requestApply()
						if applyQueued then
							return
						end

						applyQueued = true

						task.defer(function()
							applyQueued = false
							local ok, err = pcall(applyTheme)

							if not ok then
								warn("Customization: " .. tostring(err))
							end
						end)
					end

					----------------------------------------------------------------
					-- sky: generated PNG skybox (fallback: Atmosphere)
					----------------------------------------------------------------
					local crcTable = nil

					local function crc32(str)
						if not crcTable then
							crcTable = {}

							for i = 0, 255 do
								local c = i

								for _ = 1, 8 do
									if bit32.band(c, 1) == 1 then
										c = bit32.bxor(0xEDB88320, bit32.rshift(c, 1))
									else
										c = bit32.rshift(c, 1)
									end
								end

								crcTable[i] = c
							end
						end

						local crc = 0xFFFFFFFF

						for i = 1, #str do
							crc = bit32.bxor(crcTable[bit32.band(bit32.bxor(crc, string.byte(str, i)), 0xFF)], bit32.rshift(crc, 8))
						end

						return bit32.bxor(crc, 0xFFFFFFFF)
					end

					local function adler32(str)
						local a, b = 1, 0

						for i = 1, #str do
							a = (a + string.byte(str, i)) % 65521
							b = (b + a) % 65521
						end

						return b * 65536 + a
					end

					local function pngChunk(chunkType, data)
						return string.pack(">I4", #data) .. chunkType .. data .. string.pack(">I4", crc32(chunkType .. data))
					end

					local function makePng(width, height, rowColor)
						local rows = table.create(height)

						for y = 1, height do
							local r, g, b = rowColor(y, height)
							rows[y] = "\0" .. string.rep(string.char(r, g, b), width)
						end

						local raw = table.concat(rows)
						local blocks = { "\120\1" }
						local position = 1
						local total = #raw

						repeat
							local length = math.min(65535, total - position + 1)
							local final = (position + length > total) and 1 or 0
							blocks[#blocks + 1] = string.char(final) .. string.pack("<I2", length) .. string.pack("<I2", 65535 - length) .. string.sub(raw, position, position + length - 1)
							position += length
						until position > total

						blocks[#blocks + 1] = string.pack(">I4", adler32(raw))

						return "\137PNG\r\n\26\n"
							.. pngChunk("IHDR", string.pack(">I4I4BBBBB", width, height, 8, 2, 0, 0, 0))
							.. pngChunk("IDAT", table.concat(blocks))
							.. pngChunk("IEND", "")
					end

					local function mix(a, b, t)
						return math.floor(a + (b - a) * t + 0.5)
					end

					local function buildSkyAssets(top, horizon)
						local assetFn = getcustomasset or getsynasset

						if type(assetFn) ~= "function" or type(writefile) ~= "function" then
							return nil
						end

						local base = "atlas/sky_" .. hexOf(top) .. "_" .. hexOf(horizon)
						local files = { top = base .. "_top.png", bottom = base .. "_bottom.png", side = base .. "_side.png" }
						local t = { top.R * 255, top.G * 255, top.B * 255 }
						local h = { horizon.R * 255, horizon.G * 255, horizon.B * 255 }

						if not isfile(files.top) then
							writefile(files.top, makePng(4, 4, function()
								return byte(t[1]), byte(t[2]), byte(t[3])
							end))
						end

						if not isfile(files.bottom) then
							writefile(files.bottom, makePng(4, 4, function()
								return byte(h[1]), byte(h[2]), byte(h[3])
							end))
						end

						if not isfile(files.side) then
							writefile(files.side, makePng(8, 256, function(y, height)
								local s = math.clamp(((y - 1) / (height - 1)) * 2, 0, 1)
								s = s * s * (3 - 2 * s)
								return mix(t[1], h[1], s), mix(t[2], h[2], s), mix(t[3], h[3], s)
							end))
						end

						return { top = assetFn(files.top), bottom = assetFn(files.bottom), side = assetFn(files.side) }
					end

					local SKY_FACES = {
						SkyboxUp = "top",
						SkyboxDn = "bottom",
						SkyboxBk = "side",
						SkyboxFt = "side",
						SkyboxLf = "side",
						SkyboxRt = "side",
					}

					local skyOrig = nil
					local createdAtm = nil
					local createdSky = nil
					local boxKey = nil
					local boxAssets = nil
					local boxFailed = false
					local fallbackNotified = false
					local applied = { tint = false, fog = false, bodies = false, time = false, haze = false }

					local function captureSky()
						if skyOrig then
							return
						end

						local sky = Lighting:FindFirstChildOfClass("Sky")
						local atm = Lighting:FindFirstChildOfClass("Atmosphere")

						skyOrig = {
							Ambient = Lighting.Ambient,
							OutdoorAmbient = Lighting.OutdoorAmbient,
							ClockTime = Lighting.ClockTime,
							FogColor = Lighting.FogColor,
							FogStart = Lighting.FogStart,
							FogEnd = Lighting.FogEnd,
						}

						if sky then
							skyOrig.sky = {
								StarCount = sky.StarCount,
								CelestialBodiesShown = sky.CelestialBodiesShown,
								SkyboxBk = sky.SkyboxBk,
								SkyboxDn = sky.SkyboxDn,
								SkyboxFt = sky.SkyboxFt,
								SkyboxLf = sky.SkyboxLf,
								SkyboxRt = sky.SkyboxRt,
								SkyboxUp = sky.SkyboxUp,
							}
						end

						if atm then
							skyOrig.atm = {
								Color = atm.Color,
								Decay = atm.Decay,
								Density = atm.Density,
								Offset = atm.Offset,
								Glare = atm.Glare,
								Haze = atm.Haze,
							}
						end
					end

					local function restoreSky()
						connections:Cancel("customsky")

						if not skyOrig then
							return
						end

						local original = skyOrig
						skyOrig = nil
						boxKey = nil

						pcall(function()
							Lighting.Ambient = original.Ambient
							Lighting.OutdoorAmbient = original.OutdoorAmbient

							if not connections:Get("antilag") then
								Lighting.FogColor = original.FogColor
								Lighting.FogStart = original.FogStart
								Lighting.FogEnd = original.FogEnd
							end

							if applied.time then
								Lighting.ClockTime = original.ClockTime
							end

							if createdAtm then
								createdAtm:Destroy()
							else
								local atm = Lighting:FindFirstChildOfClass("Atmosphere")

								if atm and original.atm then
									for property, value in pairs(original.atm) do
										atm[property] = value
									end
								end
							end

							if createdSky then
								createdSky:Destroy()
							else
								local sky = Lighting:FindFirstChildOfClass("Sky")

								if sky and original.sky then
									for property, value in pairs(original.sky) do
										sky[property] = value
									end
								end
							end
						end)

						createdAtm = nil
						createdSky = nil
						applied.tint = false
						applied.fog = false
						applied.bodies = false
						applied.time = false
						applied.haze = false
					end

					local function skyStep()
						if not skyOrig then
							return
						end

						local top = rgbOf("sky", 90, 170, 255)
						local horizon = cust.skygradient == true and rgbOf("sky2", 40, 100, 220) or top
						local assetFn = getcustomasset or getsynasset
						local canBox = type(assetFn) == "function" and type(writefile) == "function" and not boxFailed
						local atm = Lighting:FindFirstChildOfClass("Atmosphere")
						local sky = Lighting:FindFirstChildOfClass("Sky")

						if canBox then
							if not sky then
								sky = Instance.new("Sky")
								sky.Name = "AtlasSky"
								sky.Parent = Lighting
								createdSky = sky
							end

							local key = hexOf(top) .. hexOf(horizon)

							if key ~= boxKey then
								boxKey = key
								local ok, assets = pcall(buildSkyAssets, top, horizon)

								if ok and assets then
									boxAssets = assets
								else
									boxAssets = nil
									boxFailed = true
									warn("Customization: skybox generation failed: " .. tostring(assets))
								end
							end

							if boxAssets then
								for property, face in pairs(SKY_FACES) do
									setIf(sky, property, boxAssets[face])
								end
							end

							-- the game's own atmosphere haze would wash the sky out
							if atm and atm ~= createdAtm then
								if cust.skyclearhaze ~= false then
									setIf(atm, "Density", 0)
									setIf(atm, "Haze", 0)
									setIf(atm, "Glare", 0)
									applied.haze = true
								elseif applied.haze and skyOrig.atm then
									atm.Density = skyOrig.atm.Density
									atm.Haze = skyOrig.atm.Haze
									atm.Glare = skyOrig.atm.Glare
									applied.haze = false
								end
							end
						else
							if not fallbackNotified then
								fallbackNotified = true
								ui.Notify("Custom Sky", "Your executor can't load custom images, using a basic atmosphere tint instead")
							end

							if not atm then
								atm = Instance.new("Atmosphere")
								atm.Name = "AtlasAtmosphere"
								atm.Parent = Lighting
								createdAtm = atm
							end

							setIf(atm, "Color", horizon)
							setIf(atm, "Decay", top)
							setIf(atm, "Density", 0.8)
							setIf(atm, "Offset", 1)
							setIf(atm, "Glare", 0)
							setIf(atm, "Haze", 0)
						end

						-- sun / moon / stars
						if sky then
							if cust.skyhidebodies == true then
								setIf(sky, "StarCount", 0)
								setIf(sky, "CelestialBodiesShown", false)
								applied.bodies = true
							elseif applied.bodies and skyOrig.sky then
								sky.StarCount = skyOrig.sky.StarCount
								sky.CelestialBodiesShown = skyOrig.sky.CelestialBodiesShown
								applied.bodies = false
							end
						end

						-- ambient tint
						if cust.skytint == true then
							setIf(Lighting, "OutdoorAmbient", skyOrig.OutdoorAmbient:Lerp(top, 0.5))
							setIf(Lighting, "Ambient", skyOrig.Ambient:Lerp(top, 0.35))
							applied.tint = true
						elseif applied.tint then
							Lighting.OutdoorAmbient = skyOrig.OutdoorAmbient
							Lighting.Ambient = skyOrig.Ambient
							applied.tint = false
						end

						-- fog (skipped while Anti Lag is controlling the fog)
						if cust.skyfog == true and not connections:Get("antilag") then
							setIf(Lighting, "FogColor", horizon)
							setIf(Lighting, "FogStart", 0)
							setIf(Lighting, "FogEnd", math.clamp(num("skyfogend", 1500), 100, 10000))
							applied.fog = true
						elseif applied.fog then
							if not connections:Get("antilag") then
								Lighting.FogColor = skyOrig.FogColor
								Lighting.FogStart = skyOrig.FogStart
								Lighting.FogEnd = skyOrig.FogEnd
							end

							applied.fog = false
						end

						-- time of day
						if cust.skylocktime == true then
							setIf(Lighting, "ClockTime", math.clamp(num("skytime", 12), 0, 24))
							applied.time = true
						end
					end

					local function setSky(enabled)
						if enabled then
							captureSky()

							if not connections:Get("customsky") then
								connections:Add("customsky", RunService.Heartbeat:Connect(function()
									pcall(skyStep)
								end))
							end
						else
							restoreSky()
						end
					end

					ScreenGui.Destroying:Connect(restoreSky)


						amount += 1
					end
				else
					amount += 2
				end

				if entryB.field == "Strawberry Field" or entryB.field == "Coconut Field" or entryB.field == "Pine Tree Forest" then
					amount2 += 3
				elseif entryB.field ~= "Pepper Patch" then
					if entryB.field == "Rose Field" then
						amount2 += 1
					end
				else
					amount2 += 2
				end
			end

			return amount > amount2
		end)

		local topField = boostedList[1]
		local wanted = cfg.boosters.wanted

		if topField then

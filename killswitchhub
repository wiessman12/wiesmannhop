							-- dragging
							local mode = nil
							local dragging = false
							local scroller = nil

							local function pick(position)
								if mode == "sv" then
									local origin, size = field.AbsolutePosition, field.AbsoluteSize
									state.s = math.clamp((position.X - origin.X) / size.X, 0, 1)
									state.v = 1 - math.clamp((position.Y - origin.Y) / size.Y, 0, 1)
								elseif mode == "hue" then
									local origin, size = bar.AbsolutePosition, bar.AbsoluteSize
									state.h = math.clamp((position.X - origin.X) / size.X, 0, 0.9999)
								end

								fromState()
							end

							local function begin(which)
								return function(inputObject)
									if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 and inputObject.UserInputType ~= Enum.UserInputType.Touch then
										return
									end

									mode = which
									dragging = true
									isDragging = true
									scroller = popup:FindFirstAncestorOfClass("ScrollingFrame")

									if scroller then
										scroller.ScrollingEnabled = false
									end

									pick(inputObject.Position)
								end
							end

							fieldHit.InputBegan:Connect(begin("sv"))
							barHit.InputBegan:Connect(begin("hue"))

							connections:Add("colorpickmove_" .. prefix, UserInputService.InputChanged:Connect(function(inputObject)
								if dragging and (inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch) then
									pick(inputObject.Position)
								end
							end))

							connections:Add("colorpickend_" .. prefix, UserInputService.InputEnded:Connect(function(inputObject)
								if dragging and (inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch) then
									dragging = false
									isDragging = false
									mode = nil

									if scroller then
										scroller.ScrollingEnabled = true
									end

									pushRecent(num(prefix .. "r", defaults[1]), num(prefix .. "g", defaults[2]), num(prefix .. "b", defaults[3]))
									saveConfig()
								end
							end))

							refreshPanel()
						end

						input.FocusLost:Connect(function()

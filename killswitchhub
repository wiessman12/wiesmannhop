gameApi.SetupSecureCall = function()
	if not secureCall then
		secureCall = newcclosure(function(n, ...)
			local Z, p
			local q
			threadCount += 1

			threads.list[threadCount] = task.spawn(function(...)
				setthreadidentity(5)

				Z, p = pcall(function(...)
					return table.pack(n(...))
				end, ...)

				q = true
			end, ...)

			while not q do
				task.wait()
			end

			if not Z then
				error(p)
			end

			return table.unpack(p)
		end)
	end
end


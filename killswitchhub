					if not preciseMark.Parent or os.clock() - now > 4 then
						touchedMarks[preciseMark] = true

						task.delay(3, function()
							touchedMarks[preciseMark] = nil
						end)

						return true
					end
				end
			end

			touchedMarks[preciseMark] = true

			task.delay(3, function()
				touchedMarks[preciseMark] = nil
			end)

			return true
		end


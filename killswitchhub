			return false
		end
	end

	local ipairs_ = ipairs
	local costList = not costs[1] and { costs } or costs

	for _, cost in ipairs_(costList) do
		if not (cost.Category ~= "Honey" or not (localPlayer.CoreStats.Honey.Value < cost.Amount)) then

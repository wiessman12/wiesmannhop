			folderApi.AddSlider = function(sliderTitle, callback, minValue, maxValue, configSource, configKey, options)
				table.insert(fieldClones, { sliderTitle, clone })
				local sliderApi = {}
				local clone5 = uiParts.slider:Clone()
				clone5.Parent = box
				local button = clone5.Button
				local indicator = clone5.Indicator
				local value = clone5.Value
				local left = options and options.Left
				local decimal = options and options.Decimal
				local lastValue = nil
				local configTable = configSource and type(configSource) == "string" and cfg[configSource] or configSource
				local title2 = clone5.Title
				title2.Text = left and "   " .. sliderTitle or sliderTitle

				if left then
					title2.TextXAlignment = Enum.TextXAlignment.Left
					title2.Position = UDim2.new(0, 0, 0.5, -10)
				end

				local function v90(v91)
					local v92 = math.clamp(v91.Position.X - clone5.AbsolutePosition.X, 0, clone5.AbsoluteSize.X)
					local v93 = minValue + v92 / clone5.AbsoluteSize.X * (maxValue - minValue)
					TweenService:Create(indicator, TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.In), { Size = UDim2.new(0, v92, 0, 20) }):Play()
					local text = decimal and math.round(v93 * 10) / 10 or math.floor(v93)
					value.Text = text
					configTable[configKey] = text
					saveConfig()
					local v94 = lastValue
					lastValue = text

					if not (not v94 or not callback or v94 == lastValue) then
						callback(lastValue)
					end
				end

				button.MouseButton1Down:Connect(function(n)
					if not dragState then
						dragState = {}
					end

					dragState[v90] = "slider"
				end)

				sliderApi.Set = function(newValue)
					local maxWidth = isDesktop and twoColumn and ImageLabel.AbsoluteSize.X * 0.5 - 47 - 5 - 10 - 15
					maxWidth = maxWidth or ImageLabel.AbsoluteSize.X - 95 - 5 - 10 - 15
					local clampedValue = math.clamp(tonumber(newValue) or 0, minValue, maxValue)
					TweenService:Create(indicator, TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.In), { Size = UDim2.new(0, (clampedValue - minValue) / (maxValue - minValue) * maxWidth, 0, 20) }):Play()
					local text = decimal and math.round(clampedValue * 10) / 10 or math.floor(clampedValue)
					value.Text = text
					configTable[configKey] = text
					saveConfig()
					local previousValue = lastValue
					lastValue = text

					if not (not previousValue or not callback or previousValue == lastValue) then
						callback(lastValue)
					end
				end

				sliderApi.SetVisible = function(visible2)
					clone5.Visible = visible2
				end

				sliderApi.SetTitle = function(newTitle)
					title2.Text = "   " .. newTitle
				end

				if configSource then
					local storedValue = configTable[configKey]

					if storedValue then
						sliderApi.Set(storedValue)
					end
				end

				return sliderApi
			end


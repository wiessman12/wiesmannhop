ExtraUI.bssApply = function()
  local on = ExtraUI.vis.bssHide == true
  for _, g in ipairs(ExtraUI.bssGuis()) do
    pcall(function() g.Enabled = not on end)
  end
end

ExtraUI.bssTargets = function()
  local pg = player:FindFirstChildOfClass("PlayerGui")
  if not pg then return {} end
  local out = {}
  local sg = pg:FindFirstChild("ScreenGui")
  if sg then
    for _, nm in ipairs({ "PlayerActivesGui", "TileGrid", "Menus", "BackpackGui", "Bonuses", "Alerts" }) do
      local f = sg:FindFirstChild(nm)
      if f and f:IsA("GuiObject") then out[#out + 1] = f end
    end
  end
  local chat = pg:FindFirstChild("GlobalChatGui")
  if chat then
    local mc = chat:FindFirstChild("MessageContainer")
    if mc and mc:IsA("GuiObject") then out[#out + 1] = mc end
  end

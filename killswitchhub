  root.BackgroundTransparency = 0.22
  root.BorderSizePixel = 0
  root.ClipsDescendants = true
  root.ZIndex = 6
  root.Parent = gui
  corner(root, 6)
  outline(root, Color3.fromRGB(200, 36, 52), 0.45)
  P.root = root

  local head = Instance.new("Frame")
  head.Size = UDim2.new(1, 0, 0, HH)
  head.BackgroundTransparency = 1
  head.BorderSizePixel = 0
  head.ZIndex = 7
  head.Parent = root

  local sic = Instance.new("ImageLabel")
  sic.BackgroundTransparency = 1
  sic.Size = UDim2.fromOffset(HH - 8, HH - 8)
  sic.Position = UDim2.fromOffset(6, 4)
  sic.ScaleType = Enum.ScaleType.Fit
  sic.Image = btAsset(PACK.scorch, nil)
  sic.ZIndex = 8
  sic.Parent = head
  btFallbackBadge(sic, "SS", 11, false)

  local lab = Instance.new("TextLabel")
  lab.Size = UDim2.new(1, -(HH + 18), 1, 0)
  lab.Position = UDim2.fromOffset(HH + 0, 0)
  lab.BackgroundTransparency = 1
  lab.Text = "SCORCH STAR LOGS"
  lab.TextColor3 = FieldFx.Notif.HONEY
  lab.Font = Enum.Font.GothamBold

		useBlender = function(recipe, count, speedUp, logPrefix, checkOnly)
			local playerCache = gameApi:Cache()
			local blenderState = playerCache.BlenderState

			if blenderState then
				local recipeInfo = secureCall(gameApi.Blender, blenderState.Recipe)
				local floor = math.floor
				local clamp = math.clamp
				local baseElapsed = playerCache.PlaytimeAtLoad + (playerCache.OfflineProgressTime or 0)
				local loadTime = playerCache.LoadTime
				local startTime = blenderState.StartTime

				if not (blenderState.Count <= floor(clamp((baseElapsed + (workspace:GetServerTimeNow() - loadTime) - startTime) / (blenderState.Count * recipeInfo.Time), 0, 1) * blenderState.Count)) then
					local totalTime = blenderState.Count * recipeInfo.Time
					local baseElapsed2 = playerCache.PlaytimeAtLoad + (playerCache.OfflineProgressTime or 0)
					local loadTime2 = playerCache.LoadTime
					local startTime2 = blenderState.StartTime
					local remainingTime = totalTime - (baseElapsed2 + (workspace:GetServerTimeNow() - loadTime2) - startTime2)
					setTimer("Blender", os.time() + remainingTime)
					return
				end

				logger.log("Claiming x" .. blenderState.Count, blenderState.Recipe, "from Blender")
				goTo(workspace.Toys.Blender.Platform.Position, "Blender")
				gameApi:Event("BlenderCommand", "StopOrder")
				gameApi:CacheSet("BlenderState", nil)
				task.wait(1)
				error("return", 0)
			end

			if checkOnly then
				return
			end
			local recipeInfo = secureCall(gameApi.Blender, recipe)
			local requiredIngredients = {}
			local missingIngredients = {}

			for _, ingredient in ipairs(recipeInfo.Ingredients) do
				table.insert(requiredIngredients, { Category = ingredient.Category, Type = ingredient.Type, Amount = ingredient.Amount * count })
			end

			for _, requiredIngredient in ipairs(requiredIngredients) do
				if not secureCall(gameApi.ItemPackages.PlayerHas, requiredIngredient, playerCache) then
					table.insert(missingIngredients, requiredIngredient)
				end
			end

			local v147, v148, v149

			for _, missingIngredient in v147, v148, v149 do
				if cfg.toys.progblender then
					logger.log(logPrefix, "Crafting x" .. count, recipe)
					logger.log(logPrefix, "Missing x" .. missingIngredient.Amount, missingIngredient.Type)
				end

				if locations.blender[missingIngredient.Type] then
					useBlender(missingIngredient.Type, missingIngredient.Amount, speedUp, logPrefix)
				end

				setTimer("Blender", os.time() + 15)
				return
			end

			logger.log(logPrefix, "Crafting x" .. count, recipe)
			goTo(workspace.Toys.Blender.Platform.Position, "Blender")
			local BlenderCommand = gameApi:Event("BlenderCommand", "PlaceOrder", { Recipe = recipe, Count = count })

			if BlenderCommand then
				local craftTime = recipeInfo.Time * count
				setTimer("Blender", os.time() + craftTime)
				gameApi:CacheSet("BlenderState", BlenderCommand)

				if not (not speedUp or not inventory:Has({ Ticket = count / recipeInfo.AutoCompletePerTicket })) then
					gameApi:Event("BlenderCommand", "SpeedUpOrder")
				end
			end
		end


		walkPattern = function()
			local x = vector.X
			local z = vector.Z
			local pattern = patterns[cfg.autofarm.pattern]
			local startCorner = cfg.autofarm.patternstart == "Top Left" and 1 or cfg.autofarm.patternstart == "Top Right" and 2 or cfg.autofarm.patternstart == "Bottom Left" and 3 or cfg.autofarm.patternstart == "Bottom Right" and 4 or 5
			local target = startCorner == 1

			if target then
				local v138 = position.Z - z / 2 + pattern[4]
				target = Vector3.new(position.X - x / 2 + pattern[3], getRootPart().Position.Y, v138)
			end

			if not target then
				target = startCorner == 2

				if target then
					local v138 = position.Z - z / 2 + pattern[4]
					target = Vector3.new(position.X + x / 2 - pattern[3], getRootPart().Position.Y, v138)
				end
			end

			if not target then
				target = startCorner == 3

				if target then
					local v138 = position.Z + z / 2 - pattern[4]
					target = Vector3.new(position.X - x / 2 + pattern[3], getRootPart().Position.Y, v138)
				end
			end

			if not target then
				target = startCorner == 4

				if target then
					local v138 = position.Z + z / 2 - pattern[4]
					target = Vector3.new(position.X + x / 2 - pattern[3], getRootPart().Position.Y, v138)
				end
			end

			if not target then
				local v138 = position.Z - pattern[2]
				target = Vector3.new(position.X - pattern[1], getRootPart().Position.Y, v138)
			end

			local function applyMoves(moveString)
				local directions = string.match(moveString, "%a+") or ""
				local stepSize = (directions == "NW" or directions == "NE" or directions == "SW" or directions == "SE") and 5 or 10
				local stepCount = string.match(moveString, "%d+%.?%d*") or 1

				string.gsub(directions, ".", function(direction)
					if startCorner == 2 then
						target += Vector3.new((direction == "E" and -stepCount or direction == "W" and stepCount or 0) * stepSize, 0, (direction == "N" and -stepCount or direction == "S" and stepCount or 0) * stepSize)
					elseif startCorner ~= 3 then
						if startCorner ~= 4 then
							target += Vector3.new((direction == "E" and stepCount or direction == "W" and -stepCount or 0) * stepSize, 0, (direction == "N" and -stepCount or direction == "S" and stepCount or 0) * stepSize)
						else
							target += Vector3.new((direction == "E" and -stepCount or direction == "W" and stepCount or 0) * stepSize, 0, (direction == "N" and stepCount or direction == "S" and -stepCount or 0) * stepSize)
						end
					else
						target += Vector3.new((direction == "E" and stepCount or direction == "W" and -stepCount or 0) * stepSize, 0, (direction == "N" and stepCount or direction == "S" and -stepCount or 0) * stepSize)
					end
				end)

				return target
			end

			for i, move in ipairs(pattern) do
				if getHumanoid().Health == 0 then
					error("return", 0)
				elseif i ~= 1 then
					if i > 4 then
						walkTo(applyMoves(move), true, 0)
					end
				else
					walkTo(target, true, 0)
				end
			end
		end

		farmFor = function(options, maxCount, interval)
			local now = os.clock()
			local stepsDone = 0

			while stepsDone <= maxCount do
				if not RunService.Heartbeat:Wait() then
					break
				end

				if not ((interval or 1.2) < os.clock() - now) then
					if getHumanoid().Health == 0 then
						error("return", 0)
					end
				else
					stepsDone += 1
				end

				farmStep(options)
			end
		end


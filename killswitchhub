				local function flyTo(target, trackedCategory)
					local now3, reachedNear = os.clock()
					local rootPart = getRootPart()
					local humanoid = getHumanoid()

					for _, child in ipairs(rootPart:GetChildren()) do
						if child.ClassName == "AlignPosition" or child.ClassName == "AlignOrientation" then
							child:Destroy()
						end
					end

					humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
					local AlignPosition = Instance.new("AlignPosition")
					AlignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
					AlignPosition.Attachment0 = rootPart.RootAttachment
					AlignPosition.Responsiveness = 200
					AlignPosition.MaxForce = math.huge
					AlignPosition.MaxVelocity = 300
					AlignPosition.Position = target.Position
					AlignPosition.Parent = rootPart
					local AlignOrientation = Instance.new("AlignOrientation")
					AlignOrientation.Attachment0 = rootPart.RootAttachment
					AlignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
					AlignOrientation.RigidityEnabled = true
					AlignOrientation.CFrame = rootPart.CFrame
					AlignOrientation.Parent = rootPart
					humanoid:ChangeState(Enum.HumanoidStateType.Physics)

					while true do
						if not state.fasttween then
							if not RunService.Heartbeat:Wait() then
								return
							end

							if not reachedNear and distanceTo(target.Position, true) < 4 then
								humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
								reachedNear = true
							end

							if not ((target.Name == true or target.Parent) and (target.Name ~= true or tracked[trackedCategory][target])) then
								break
							end

							if not ((wait and 5 or 3) < os.clock() - now3) then
								continue
							end
							break
						else
							return
						end
					end

					AlignPosition:Destroy()
					AlignOrientation:Destroy()
					tracked[trackedCategory][target] = nil
				end

				detectedFolder.AddSwitch("Run without autofarm", function(enabled)
					if not enabled or not (not state.stop and not threads:Get("fasttween")) then
						if not enabled then
							threads:Cancel("fasttween")
						end
					else
						threads:Add("fasttween", function()
							while RunService.Heartbeat:Wait() do
								if not state.stop and not state.fasttween and not cfg.autofarm.enabled then
									if getHumanoid().Health == 0 then
										localPlayer.CharacterAdded:Wait()
										task.wait(1)
									end

									local field = getFieldAt(getRootPart().Position)
									local nearest = nil
									local flying = nil

									if cfg.autofarm.farmcombococonuts then
										local comboamount = cfg.autofarm.comboamount
										local comboamount2 = tracked.comboamount
										local ok = comboamount == 0 or not comboamount2

										if not ok then
											local time = comboamount2.time
											ok = os.clock() - time > 30 or comboamount2.amount < comboamount
										end

										if ok then
											for k in pairs(tracked.combococonuts) do
												if getFieldAt(k.Position) == field then
													local distance = distanceTo(k.Position, true)

													if not nearest or distance < nearest.d then
														nearest = { d = distance, v = k }
													end
												end
											end

											if nearest then
												local nearestTarget = nearest.v

												if comboamount ~= 0 then
													tracked.comboamount = {
														time = os.clock(),
														amount = nearestTarget.Name == true and nearestTarget.Points or tonumber(string.match(nearestTarget.GuiAttach.Gui.TextLabel.Text, "%d+")) or 1,
													}
												end

												flying = true
												flyTo(nearestTarget, "combococonuts")
											end
										end
									end

									if not flying and not (not cfg.detected.fastshowertween or not cfg.autofarm.farmshowers) then
										for k in pairs(tracked.showers) do
											local start = k.Name == true and k.Start or k.Transparency

											if (not nearest or start < nearest.t) and getFieldAt(k.Position) == field then
												nearest = { t = start, v = k }
											end
										end

										if nearest then
											flying = true
											flyTo(nearest.v, "showers")
										end
									end

									if not flying and not (not cfg.detected.fastcoconuttween or not cfg.autofarm.farmcoconuts and (not cfg.convert.coconut or not (cfg.convert.coconutAt <= localPlayer.CoreStats.Pollen.Value / localPlayer.CoreStats.Capacity.Value * 100))) then
										for k in pairs(tracked.coconuts) do
											local start = k.Name == true and k.Start or k.Transparency

											if (not nearest or start < nearest.t) and getFieldAt(k.Position) == field then
												nearest = { t = start, v = k }
											end
										end

										if nearest then
											flyTo(nearest.v, "coconuts")
										end
									end
								end
							end
						end)
					end
				end, "detected", "background")


				-- Embedded icon/sound pack: name -> base64. Written to workspace/BuffTools/ before BuffTools starts.
				local ICON_PACK = { icons = {}, sounds = {} }

				local function b64decode(data)
					local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
					local map = {}
					for i = 1, #alphabet do
						map[alphabet:byte(i)] = i - 1
					end
					local out, n = {}, 0
					local bits, acc = 0, 0
					for i = 1, #data do
						local v = map[data:byte(i)]
						if v then
							acc = acc * 64 + v
							bits = bits + 6
							if bits >= 8 then
								bits = bits - 8
								local byte = math.floor(acc / 2 ^ bits)
								acc = acc - byte * 2 ^ bits
								n = n + 1
								out[n] = string.char(byte)
							end
						end
					end
					return table.concat(out)
				end

				local function installIcons()
					if type(writefile) ~= "function" or type(isfile) ~= "function" then
						return
					end
					if next(ICON_PACK.icons) == nil and next(ICON_PACK.sounds) == nil then
						return
					end
					if type(makefolder) == "function" then
						pcall(makefolder, "BuffTools")
						pcall(makefolder, "BuffTools/icons_r2")
						pcall(makefolder, "BuffTools/sounds")
					end
					for name, b64 in pairs(ICON_PACK.icons) do
						local path = "BuffTools/icons_r2/" .. name
						if not isfile(path) then
							pcall(writefile, path, b64decode(b64))
						end
					end
					for name, b64 in pairs(ICON_PACK.sounds) do
						local path = "BuffTools/sounds/r3_" .. name
						if not isfile(path) then
							pcall(writefile, path, b64decode(b64))
						end
					end
				end


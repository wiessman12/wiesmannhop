  if Webhook.sent[key] then return end
  if Webhook.post(title, description, color or Webhook.COLOR, opts) then
    Webhook.sent[key] = true
  end
end

function Webhook.tickBoostRun()
  if not ExtraUI.boost.run then return end
  local run = ExtraUI.boostRun
  if run.boostHooked then return end
  local started = run.boostStartedAt
  if type(started) ~= "number" then return end
  local needMin = tonumber(Session.webhookBoostMinutes) or 20
  local elapsed = (os.clock() - started) / 60
  if elapsed >= needMin then
    run.boostHooked = true
    local beforeH, nowH, gained
    pcall(function()
      beforeH = run.honeyStart
      nowH = getHoney() or HoneySt.seen
      if type(beforeH) == "number" and type(nowH) == "number" then
        gained = nowH - beforeH
      end
    end)
    local fields = {
      { name = "Time", value = "**" .. string.format("%.0f", elapsed) .. " min**", inline = true },
      { name = "Honey before", value = type(beforeH) == "number" and ("**" .. fmtHoney(beforeH) .. "**") or "—", inline = true },
      { name = "Honey now", value = type(nowH) == "number" and ("**" .. fmtHoney(nowH) .. "**") or "—", inline = true },
    }
    if type(gained) == "number" then
      local sign = gained >= 0 and "+" or ""
      fields[#fields + 1] = {
        name = "Gained",
        value = "**" .. sign .. fmtHoney(gained) .. "**",
        inline = true,
      }
    end
    Webhook.event(
      "boost_min_" .. tostring(math.floor(needMin)) .. "_" .. tostring(player.UserId) .. "_" .. tostring(math.floor(started)),
      "Enable boost · " .. tostring(math.floor(needMin)) .. "+ min",
      "**" .. player.Name .. "** finished a boost run.",
      Webhook.COLOR,
      {
        thumbnail = Webhook.IMG_BOOST,
        fields = fields,
        author = {
          name = player.Name,
          icon_url = Webhook.IMG_EXTRACT,
        },
      }
    )
  end
end

local function savePositions()
  if not canSave then return end
  local pos = {}
  for _, t in ipairs(gui:GetChildren()) do
    if t:GetAttribute("BTTile") then
      pos[t.Name] = { x = t.Position.X.Offset, y = t.Position.Y.Offset, sx = t.Position.X.Scale, sy = t.Position.Y.Scale }
    end
  end
  pos.__vis = ExtraUI.vis
  pos.__speedVal = ExtraUI.speedVal -- custom walk speed (nil = default 90)
  local autoSave = {}
  for i = 1, #ExtraUI.autoOrder do
    local name = ExtraUI.autoOrder[i]
    local it = ExtraUI.auto[name]
    autoSave[name] = { on = it.on == true, iv = it.iv, key = it.key }
  end
  autoSave.boost = {
    glitter = ExtraUI.boost.glitter,
    smoothie = ExtraUI.boost.smoothie,
    roll = ExtraUI.boost.roll,
    watch = ExtraUI.boost.watch == true,
  }
  pos.__auto = autoSave
  if ExtraUI.bar then
    pos.__autoBar = { x = ExtraUI.bar.Position.X.Offset, y = ExtraUI.bar.Position.Y.Offset }
  end
  pcall(function() writefile(Config.SAVE_FILE, HttpService:JSONEncode(pos)) end)
  -- tell Atlas (BuffTools tab) that an option changed so its switches stay in step
  pcall(function()
    local cb = Session.env and Session.env.BuffToolsSync
    if type(cb) == "function" then cb(ExtraUI.vis) end
  end)
end

local function loadPositions()
  if not canSave then return {} end
  local ok2, res = pcall(function()
    if isfile(Config.SAVE_FILE) then
      return HttpService:JSONDecode(readfile(Config.SAVE_FILE))
    end
  end)
  return (ok2 and type(res) == "table") and res or {}
end
local savedPos = loadPositions()
do
  local sv = tonumber(savedPos.__speedVal)
  if sv and sv >= 1 and sv <= 500 then ExtraUI.speedVal = sv end
end
do
  local v = savedPos.__vis
  if type(v) == "table" then
    for k in pairs(ExtraUI.vis) do
      if type(v[k]) == "boolean" then
        ExtraUI.vis[k] = v[k]
      elseif k == "rbcLang" and (v[k] == "en" or v[k] == "ru") then
        ExtraUI.vis[k] = v[k]
      end
    end
  end
  local a = savedPos.__auto
  if type(a) == "table" then
    for i = 1, #ExtraUI.autoOrder do
      local name = ExtraUI.autoOrder[i]
      local raw = a[name]
      local it = ExtraUI.auto[name]
      if type(raw) == "table" then
        if raw.on == true then it.on = true end
        if type(raw.iv) == "number" and raw.iv >= 1 then it.iv = math.floor(raw.iv) end
        if type(raw.key) == "number" then it.key = math.clamp(math.floor(raw.key), 1, 9) end
      elseif raw == true then
        it.on = true
      end
    end
    if a.s2 == true or a.stinger == true then ExtraUI.auto.s2.on = true end
    if a.s3 == true or a.jelly == true then ExtraUI.auto.s3.on = true end
    if type(a.boost) == "table" then
      local b = a.boost
      if type(b.glitter) == "number" then ExtraUI.boost.glitter = math.clamp(math.floor(b.glitter), 1, 9) end
      if type(b.smoothie) == "number" then ExtraUI.boost.smoothie = math.clamp(math.floor(b.smoothie), 1, 9) end
      -- target is always x4 (no UI changes it; a stale saved value must not move the goal)
      ExtraUI.boost.roll = 4
      -- hotbar prompt removed — ignore saved watch flag
      ExtraUI.boost.watch = false
    end
  end
end

-- Convert Scale+Offset using parent/viewport size. Never copy AbsolutePosition
-- (Potassium/GuiInset reports Absolute Y ~36px above Offset → tiles jump up on grab).
local function pinOnScreen(frame, w, h)
  if not frame then return end
  local cam = currentCamera()
  local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
  local pw, ph = vp.X, vp.Y
  local par = frame.Parent
  if par and par:IsA("GuiObject") then
    pw, ph = par.AbsoluteSize.X, par.AbsoluteSize.Y
  end
  local pos = frame.Position
  local x = pos.X.Scale * pw + pos.X.Offset
  local y = pos.Y.Scale * ph + pos.Y.Offset
  local sz = frame.AbsoluteSize
  w = w or sz.X
  h = h or sz.Y
  if w < 1 then w = 1 end
  if h < 1 then h = 1 end
  x = math.clamp(x, 0, math.max(0, pw - w))
  y = math.clamp(y, 0, math.max(0, ph - h))
  frame.Position = UDim2.fromOffset(x, y)
end

local function dragBoxSize(frame)
  local sz = frame.AbsoluteSize
  local w, h = sz.X, sz.Y
  if ScorchPanel.root and frame == ScorchPanel.root then
    local P = ScorchPanel
    w = math.max(w, P.ew)
    h = math.max(h, P.hh + P.rh * math.max(#P.items, 1) + 4)
  end
  local SP = FieldFx.SmilePanel
  if SP and SP.root and frame == SP.root then
    w = math.max(w, SP.ew)
    h = math.max(h, SP.hh + SP.rh * math.max(#SP.items, 1) + 4)
  end
  return w, h
end

local function makeDraggable(frame)
  frame.Active = true
  local dragging, start, startPos
  frame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      pinOnScreen(frame, dragBoxSize(frame))
      dragging, start, startPos = true, inp.Position, frame.Position
      local endConn
      endConn = inp.Changed:Connect(function()
        if inp.UserInputState ~= Enum.UserInputState.End then return end
        if dragging then
          dragging = false
          pinOnScreen(frame, dragBoxSize(frame))
          savePositions()
        end
        endConn:Disconnect()
      end)
    end
  end)
  Session.track(UIS.InputChanged:Connect(function(inp)
    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
      local dd = inp.Position - start
      local cam = currentCamera()
      local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
      local w, h = dragBoxSize(frame)
      local x = math.clamp(startPos.X.Offset + dd.X, 0, math.max(0, vp.X - w))
      local y = math.clamp(startPos.Y.Offset + dd.Y, 0, math.max(0, vp.Y - h))
      frame.Position = UDim2.fromOffset(x, y)
    end
  end))
end

local function makeDraggableClickable(frame, onClick)
  frame.Active = true
  local dragging, start, startPos, moved
  frame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      pinOnScreen(frame)
      dragging, start, startPos, moved = true, inp.Position, frame.Position, 0
    end
  end)
  Session.track(UIS.InputChanged:Connect(function(inp)
    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
      local dd = inp.Position - start
      moved = math.max(moved, math.abs(dd.X) + math.abs(dd.Y))
      local cam = currentCamera()
      local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
      local x = math.clamp(startPos.X.Offset + dd.X, 0, math.max(0, vp.X - frame.AbsoluteSize.X))
      local y = math.clamp(startPos.Y.Offset + dd.Y, 0, math.max(0, vp.Y - frame.AbsoluteSize.Y))
      frame.Position = UDim2.fromOffset(x, y)
    end
  end))
  frame.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      dragging = false
      pinOnScreen(frame)
      if moved < 7 then onClick() end
      savePositions()
    end
  end)
end


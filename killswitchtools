ExtraUI.layout = function()
  ExtraUI.scan()
  local slots = ExtraUI.slots
  if not slots then return end
  local s1 = slots[1]
  local s2 = slots[2]
  for i = 1, #ExtraUI.autoOrder do
    local it = ExtraUI.auto[ExtraUI.autoOrder[i]]
    local slot = slots[it.key]
    if slot and slot.Parent and slot.AbsoluteSize.Y > 20 then
      if not it.box or not it.box.Parent then
        ExtraUI.mkBox(it)
      end
      if it.box then
        local w = math.clamp(math.floor(slot.AbsoluteSize.X - 6), 52, 68)
        it.box.Size = UDim2.fromOffset(w, 34)
        it.box.AnchorPoint = Vector2.new(0.5, 0)
        it.box.Position = UDim2.new(0.5, 0, 1, 4)
        if it.box.Parent ~= slot then
          it.box.Parent = slot
        end
        slot.ClipsDescendants = false
        if slot.Parent then slot.Parent.ClipsDescendants = false end
        it.box.Visible = true
      end
    end
  end
  local gear = ExtraUI.gearBtn
  if gear and s1 and s1.Parent and s1.AbsoluteSize.Y > 20 then
    local host = s1.Parent
    local stride = s1.AbsoluteSize.X + 8
    if s2 and s2.Parent then
      local d = s2.AbsolutePosition.X - s1.AbsolutePosition.X
      if d > 8 then stride = d end
    end
    local gs = math.clamp(math.floor(math.min(s1.AbsoluteSize.X, s1.AbsoluteSize.Y) * 0.55), 26, 36)
    gear.Size = UDim2.fromOffset(gs, gs)
    gear.AnchorPoint = Vector2.new(0.5, 0.5)
    local cx = (s1.AbsolutePosition.X - host.AbsolutePosition.X) + s1.AbsoluteSize.X * 0.5 - stride + 10
    local cy = (s1.AbsolutePosition.Y - host.AbsolutePosition.Y) + s1.AbsoluteSize.Y * 0.5
    if gear.Parent ~= host then
      gear.Parent = host
    end
    gear.Position = UDim2.fromOffset(math.floor(cx + 0.5), math.floor(cy + 0.5))
    if ExtraUI.gearPanel and ExtraUI.bar then
      local ph = 148
      local gx = gear.AbsolutePosition.X
      local gy = gear.AbsolutePosition.Y
      local px, py = ExtraUI.place(gx, gy - ph - 8)
      if py < 8 then
        px, py = ExtraUI.place(gx, gy + gs + 8)
      end
      ExtraUI.gearPanel.Position = UDim2.fromOffset(math.max(8, math.floor(px)), math.floor(py))
    end
    if ExtraUI.boostPrompt and ExtraUI.bar then
      local px, py = ExtraUI.place(gear.AbsolutePosition.X, gear.AbsolutePosition.Y + gs + 6)
      ExtraUI.boostPrompt.Position = UDim2.fromOffset(math.floor(px), math.floor(py))
    end
  end
end


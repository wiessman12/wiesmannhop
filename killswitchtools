          beamPool[id] = nil
        end
        VisibleBeams = 0
      end
    elseif root then
      local nowT = os.time()
      local seen = {}
      local visCount = 0
      local maxVis = Config.BEAM_MAX_VISIBLE or 10
      local ranked = {}
      for id, info in pairs(Tokens) do
        local kind = info.kind
        if kind == "baby" or kind == "link" or kind == "inspire" or kind == "morph" or kind == "precision" or kind == "target" or kind == "smile" then
          local pos = info.pos
          if info.part and info.part.Parent then
            pos = FieldFx.tokenPos(info.part) or pos
            info.pos = pos
          end
          if pos then
            local dist = (pos - root.Position).Magnitude
            if dist < Config.BEAM_MAX_DIST then
              ranked[#ranked + 1] = { id = id, info = info, pos = pos, dist = dist, kind = kind }
            end
          end

local function scanBuffBarAlerts()
  local pag = getActivesGui()
  local stacks, left, coco = nil, nil, false
  if pag then
    local precId = iconId(IconMap.precision or Config.PRECISION_ICON) or KNOWN_PRECISION_ID
    pcall(function()
      for _, d in ipairs(pag:GetDescendants()) do
        if d:IsA("ImageLabel") or d:IsA("ImageButton") then
          local id = iconId(d.Image)
          if id and precId and tostring(id) == tostring(precId) then
            local nv = findStackTextNear(d)
            if nv and (not stacks or nv > stacks) then stacks = nv end
            local t = findTimerNear(d)
            if t and (not left or t < left) then left = t end
          end
        end
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
          local raw = tostring(d.Text or "")
          local low = raw:lower()
          if isCocoComboName(raw) or (low:find("coconut", 1, true) and low:find("combo", 1, true))
            or low:find("coco combo", 1, true) then
            coco = true
          end
        end
        if d:IsA("GuiObject") and isCocoComboName(tostring(d.Name or "")) then
          coco = true
        end
      end
    end)
  end
  for src, b in pairs(Buffs) do
    if type(src) == "string" and b and isCocoComboName(src) then
      local l = buffLeft(src)
      if l == nil or l > 0 then coco = true end
    end
  end
  return stacks, left, coco
end

MorphTrack.tickAlerts = function()
  local barStacks, barLeft, coco = scanBuffBarAlerts()
  local p = Buffs["Precision"]
  local stacks, secs, how
  if p and not p.fromGui and not p.fromSlot and type(p.start) == "number" and type(p.dur) == "number" then
    -- server stream (ServerBuffEvent Apply "Precision" start/dur/combo) is authoritative: never overwrite it from the GUI
    stacks = type(p.combo) == "number" and p.combo or 0
    secs = buffLeft("Precision")
    how = "stream"
  else
    stacks = barStacks or ((p and type(p.combo) == "number") and p.combo or 0)
    if barStacks and barStacks > 0 then
      if not p then
        p = { fromGui = true }
        Buffs["Precision"] = p
      end
      p.combo = barStacks
      if barLeft then
        local now = FieldFx.serverNow()
        p.start = now + barLeft - Config.PRECISION_DUR
        p.dur = Config.PRECISION_DUR
        p.fromGui = true
      end
    end
    secs = barLeft
    if secs == nil then secs = buffLeft("Precision") end
    how = barLeft and "bar" or (secs and "buff" or "none")
  end
  local need = (tonumber(stacks) or 0) >= 10
    and type(secs) == "number" and secs > 0 and secs < MorphTrack.PRECISION_WARN_SEC
  MorphTrack.setPrecisionAlert(need)
  if (tonumber(stacks) or 0) > 0 then
    MorphTrack.dbg("prec_state", string.format("Precision x%s left=%s via=%s need=%s alertOn=%s",
      tostring(stacks), secs and string.format("%.1f", secs) or "nil", how, tostring(need), tostring(MorphTrack.precisionAlertOn)), 5)
  end
  if coco and not MorphTrack.cocoSeen then
    MorphTrack.playCocoCombo("buff bar / buff table shows Coconut Combo")
  end
  MorphTrack.cocoSeen = coco and true or false
  MorphTrack.dbgFlush(false)
end

local function hasNamedBuff(name)
  if type(name) ~= "string" then return false end
  local want = name:lower():gsub("[%s%p_]", "")
  for src, b in pairs(Buffs) do
    if type(src) == "string" and b then
      local compact = src:lower():gsub("[%s%p_]", "")
      if compact == want then
        local left = buffLeft(src)
        if left == nil then return true end
        if left > 0 then return true end
      end
    end
  end
  return false
end

local function fmtHoney(n)
  n = tonumber(n) or 0
  if n < 0 then n = 0 end
  local function pair(div, suf)
    local v = n / div
    local s
    if v >= 100 then
      s = string.format("%d", math.floor(v + 0.5))
    elseif v >= 10 then
      s = string.format("%.1f", v)
    else
      s = string.format("%.2f", v)
    end
    s = s:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
    return s .. suf
  end
  if n >= 1e33 then return pair(1e33, "Dc") end
  if n >= 1e30 then return pair(1e30, "No") end
  if n >= 1e27 then return pair(1e27, "Oc") end
  if n >= 1e24 then return pair(1e24, "Sp") end
  if n >= 1e21 then return pair(1e21, "Sx") end
  if n >= 1e18 then return pair(1e18, "Qn") end
  if n >= 1e15 then return pair(1e15, "Qd") end
  if n >= 1e12 then return pair(1e12, "T") end
  if n >= 1e9 then return pair(1e9, "B") end
  if n >= 1e6 then return pair(1e6, "M") end
  if n >= 1e3 then return pair(1e3, "k") end
  return tostring(math.floor(n))
end


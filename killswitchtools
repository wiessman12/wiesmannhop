    if not counts[ch] then counts[ch] = 0; order[#order + 1] = ch end
    counts[ch] = counts[ch] + 1
  end
  table.sort(order, function(a, b) return counts[a] > counts[b] end)
  local key = '<font color="#a6927c">'
  local top = {}
  for i = 1, math.min(3, #order) do
    top[#top + 1] = ExtraUI.metaNames[order[i]:byte() - 96] .. " x" .. counts[order[i]]
  end
  if H.sumText then

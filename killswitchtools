-- Volume: default loudness of every sound (Roblox allows 0..10) x per-sound slider x master slider (both 0..2, default 1)
MorphTrack.BASEVOL = { ["20t.mp3"] = 2.5, ["49t.mp3"] = 2.5, ["99t.mp3"] = 2.5, ["Double Morph.mp3"] = 1,
  ["Precision.mp3"] = 5, ["cococombo.mp3"] = 1.2 }
MorphTrack.sndVol = function(file)
  local c = MorphTrack.sndCfg
  local k = MorphTrack.sndByFile[file]
  local per = tonumber(k and c["v_" .. k]) or 1

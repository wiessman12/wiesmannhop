local function pruneAndCollect(root, kind, maxDist)
  local now = os.clock()
  local origin = root.Position
  local out = {}
  for i = #FarmMarks, 1, -1 do
    local m = FarmMarks[i]
    if now > m.expires then
      table.remove(FarmMarks, i)
    elseif (not kind or m.kind == kind) then
      local dx = m.pos.X - origin.X
      local dz = m.pos.Z - origin.Z
      local dist = math.sqrt(dx * dx + dz * dz)
      if dist <= maxDist and math.abs(m.pos.Y - origin.Y) < 56 then
        out[#out + 1] = m
      end
    end
  end
  return out
end

local updateFarmVisuals
do
  local function defineFarmVisuals()
local standZoneSig = ""
local standZoneHit = nil

local function computeStandZone(marks)
  if #marks == 0 then return nil, nil, 0 end
  local sigParts = {}
  for i = 1, #marks do
    local m = marks[i]
    sigParts[i] = string.format("%.1f,%.1f,%.1f,%.1f", m.pos.X, m.pos.Y, m.pos.Z, m.rad)
  end
  local sig = table.concat(sigParts, ";")
  if standZoneHit and sig == standZoneSig then
    return standZoneHit[1], standZoneHit[2], standZoneHit[3], standZoneHit[4]
  end
  local function store(pos, rad, n, types)
    standZoneSig = sig
    standZoneHit = { pos, rad, n, types }
    return pos, rad, n, types
  end
  if #marks == 1 then
    return store(marks[1].pos, math.clamp(marks[1].rad * 0.22, 2.4, 5.5), 1, 1)
  end
  local minX, maxX = marks[1].pos.X, marks[1].pos.X
  local minZ, maxZ = marks[1].pos.Z, marks[1].pos.Z
  local ySum = 0
  for _, m in ipairs(marks) do
    if m.pos.X < minX then minX = m.pos.X end
    if m.pos.X > maxX then maxX = m.pos.X end
    if m.pos.Z < minZ then minZ = m.pos.Z end
    if m.pos.Z > maxZ then maxZ = m.pos.Z end
    ySum = ySum + m.pos.Y
  end
  local y = ySum / #marks
  local step = 1.5
  local bestN, bestTypes, bestClear = 0, 0, -1
  local bestX, bestZ = marks[1].pos.X, marks[1].pos.Z
  for x = minX, maxX, step do
    for z = minZ, maxZ, step do
      local n, clear, has14, has18 = 0, math.huge, false, false
      for _, m in ipairs(marks) do
        local dx = x - m.pos.X
        local dz = z - m.pos.Z
        local d = math.sqrt(dx * dx + dz * dz)
        if d <= m.rad then
          n = n + 1
          if m.rad <= 16 then has14 = true else has18 = true end
          local c = m.rad - d
          if c < clear then clear = c end
        end
      end
      local types = (has14 and 1 or 0) + (has18 and 1 or 0)
      -- Dump: r14 and r18 are different mark families on the same field.
      -- Mix of both + more stacks = more Pollen/Honey/Precise coverage.
      if types > bestTypes
        or (types == bestTypes and n > bestN)
        or (types == bestTypes and n == bestN and n > 0 and clear > bestClear) then
        bestTypes = types
        bestN = n
        bestClear = clear
        bestX = x
        bestZ = z
      end
    end
  end
  if bestN < 1 then return store(nil, nil, 0, 0) end
  local standR = math.clamp((bestClear > 0 and bestClear or 2.4) * 0.72, 2.2, 6.2)
  if bestN < 2 then
    standR = math.clamp(standR, 2.2, 4.2)
  end
  return store(Vector3.new(bestX, y, bestZ), standR, bestN, bestTypes)
end

local function xzDist(ax, az, bx, bz)
  local dx, dz = ax - bx, az - bz
  return math.sqrt(dx * dx + dz * dz)
end

local function circleHits(c1, c2)
  local d = xzDist(c1.pos.X, c1.pos.Z, c2.pos.X, c2.pos.Z)
  local r1, r2 = c1.rad, c2.rad
  if d < 0.05 or d > r1 + r2 - 0.05 or d < math.abs(r1 - r2) + 0.05 then
    return nil, nil
  end
  local a = (r1 * r1 - r2 * r2 + d * d) / (2 * d)
  local h2 = r1 * r1 - a * a
  if h2 < 0 then return nil, nil end
  local h = math.sqrt(h2)
  local ux = (c2.pos.X - c1.pos.X) / d
  local uz = (c2.pos.Z - c1.pos.Z) / d
  local mx = c1.pos.X + ux * a
  local mz = c1.pos.Z + uz * a
  local px, pz = -uz * h, ux * h
  local y = (c1.pos.Y + c2.pos.Y) * 0.5
  return Vector3.new(mx + px, y, mz + pz), Vector3.new(mx - px, y, mz - pz)
end

local function insideAllMarks(pt, marks, slop)
  slop = slop or 0.2
  for _, m in ipairs(marks) do
    if xzDist(pt.X, pt.Z, m.pos.X, m.pos.Z) > m.rad + slop then
      return false
    end
  end
  return true
end

local function coveringAt(pos, marks)
  local out = {}
  for _, m in ipairs(marks) do
    if xzDist(pos.X, pos.Z, m.pos.X, m.pos.Z) <= m.rad + 0.15 then
      out[#out + 1] = m
    end
  end
  return out
end

local function sampleRing(pos, rad, n)
  local pts = {}
  local k = math.max(16, n or 28)
  for i = 0, k - 1 do
    local a = (i / k) * math.pi * 2
    pts[#pts + 1] = Vector3.new(pos.X + math.cos(a) * rad, pos.Y, pos.Z + math.sin(a) * rad)
  end
  return pts
end

local function intersectionOutline(discs, y)
  if #discs == 0 then return {} end
  if #discs == 1 then
    return sampleRing(Vector3.new(discs[1].pos.X, y, discs[1].pos.Z), math.max(2.5, discs[1].rad - 0.35), 32)
  end
  local verts = {}
  for i = 1, #discs do
    for j = i + 1, #discs do
      local p, q = circleHits(discs[i], discs[j])
      if p and insideAllMarks(p, discs, 0.25) then
        verts[#verts + 1] = Vector3.new(p.X, y, p.Z)
      end
      if q and insideAllMarks(q, discs, 0.25) then
        verts[#verts + 1] = Vector3.new(q.X, y, q.Z)
      end
    end
  end
  if #verts < 3 then
    local c = discs[1].pos
    local r = discs[1].rad
    for i = 2, #discs do
      if discs[i].rad < r then
        r = discs[i].rad
        c = discs[i].pos
      end
    end
    return sampleRing(Vector3.new(c.X, y, c.Z), math.max(2.2, r * 0.35), 24)
  end
  local cx, cz = 0, 0
  for _, v in ipairs(verts) do
    cx = cx + v.X
    cz = cz + v.Z
  end
  cx, cz = cx / #verts, cz / #verts
  table.sort(verts, function(a, b)
    return math.atan2(a.Z - cz, a.X - cx) < math.atan2(b.Z - cz, b.X - cx)
  end)
  return verts
end

local function ensureOutlineSeg(i)

-- Longest remaining time among buffs matching any word (nil = buff absent).
ExtraUI.autoBuffLeft = function(words)
  if type(words) ~= "table" then return nil end
  local best
  for src, b in pairs(Buffs) do
    if type(src) == "string" and type(b) == "table" then
      local low = src:lower()
      for i = 1, #words do
        if low:find(tostring(words[i]):lower(), 1, true) then
          local left = buffLeft(src)
          if left == nil then
            -- active without known duration — treat as healthy
            return 999
          end
          if left > 0 and (not best or left > best) then
            best = left
          end
          break
        end
      end
    end
  end
  return best
end

ExtraUI.tick = function(now)
  if ExtraUI.bar and now - ExtraUI.auto.scanAt >= 0.4 then
    ExtraUI.auto.scanAt = now
    ExtraUI.layout()
  end
  for i = 1, #ExtraUI.autoOrder do
    local name = ExtraUI.autoOrder[i]
    local it = ExtraUI.auto[name]
    ExtraUI.paintBox(it, now)
    if it.on then
      if it.mode == "prolong" then
        -- The number is the renew period (same as "every N s" on plain chips), so changing it changes the
        -- behaviour 1:1: re-press every N s while the buff is up, and right away (>=1.6s gap) when it is missing.
        local left = ExtraUI.autoBuffLeft(it.words)
        local period = math.max(1.6, tonumber(it.iv) or 10)
        local since = now - (it.last or 0)
        if left ~= nil then
          it.seen = true
          it.missTries = 0
        end
        if left == nil then
          -- Buff not visible. Fast 1.6s retry ONLY if we have seen this buff before AND the last few retries worked
          -- (some players' buff is never reported under this name -> that used to spam the key every ~1s).
          local gap = 1.6
          if not it.seen or (it.missTries or 0) >= 3 then gap = period end
          if since >= gap - 0.15 then
            it.last = now
            it.missTries = (it.missTries or 0) + 1
            ExtraUI.press(it.key)
          end
        elseif (it.last or 0) == 0 then
          it.seen = true
          it.missTries = 0
          it.last = now -- buff already running: start counting from now
        elseif since >= period - 0.15 then
          it.seen = true
          it.missTries = 0
          it.last = now
          ExtraUI.press(it.key)
        end
      elseif (now - (it.last or 0)) >= (tonumber(it.iv) or 10) - 0.15 then
        it.last = now
        ExtraUI.press(it.key)
      end
    end
  end
  ExtraUI.paintBoost()
end

ExtraUI.dragBar = function(handle, onClick)
  handle.Active = true
  local dragging, start, origin, moved
  handle.InputBegan:Connect(function(inp)
    if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    if not ExtraUI.bar then return end
    ExtraUI.barPinned = true
    dragging, start, origin, moved = true, inp.Position, ExtraUI.bar.Position, 0
    local endConn
    endConn = inp.Changed:Connect(function()
      if inp.UserInputState ~= Enum.UserInputState.End then return end
      local dist = moved or 0
      dragging = false
      if dist < 7 and onClick then onClick() end
      savePositions()
      endConn:Disconnect()
    end)
  end)
  Session.track(UIS.InputChanged:Connect(function(inp)
    if not dragging then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    local dd = inp.Position - start
    moved = math.max(moved or 0, math.abs(dd.X) + math.abs(dd.Y))
    local cam = currentCamera()
    local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local w = ExtraUI.bar.AbsoluteSize.X
    local h = ExtraUI.bar.AbsoluteSize.Y
    if w < 1 then w = 1 end
    if h < 1 then h = 1 end
    local x = math.clamp(origin.X.Offset + dd.X, 0, math.max(0, vp.X - w))
    local y = math.clamp(origin.Y.Offset + dd.Y, 0, math.max(0, vp.Y - h))
    ExtraUI.bar.Position = UDim2.fromOffset(x, y)
  end))
end


local function getHoney()
  local n = bindCoreHoney()
  if n then return n end
  if HoneySt.stat and HoneySt.stat.Parent then
    n = valueOf(HoneySt.stat)
    if n then return n end
  end
  local ls = player:FindFirstChild("leaderstats")
  if ls then
    local inst, v = findHoneyValue(ls, 0)
    if inst then HoneySt.stat = inst return v end
  end
  for _, name in ipairs({ "Stats", "Data", "Stat", "PlayerStats" }) do
    local folder = player:FindFirstChild(name)
    if folder then
      local inst, v = findHoneyValue(folder, 0)
      if inst then HoneySt.stat = inst return v end
    end
  end
  local inst, v = findHoneyValue(player, 0)
  if inst then HoneySt.stat = inst return v end
  local a = player:GetAttribute("Honey") or player:GetAttribute("honey")
  if type(a) == "number" then return a end
  if os.clock() - HoneySt.guiScan > 1.2 then
    HoneySt.guiScan = os.clock()
    local g = scanHoneyGui()
    if g then HoneySt.guiVal = g end
  end
  return HoneySt.guiVal
end

local Data = {
  precision = { stacks = 0, secs = nil, source = nil },
  scorch = { active = nil, untilN = nil, got = nil, mult = nil, links = nil },
  xflame = { untilN = nil, got = nil },
  morph = { stacks = 0, names = {}, secs = nil, bear = nil },
  petals = { stacks = 0, secs = nil, mult = nil, srcName = nil },
  flames = { count = 0, nearest = nil, fuel = nil },
  honey = { gained = 0, avgScorch = 0, scorches = 0, boosting = false },
}

local function readAll()
  local nowClock = os.clock()
  local nowTime = os.time()
  local char = player.Character

  for src, b in pairs(Buffs) do
    if not b.fromSlot and not b.fromGui and type(b.start) == "number" and type(b.dur) == "number" and b.start + b.dur - nowTime <= 0 then
      Buffs[src] = nil
    end
  end

  local p = Buffs["Precision"]
  Data.precision.stacks = (p and type(p.combo) == "number") and p.combo or 0
  Data.precision.secs = buffLeft("Precision")
  Data.precision.source = p and (p.fromGui and "gui" or (p.fromSlot and "slot" or "stream")) or nil
  pcall(MorphTrack.tickAlerts)

  local pe = Buffs["Red Petal"]
  local petalSrc = pe and "Red Petal" or nil
  if not pe and Config.PETAL_FALLBACK then
    local candidates = {}
    for src, b in pairs(Buffs) do
      if #src > 6 and src:sub(-6) == " Petal" and type(b.combo) == "number" and b.combo > 0 then
        candidates[#candidates + 1] = src
      end
    end
    table.sort(candidates)
    if candidates[1] then
      petalSrc = candidates[1]
      pe = Buffs[candidates[1]]
    end
  end
  Data.petals.stacks = (pe and type(pe.combo) == "number") and pe.combo or 0
  Data.petals.secs = (pe and type(pe.start) == "number" and type(pe.dur) == "number")
    and math.max(0, pe.start + pe.dur - nowTime) or nil
  Data.petals.srcName = petalSrc
  Data.petals.mult = Data.petals.stacks > 0 and math.min(2, 1.25 + 0.007576 * (Data.petals.stacks - 1)) or nil

  local mv = char and char:FindFirstChild("Morph")
  local bearName = nil
  if mv and mv:IsA("ObjectValue") and mv.Value then
    bearName = tostring(mv.Value.Name)
  end
  local names, stacks, secs = {}, 0, nil
  for src, b in pairs(Buffs) do
    if #src > 6 and src:sub(-6) == " Morph" and src:find("Bear", 1, true) then
      local l = (type(b.start) == "number" and type(b.dur) == "number") and (b.start + b.dur - nowTime) or nil
      if l and l > 0 then
        stacks = stacks + 1
        names[#names + 1] = src:sub(1, #src - 6)
        if not secs or l > secs then secs = l end
      elseif l == nil and not b.fromSlot and not b.fromGui and bearName and bearName == src:sub(1, #src - 6) then
        stacks = stacks + 1
        names[#names + 1] = bearName
      end
    end
  end
  if stacks == 0 and bearName then
    stacks = 1
    names[1] = bearName
  end
  Data.morph.stacks = stacks
  Data.morph.names = names
  Data.morph.secs = secs
  Data.morph.bear = bearName
  MorphTrack.syncIdle(stacks > 0)

  local auraB = Buffs["Scorching Star Aura"]
  if not auraB then
    for src, b in pairs(Buffs) do
      if #src > 10 and src:sub(-10) == " Star Aura" then auraB = b break end
    end
  end
  local d = Data.scorch
  d.active = nil
  if auraB and type(auraB.start) == "number" and type(auraB.dur) == "number" then
    local l = auraB.start + auraB.dur - nowTime
    if l > 0 then
      d.active = l
      local c = type(auraB.combo) == "number" and auraB.combo or 0
      d.mult = math.min(5, 2 + 0.012048 * c)
      d.links = math.floor(5 + 0.1005 * c)
    end
  end
  d.untilN, d.got = counterUntil(CounterTrack.sc, Counters.scorch, Config.SCORCH_MAX)

  Data.xflame.untilN, Data.xflame.got = counterUntil(CounterTrack.xf, Counters.xflame, Config.XFLAME_MAX)
  if xfPrevUntil and Data.xflame.untilN and xfPrevUntil <= 2 and Data.xflame.untilN >= (Config.XFLAME_MAX - 3) then
    xfBurstUntil = os.clock() + 1.6
  end
  xfPrevUntil = Data.xflame.untilN

  local fuelLeft = buffLeft("Flame Fuel")
  Data.flames.fuel = fuelLeft
  local life = Config.FLAME_LIFETIME * ((fuelLeft and fuelLeft > 0) and Config.FUEL_MULT or 1)
  local root = char and char:FindFirstChild("HumanoidRootPart")
  local nowBurst = nowClock < xfBurstUntil
  local folder = getFlameFolder()
  local pend = nowClock < (Counters.xfPendUntil or 0)
  if root and folder and (nowBurst or pend or next(xfTagged) ~= nil) then
    local origin = root.Position
    local finfo = Counters.finfo
    Counters.xfLife = Counters.xfLife or setmetatable({}, { __mode = "k" })
    for _, ch in ipairs(folder:GetChildren()) do
      if ch:IsA("BasePart") and not xfTagged[ch] then
        local fid = tonumber(string.match(ch.Name, "^Flm(%d+)$"))
        local rec = fid and finfo[fid]
        if rec then
          -- exact: the LocalFlames event tells when it was cast, how long it lives and whether it belongs to the X-Flame
          if rec.xf then
            xfTagged[ch] = rec.t
            Counters.xfLife[ch] = rec.T
          end
        else
          local dist = (ch.Position - origin).Magnitude
          if dist <= Config.XF_HUD_DIST then
            local nm = string.lower(ch.Name)
            local namedXf = string.find(nm, "xflame", 1, true) or string.find(nm, "x-flame", 1, true) or string.find(nm, "cross", 1, true)
            if nowBurst or namedXf then
              xfTagged[ch] = nowClock
            end
          end
        end
      end
    end
  end
  for part, born in pairs(xfTagged) do
    local pl = Counters.xfLife and Counters.xfLife[part] or life
    if not part.Parent or (nowClock - born) > (pl + 0.4) then
      xfTagged[part] = nil
    end
  end

  for id, t in pairs(Tokens) do
    local liveWorld = type(id) == "string" and id:sub(1, 2) == "w_" and t.part and t.part.Parent
    if not liveWorld and type(t.expires) == "number" and t.expires < nowTime then
      Tokens[id] = nil
    end
  end

  local h = getHoney()
  if HoneySt.guiScan == 0 or os.clock() - HoneySt.guiScan > 0.8 then
    HoneySt.guiScan = os.clock()
    scanHoneyGui()
  end
  if h then
    if HoneySt.atInject == nil then
      if h > 0 or os.clock() >= HoneySt.lockAt then
        HoneySt.atInject = h
      end
    end
    if HoneySt.seen and h > HoneySt.seen + 0.5 then
      HoneySt.gainAt = os.clock()
    end
    HoneySt.seen = h
    Data.honey.gained = math.max(0, h - (HoneySt.atInject or h))
  end
  Data.honey.boosting = HoneySt.gainAt > 0 and (os.clock() - HoneySt.gainAt) < 4

  local on = Data.scorch.active ~= nil
  do
    local P = ScorchPanel
    if on and not HoneySt.prevOn then
      HoneySt.procs = HoneySt.procs + 1
      P.winH = h
    elseif (not on) and HoneySt.prevOn then
      if P.winH and h then
        P.n = P.n + 1
        local gain = math.max(0, h - P.winH)
        P.items[#P.items + 1] = { n = P.n, g = gain }
        while #P.items > 20 do table.remove(P.items, 1) end
        P.paint()
        -- honey of the last flame ticks lands a moment after the aura drops: re-read, take the larger
        local winH0, firstGain = P.winH, gain
        task.spawn(function()
          task.wait(1.5)
          if not Session.alive then return end
          local h2 = getHoney()
          local g2 = (h2 and winH0) and math.max(0, h2 - winH0) or 0
          local g = math.max(firstGain, g2)
          if g >= 99e12 then
            MorphTrack.playFile("99t.mp3")
          elseif g > 49e12 then
            MorphTrack.playFile("49t.mp3")
          elseif g > 20e12 then
            MorphTrack.playFile("20t.mp3")
          end
        end)
      end
      P.winH = nil
    end
  end
  HoneySt.prevOn = on
  Data.honey.scorches = HoneySt.procs
  Data.honey.avgScorch = (HoneySt.procs > 0) and (Data.honey.gained / HoneySt.procs) or 0
  FieldFx.flamePass(root)
end


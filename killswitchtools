function FieldFx.honeyName(nm)
  if type(nm) ~= "string" then return false end
  local s = string.lower(nm)
  if string.find(s, "mark", 1, true) or string.find(s, "gift", 1, true) then return false end
  return s == "honey" or s == "honey token" or string.find(s, "honeytoken", 1, true) ~= nil
end

function FieldFx.cover(part)
  if not part or FieldFx.hidden[part] then return end
  local ok = pcall(function()
    part.LocalTransparencyModifier = 1
    local kids = part:GetDescendants()
    for i = 1, #kids do
      local d = kids[i]
      if d:IsA("Decal") or d:IsA("Texture") then
        d.LocalTransparencyModifier = 1
      elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
        FieldFx.emitters[d] = d.Enabled
        d.Enabled = false
      end
    end
  end)
  if ok then FieldFx.hidden[part] = true end
end

function FieldFx.uncover(part)
  if not part or not FieldFx.hidden[part] then return end
  FieldFx.hidden[part] = nil
  pcall(function()
    part.LocalTransparencyModifier = 0
    local kids = part:GetDescendants()
    for i = 1, #kids do
      local d = kids[i]
      if d:IsA("Decal") or d:IsA("Texture") then
        d.LocalTransparencyModifier = 0
      elseif FieldFx.emitters[d] ~= nil then
        d.Enabled = FieldFx.emitters[d]
        FieldFx.emitters[d] = nil
      end
    end
  end)
end


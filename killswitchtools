-- Convert Scale+Offset using parent/viewport size. Never copy AbsolutePosition
-- (Potassium/GuiInset reports Absolute Y ~36px above Offset → tiles jump up on grab).
local function pinOnScreen(frame, w, h)
  if not frame then return end
  local cam = currentCamera()
  local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
  local pw, ph = vp.X, vp.Y
  local par = frame.Parent
  if par and par:IsA("GuiObject") then
    pw, ph = par.AbsoluteSize.X, par.AbsoluteSize.Y
  end
  local pos = frame.Position
  local x = pos.X.Scale * pw + pos.X.Offset
  local y = pos.Y.Scale * ph + pos.Y.Offset
  local sz = frame.AbsoluteSize
  w = w or sz.X
  h = h or sz.Y
  if w < 1 then w = 1 end
  if h < 1 then h = 1 end
  x = math.clamp(x, 0, math.max(0, pw - w))
  y = math.clamp(y, 0, math.max(0, ph - h))
  frame.Position = UDim2.fromOffset(x, y)
end

local function dragBoxSize(frame)
  local sz = frame.AbsoluteSize
  local w, h = sz.X, sz.Y
  if ScorchPanel.root and frame == ScorchPanel.root then
    local P = ScorchPanel
    w = math.max(w, P.ew)
    h = math.max(h, P.hh + P.rh * math.max(#P.items, 1) + 4)
  end
  local SP = FieldFx.SmilePanel
  if SP and SP.root and frame == SP.root then
    w = math.max(w, SP.ew)
    h = math.max(h, SP.hh + SP.rh * math.max(#SP.items, 1) + 4)
  end
  return w, h
end

local function makeDraggable(frame)
  frame.Active = true
  local dragging, start, startPos
  frame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      pinOnScreen(frame, dragBoxSize(frame))
      dragging, start, startPos = true, inp.Position, frame.Position
      local endConn
      endConn = inp.Changed:Connect(function()
        if inp.UserInputState ~= Enum.UserInputState.End then return end
        if dragging then
          dragging = false
          pinOnScreen(frame, dragBoxSize(frame))
          savePositions()
        end
        endConn:Disconnect()
      end)
    end
  end)
  Session.track(UIS.InputChanged:Connect(function(inp)
    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
      local dd = inp.Position - start
      local cam = currentCamera()
      local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
      local w, h = dragBoxSize(frame)
      local x = math.clamp(startPos.X.Offset + dd.X, 0, math.max(0, vp.X - w))
      local y = math.clamp(startPos.Y.Offset + dd.Y, 0, math.max(0, vp.Y - h))
      frame.Position = UDim2.fromOffset(x, y)
    end
  end))
end

local function makeDraggableClickable(frame, onClick)
  frame.Active = true
  local dragging, start, startPos, moved
  frame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      pinOnScreen(frame)
      dragging, start, startPos, moved = true, inp.Position, frame.Position, 0
    end
  end)
  Session.track(UIS.InputChanged:Connect(function(inp)
    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
      local dd = inp.Position - start
      moved = math.max(moved, math.abs(dd.X) + math.abs(dd.Y))
      local cam = currentCamera()
      local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
      local x = math.clamp(startPos.X.Offset + dd.X, 0, math.max(0, vp.X - frame.AbsoluteSize.X))
      local y = math.clamp(startPos.Y.Offset + dd.Y, 0, math.max(0, vp.Y - frame.AbsoluteSize.Y))
      frame.Position = UDim2.fromOffset(x, y)
    end
  end))
  frame.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      dragging = false
      pinOnScreen(frame)
      if moved < 7 then onClick() end
      savePositions()
    end
  end)
end


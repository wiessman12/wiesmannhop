-- normalize any icon URL to its trailing numeric asset id
local function iconId(icon)
  if type(icon) == "number" then
    return tostring(math.floor(icon))
  end
  if type(icon) ~= "string" then return nil end
  -- "rbxassetid://123", "...asset/?id=123", "...?id=123&x=1": take id=, else trailing digits, else last long digit run
  local id = icon:match("[?&]id=(%d+)") or icon:match("(%d+)$")
  if id then return id end
  local last
  for run in icon:gmatch("%d+") do
    if #run >= 6 then last = run end
  end
  return last
end


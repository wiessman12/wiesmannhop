ExtraUI.hivePaint = function(noRead)
  local H = ExtraUI.hive
  if not H.page or not H.cells[1] then return end
  if (H.sub or 1) > 1 then return ExtraUI.hivePaintMeta() end
  local grid, total
  if noRead and H.grid and H.total then
    grid, total = H.grid, H.total
  else
    grid, total = ExtraUI.hiveRead()
  end
  if not grid then
    if H.sumText then H.sumText.Text = '<font color="#8a8080">Hive data not available yet.</font>' end
    return
  end
  -- game layout: y1 is the BOTTOM row; all 10 rows shown, unbought (locked) slots dimmed with a lock
  local rows = 10
  H.rows = rows
  local slots = total.slots or 50
  for c = 1, 5 do
    for r = 1, 10 do
      local rec = H.cells[c][r]
      local y = rows - r + 1
      rec.btn.Visible = true
      if H.metaWas then
        -- coming back from a meta hive: restore the normal cell look
        if H.hasHex then rec.btn.ImageTransparency = 0 else rec.btn.BackgroundTransparency = 0 end
        rec.thumb.ImageRectOffset = Vector2.new(0, 0)
        rec.thumb.ImageRectSize = Vector2.new(0, 0)
        rec.thumb.ScaleType = Enum.ScaleType.Fit
        rec.thumb.Size = UDim2.fromScale(0.96, 0.96)
      end
      local d = grid[c .. "," .. y]
      local locked = (not d) and (((y - 1) * 5 + c) > slots)
      local isSel = H.sel and H.sel[1] == c and H.sel[2] == y
      if d then
        local info = ExtraUI.hiveBeeInfo(d.type)
        local fill = info.color
        if H.hasHex then rec.btn.ImageColor3 = fill else rec.btn.BackgroundColor3 = fill end
        local thumb = info.thumb
        if d.gifted and info.gthumb ~= "" then thumb = info.gthumb end
        rec.thumb.Visible = false
        if info.faceTex ~= "" then
          -- the bee's actual face decal on its body colour
          rec.face.Image = info.faceTex
          rec.face.ImageColor3 = info.faceDecalColor
          rec.face.Visible = true
          rec.init.Visible = false
        elseif thumb ~= "" then
          rec.thumb.Image = thumb
          rec.thumb.Visible = true
          rec.face.Visible = false
          rec.init.Visible = false
        else
          rec.thumb.Visible = false
          rec.face.Visible = false
          rec.init.Text = d.type:sub(1, 2)
          rec.init.Visible = true
        end
        rec.lock.Visible = false
        rec.lvl.Text = tostring(d.lvl)
        rec.lvl.TextColor3 = (#d.mutas > 0) and ExtraUI.hiveMut(d.mutas[1].key).color or Color3.fromRGB(255, 255, 255)
        rec.lvl.Visible = true
        rec.ring.ImageTransparency = (d.gifted or isSel) and 0 or 1
        rec.ring.ImageColor3 = isSel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 214, 60)
      else
        local emptyCol = Color3.fromRGB(38, 33, 36)
        if H.hasHex then rec.btn.ImageColor3 = emptyCol else rec.btn.BackgroundColor3 = emptyCol end
        rec.lock.Visible = false
        rec.face.Visible = false
        rec.thumb.Visible = false
        rec.init.Visible = false
        rec.lvl.Visible = false
        rec.ring.ImageTransparency = isSel and 0 or 1
        rec.ring.ImageColor3 = Color3.fromRGB(255, 255, 255)
      end
    end
  end
  H.metaWas = false
  local avg = total.bees > 0 and (total.lvl / total.bees) or 0
  local key = '<font color="#a6927c">'
  if H.sumText then
    H.sumText.Text = table.concat({
      key .. "Bees</font>   " .. total.bees .. " / 50",
      key .. "Gifted</font>   " .. total.gifted,
      key .. "Mutated</font>   " .. total.mutated,
      key .. "With beequip</font>   " .. total.equipped,
      key .. "Locked slots</font>   " .. math.max(0, 50 - slots),
    }, "\n")
  end
  ExtraUI.hiveDetail()
end


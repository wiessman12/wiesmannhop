  local TAB_N = 15
  local tabButtons = {}
  local function paintTabBtn(b, on, isIcon)
    if not b then return end
    if on then
      b.BackgroundTransparency = 0
      b.BackgroundColor3 = Color3.fromRGB(112, 30, 38)
      if not isIcon then
        b.TextColor3 = Theme.text
      end
    else
      b.BackgroundTransparency = 1
      b.BackgroundColor3 = Color3.fromRGB(28, 18, 22)
      if not isIcon then
        b.TextColor3 = Theme.muted
      end
    end
  end
  local function makeTab(text, index)
    local b = Instance.new("TextButton")
    b.Name = "Tab_" .. text
    b.Size = UDim2.new(1 / TAB_N, -4, 1, -4)
    b.Position = UDim2.new((index - 1) / TAB_N, 2, 0, 2)
    b.BackgroundColor3 = Color3.fromRGB(28, 18, 22)
    b.BackgroundTransparency = 1
    b.Text = text
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 12
    b.TextScaled = true -- many tabs: long names shrink to fit instead of overflowing
    local tsc = Instance.new("UITextSizeConstraint")
    tsc.MaxTextSize, tsc.MinTextSize = 12, 8
    tsc.Parent = b
    b.TextColor3 = Theme.muted
    b.TextStrokeTransparency = 1
    b.AutoButtonColor = false
    b.ZIndex = 24
    b.Parent = tabInset
    corner(b, 8)
    tabButtons[#tabButtons + 1] = { btn = b, key = nil, icon = false }
    return b
  end

  local function makeIconTab(filename, index)
    local b = Instance.new("ImageButton")
    b.Name = "ProfileTab"
    b.Size = UDim2.new(1 / TAB_N, -4, 1, -4)
    b.Position = UDim2.new((index - 1) / TAB_N, 2, 0, 2)

-- ================= SHORT NUMBERS (game's Honey + Honey/sec labels -> 2.93B) =================
ExtraUI.short = { track = {}, orig = {}, started = false }
ExtraUI.SHORT_SUF = { "K", "M", "B", "T", "Qd", "Qn", "Sx", "Sp", "Oc", "No", "Dc" }

ExtraUI.shortFmt = function(n)
  if type(n) ~= "number" or n < 1e6 then return nil end
  local suf = ExtraUI.SHORT_SUF
  local e = math.min(math.floor(math.log10(n) / 3), #suf)
  local v = n / 10 ^ (e * 3)
  if tonumber(string.format("%.2f", v)) >= 1000 and e < #suf then
    e = e + 1
    v = n / 10 ^ (e * 3)
  end
  local s = string.format("%.2f", v):gsub("0+$", "")
  s = s:gsub("%.$", "")
  return s .. suf[e]
end

-- returns the shortened text, or nil when the label is not a honey amount / honey-per-second text
ExtraUI.shortText = function(t)
  local pre, num, post = tostring(t):match("^([^%d]*)([%d,]+%.?%d*)([^%d]*)$")
  if not num then return nil end
  local isSec = post:find("/sec", 1, true) ~= nil
  if not isSec and not (pre == "" and post == "") then return nil end
  local v = tonumber((num:gsub(",", "")))
  local s = ExtraUI.shortFmt(v)
  if not s then return nil end
  return pre .. s .. post
end

ExtraUI.shortRewrite = function(l)
  if ExtraUI.vis.shortNums == false or not l.Parent then return end
  local cur = l.Text
  local new = ExtraUI.shortText(cur)
  if new and new ~= cur then
    ExtraUI.short.orig[l] = cur
    l.Text = new
  end
end

ExtraUI.shortTrack = function(l)
  local S = ExtraUI.short
  if S.track[l] then return end
  local c = l:GetPropertyChangedSignal("Text"):Connect(function()
    pcall(ExtraUI.shortRewrite, l)
  end)
  S.track[l] = c
  Session.track(c)
  pcall(ExtraUI.shortRewrite, l)
end

ExtraUI.shortClear = function()
  local S = ExtraUI.short
  for l, c in pairs(S.track) do
    pcall(function() c:Disconnect() end)
    local o = S.orig[l]
    if o and l.Parent then pcall(function() l.Text = o end) end
  end
  S.track, S.orig = {}, {}
end

ExtraUI.shortScan = function()
  local pg = player:FindFirstChildOfClass("PlayerGui")
  if not pg then return end
  local hl, pl
  local nums, secs = {}, {}
  local i = 0
  for _, d in ipairs(pg:GetDescendants()) do
    i = i + 1
    if i % 2000 == 0 then task.wait() end
    if d:IsA("TextLabel") and not d:IsDescendantOf(gui) then
      local t = d.Text
      local w = t:lower():match("^%s*(%a+)%s*$")
      if w == "honey" then
        hl = hl or d
      elseif w == "pollen" then
        pl = pl or d
      elseif t:find("/sec", 1, true) then
        secs[#secs + 1] = d
      elseif t:match("^[%d,]+$") then
        nums[#nums + 1] = d
      end
    end
  end
  for _, l in ipairs(secs) do ExtraUI.shortTrack(l) end
  if hl and pl then
    local up, n = {}, hl.Parent
    while n do up[n] = true n = n.Parent end
    local c = pl.Parent
    while c and not up[c] do c = c.Parent end
    if c then
      for _, l in ipairs(nums) do
        if l:IsDescendantOf(c) then ExtraUI.shortTrack(l) end
      end
    end
  end
end

ExtraUI.shortStart = function()
  local S = ExtraUI.short
  if S.started then return end
  S.started = true
  task.spawn(function()
    while Session.alive do
      if ExtraUI.vis.shortNums ~= false then
        -- whole-PlayerGui walk is heavy: once labels are tracked (text-changed signal does the work) rescan rarely
        local live = 0
        for l in pairs(S.track) do
          if l.Parent then live = live + 1 end
        end
        local gap = live > 0 and 45 or 15
        if os.clock() - (S.lastScan or 0) >= gap then
          S.lastScan = os.clock()
          pcall(ExtraUI.shortScan)
        end
      end
      task.wait(4)
    end
  end)
end


-- Original BSS night (measured from a Night Bell dump): only Lighting changes, in 39 linear steps (~0.123 s each):
--   ClockTime 14 -> 0.35 | Brightness 2.1 -> 0.0525 | FogStart 100 -> 490 | FogEnd 2000 -> 9800
-- On = smooth transition like the real bell, Off = instant day (no smooth return).
ExtraUI.Night = {
  on = false,
  gen = 0,
  steps = 39,
  stepTime = 0.123,
  day = { ClockTime = 13.65, Brightness = 2.0475, FogStart = 110, FogEnd = 2200 },
  night = { ClockTime = 0.35, Brightness = 0.0525, FogStart = 490, FogEnd = 9800 },
  saved = nil,
  hbConn = nil,
}

function ExtraUI.Night.put(t)
  local L = game:GetService("Lighting")
  pcall(function()
    L.ClockTime = t.ClockTime
    L.Brightness = t.Brightness
    L.FogStart = t.FogStart
    L.FogEnd = t.FogEnd
  end)
end

function ExtraUI.Night.stepVals(i)
  return {
    ClockTime = 14 - 0.35 * i,
    Brightness = 2.1 - 0.0525 * i,
    FogStart = 100 + 10 * i,
    FogEnd = 2000 + 200 * i,
  }
end

function ExtraUI.Night.hold()
  -- keep the night while it is on (the game / other scripts may reset Lighting)
  local N = ExtraUI.Night
  if N.hbConn then return end
  N.hbConn = RunService.Heartbeat:Connect(function()
    if not Session.alive or not N.on or N.animating then return end
    local L = game:GetService("Lighting")
    local n = N.night
    if math.abs(L.ClockTime - n.ClockTime) > 0.01 or math.abs(L.Brightness - n.Brightness) > 0.001
      or math.abs(L.FogEnd - n.FogEnd) > 1 or math.abs(L.FogStart - n.FogStart) > 1 then
      N.put(n)
    end
  end)
  Session.track(N.hbConn)
end

function ExtraUI.Night.set(on, instantOn)
  local N = ExtraUI.Night
  local L = game:GetService("Lighting")
  N.gen = N.gen + 1
  local myGen = N.gen
  N.on = on == true
  ExtraUI.vis.night = N.on
  if N.on then
    local s = { ClockTime = L.ClockTime, Brightness = L.Brightness, FogStart = L.FogStart, FogEnd = L.FogEnd }
    -- remember the current DAY only if it really is day (not already a real night)
    if s.ClockTime >= 6 and s.ClockTime <= 20 and s.FogEnd < 5000 then N.saved = s end
    N.hold()
    if instantOn then
      N.animating = false
      N.put(N.night)
      return
    end
    N.animating = true
    task.spawn(function()
      for i = 0, N.steps do
        if N.gen ~= myGen or not Session.alive or not N.on then return end
        N.put(N.stepVals(i))
        task.wait(N.stepTime)
      end
      if N.gen == myGen then
        N.animating = false
        N.put(N.night)
      end
    end)
  else
    N.animating = false
    -- instant return to day (no smooth fade back)
    N.put(N.saved or N.day)
  end
end

function ExtraUI.Night.start()
  local N = ExtraUI.Night
  if ExtraUI.vis.night == true then
    N.set(true, true)
  end
end

local StickBug = {
  drinkOn = false,
  tpOn = false,
  lastField = nil,
  lastTpAt = 0,
  lastDrinkAt = 0,
  status = "off",
  gen = 0,
  FIELDS = {
    "Sunflower Field",
    "Clover Field",
    "Strawberry Field",
    "Bamboo Field",
    "Pineapple Patch",
    "Cactus Field",
    "Pumpkin Patch",
    "Mountain Top Field",
  },
}

function StickBug.resolveField(raw)
  if type(raw) ~= "string" or raw == "" then return nil end
  raw = raw:gsub("^%s+", ""):gsub("%s+$", ""):gsub("%.$", "")
  local low = raw:lower()
  for i = 1, #StickBug.FIELDS do
    if StickBug.FIELDS[i]:lower() == low then
      return StickBug.FIELDS[i]
    end
  end
  for i = 1, #StickBug.FIELDS do
    local name = StickBug.FIELDS[i]
    local nl = name:lower()
    if low:find(nl, 1, true) or nl:find(low, 1, true) then
      return name
    end
  end
  return nil
end

function StickBug.guiVisible(obj)
  local n = obj
  while n do
    if n:IsA("GuiObject") and n.Visible == false then
      return false
    end
    if n:IsA("ScreenGui") and n.Enabled == false then
      return false
    end
    if n == player:FindFirstChild("PlayerGui") then
      break
    end
    n = n.Parent
  end
  local ok = true
  pcall(function()
    if obj:IsA("GuiObject") and (obj.AbsoluteSize.X < 2 or obj.AbsoluteSize.Y < 2) then
      ok = false
    end
  end)
  return ok
end

function StickBug.findTitleLabel()
  local pg = player:FindFirstChild("PlayerGui")
  if not pg then return nil end
  local cached = StickBug.titleLabel
  if cached and cached.Parent and tostring(cached.Text or ""):find("Stick Bug Challenge", 1, true) then
    return cached
  end
  StickBug.titleLabel = nil
  -- full PlayerGui walk is expensive: when the panel is absent only look again every 5s
  local nowT = os.clock()
  if nowT - (StickBug.titleTry or 0) < 5 then return nil end
  StickBug.titleTry = nowT
  local n = 0
  for _, d in ipairs(pg:GetDescendants()) do
    n = n + 1
    if n % 1500 == 0 then task.wait() end
    if (d:IsA("TextLabel") or d:IsA("TextButton")) and tostring(d.Text or ""):find("Stick Bug Challenge", 1, true) then
      StickBug.titleLabel = d
      return d
    end
  end
  return nil
end

function StickBug.panelLive()
  local title = StickBug.findTitleLabel()
  if not title then return false end
  return StickBug.guiVisible(title)
end

function StickBug.panelLabels()
  local title = StickBug.findTitleLabel()
  if not title or not StickBug.guiVisible(title) then
    return nil
  end
  local root = title.Parent
  for _ = 1, 5 do
    if not root or root:IsA("ScreenGui") or root == player:FindFirstChild("PlayerGui") then
      break
    end
    local n = 0
    for _, d in ipairs(root:GetDescendants()) do
      if d:IsA("TextLabel") or d:IsA("TextButton") then
        n = n + 1
      end
    end
    if n >= 3 then
      break
    end
    root = root.Parent
  end
  if not root then
    root = title.Parent
  end
  StickBug.panelCache = root
  local list = root:GetDescendants()
  list[#list + 1] = root
  list[#list + 1] = title
  return list
end

function StickBug.parseScoreText(raw)
  if type(raw) ~= "string" or raw == "" then return nil end
  raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
  local n = parseHoneyString(raw)
  if n and n > 0 then return n end
  n = tonumber((raw:gsub(",", ""):gsub("%s+", "")))
  if n and n > 0 then return n end
  return nil
end

function StickBug.readField()
  local list = StickBug.panelLabels()
  if not list then return nil end
  local best
  for i = 1, #list do
    local d = list[i]
    if d:IsA("TextLabel") or d:IsA("TextButton") then
      local t = tostring(d.Text or "")
      if t ~= "" then
        local field = t:match("[Ll]vl%s*%d+%s+at%s+(.+)")
          or t:match("at%s+([%w%s]+Field)")
          or t:match("at%s+([%w%s]+Patch)")
        if field then
          best = StickBug.resolveField(field)
          if best then return best end
        end
        local headed = t:match("[Hh]eaded to the%s+(.+)!")
        if headed then
          best = StickBug.resolveField(headed) or best
        end
      end
    end
  end
  return best
end

function StickBug.readScore()
  local list = StickBug.panelLabels()
  if not list then return nil end
  for i = 1, #list do
    local d = list[i]
    if d:IsA("TextLabel") or d:IsA("TextButton") then
      local t = tostring(d.Text or "")
      local raw = t:match("[Ss]core%s*:?%s*([%d%.,]+%s*[A-Za-z]*)")
        or t:match("[Ss]core%s+([%d%.,]+%s*[A-Za-z]*)")
      if raw then
        local n = StickBug.parseScoreText(raw)
        if n then return n end
      end
    end
  end
  for i = 1, #list do
    local d = list[i]
    if (d:IsA("TextLabel") or d:IsA("TextButton")) and tostring(d.Text or ""):lower():find("score", 1, true) then
      local parent = d.Parent
      if parent then
        for _, sib in ipairs(parent:GetDescendants()) do
          if sib:IsA("TextLabel") or sib:IsA("TextButton") then
            local n = StickBug.parseScoreText(tostring(sib.Text or ""))
            if n and n >= 100 then return n end
          end
        end
      end
    end
  end
  -- bare abbreviated number on panel (e.g. 25.6M)
  for i = 1, #list do
    local d = list[i]
    if d:IsA("TextLabel") or d:IsA("TextButton") then
      local t = tostring(d.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
      if t:match("^[%d%.,]+%s*[A-Za-z]+$") or t:match("^[%d,]+$") then
        local n = StickBug.parseScoreText(t)
        if n and n >= 1000 then return n end
      end
    end
  end
  return nil
end

function StickBug.readLevelField()
  local list = StickBug.panelLabels()
  if not list then return nil, nil end
  local bestLvl, bestField
  for i = 1, #list do
    local d = list[i]
    if d:IsA("TextLabel") or d:IsA("TextButton") then
      local t = tostring(d.Text or ""):gsub(string.char(194, 160), " ")
      local lvl, field = t:match("[Ll]vl%.?%s*(%d+)%s+at%s+(.+)")
      if not lvl then
        lvl, field = t:match("[Ll]evel%s*(%d+)%s+at%s+(.+)")
      end
      if not lvl then
        lvl = t:match("[Ll]vl%.?%s*(%d+)") or t:match("[Ll]evel%s*(%d+)") or t:match("LV%.?%s*(%d+)")
      end
      local n = tonumber(lvl)
      if n and n > 0 and n < 100 then
        if not bestLvl or n > bestLvl then
          bestLvl = n
          if field then
            bestField = StickBug.resolveField(field) or bestField
          end
        end
      end
    end
  end
  return bestLvl, bestField or StickBug.readField()
end

function StickBug.readTimerSec()
  local list = StickBug.panelLabels()
  if not list then return nil end
  local best
  for i = 1, #list do
    local d = list[i]
    if d:IsA("TextLabel") or d:IsA("TextButton") then
      local t = tostring(d.Text or "")
      local m, s = t:match("^(%d+):(%d%d)$")
      if not m then
        m, s = t:match("(%d+):(%d%d)")
      end
      if m and s then
        local mm, ss = tonumber(m), tonumber(s)
        if mm and ss and mm <= 15 and ss < 60 then
          local sec = mm * 60 + ss
          if not best or sec < best then
            best = sec
          end
        end
      end
    end
  end
  return best
end

function StickBug.resetChallengeState()
  StickBug.inChallenge = false
  StickBug.sawPanel = false
  StickBug.sawLiveTimer = false
  StickBug.prevLvl = nil
  StickBug.prevField = nil
  StickBug.lastTimer = nil
  StickBug.maxTimerSeen = nil
  StickBug.joinedAtTimer = nil
  StickBug.pendingFinal = false
  StickBug.finishing = false
  StickBug.titleLabel = nil
  StickBug.panelCache = nil
  -- keep peakScore/peakLvl/runId/finalSent/lockUntil until fire + lock expire
end

-- Allow finish for late inject (script loaded mid-challenge), still ignore flicker.
function StickBug.canFinish()
  if not StickBug.sawLiveTimer then return false end
  local watched = StickBug.challengeAt and (os.clock() - StickBug.challengeAt) or 0
  local maxT = StickBug.maxTimerSeen or 0
  local joinedAt = StickBug.joinedAtTimer or maxT
  if joinedAt >= 20 then return true end
  if maxT >= 45 then return true end
  if watched >= 20 then return true end
  return watched >= 10 and maxT >= 8
end

function StickBug.snapshotStats()
  pcall(function()
    local s = StickBug.readScoreAnywhere and StickBug.readScoreAnywhere() or StickBug.readScore()
    if s then
      StickBug.lastScore = s
      if not StickBug.peakScore or s > StickBug.peakScore then
        StickBug.peakScore = s
      end
      if StickBug.inChallenge and StickBug.sawLiveTimer then
        StickBug.scoreLiveSeen = true
      end
    end
    local lvl = StickBug.readLevelField()
    if type(lvl) == "number" then
      StickBug.prevLvl = lvl
      if not StickBug.peakLvl or lvl > StickBug.peakLvl then
        StickBug.peakLvl = lvl
      end
    end
  end)
end

-- Panel score + any "Score / Final score / Your score" popup in PlayerGui (post-clear).
function StickBug.readScoreAnywhere()
  local best = StickBug.readScore()
  local pg = player:FindFirstChild("PlayerGui")
  if not pg then return best end
  pcall(function()
    for _, d in ipairs(pg:GetDescendants()) do
      if d:IsA("TextLabel") or d:IsA("TextButton") then
        local t = tostring(d.Text or "")
        if t ~= "" then
          local raw = t:match("[Ff]inal%s+[Ss]core%s*:?%s*([%d%.,]+%s*[A-Za-z]*)")
            or t:match("[Yy]our%s+[Ss]core%s*:?%s*([%d%.,]+%s*[A-Za-z]*)")
            or t:match("[Tt]otal%s+[Ss]core%s*:?%s*([%d%.,]+%s*[A-Za-z]*)")
            or t:match("[Ss]core%s*:?%s*([%d%.,]+%s*[A-Za-z]*)")
          if raw then
            local n = StickBug.parseScoreText(raw)
            if n and (not best or n > best) then
              best = n
            end
          end
        end
      end
    end
  end)
  return best
end

-- Exactly one Discord post per challenge runId. Retries if HTTP fails.
function StickBug.fireFinal()
  if StickBug.finalSent then return true end
  local final = StickBug.peakScore or StickBug.lastScore
  if type(final) ~= "number" or final <= 0 then
    return false
  end
  if not StickBug.canFinish() then
    return false
  end
  -- Need a score sampled while the challenge was actually live (blocks stale UI ghosts).
  if not StickBug.scoreLiveSeen and not StickBug.sawLiveTimer then
    return false
  end
  local runId = StickBug.runId
  if type(runId) ~= "string" or runId == "" then
    runId = tostring(player.UserId) .. "_" .. tostring(math.floor(StickBug.challengeAt or os.clock()))
    StickBug.runId = runId
  end
  local key = "stick_run_" .. runId
  if Webhook.sent[key] then
    StickBug.finalSent = true
    StickBug.lockUntil = os.clock() + 480
    return true
  end
  -- Anti-spam: same score within ~25 min (re-inject / end-screen flicker) → skip.
  local scoreKey = "stick_score_" .. tostring(player.UserId) .. "_" .. tostring(math.floor(final + 0.5))
  local lastAt = Webhook.sentAt and Webhook.sentAt[scoreKey]
  if Webhook.sent[scoreKey] and type(lastAt) == "number" and (os.clock() - lastAt) < 1500 then
    StickBug.finalSent = true
    StickBug.lockUntil = os.clock() + 480
    return true
  end
  local maxLvl = StickBug.peakLvl or StickBug.prevLvl
  local fields = {
    { name = "Final score", value = "**" .. Webhook.fmtNum(final) .. "**", inline = true },
    { name = "Max level", value = maxLvl and ("**Lvl " .. tostring(maxLvl) .. "**") or "—", inline = true },
    { name = "Duration", value = "**10 min**", inline = true },
  }
  local ok = Webhook.post(
    "Stick Bug Challenge · final score",
    "**" .. player.Name .. "** finished Stick Bug Challenge.",
    Webhook.COLOR,
    {
      thumbnail = Webhook.IMG_STICK_AMULET,
      fields = fields,
      author = {
        name = player.Name,
        icon_url = Webhook.IMG_STICK_AMULET,
      },
    }
  )
  if ok then
    Webhook.sent[key] = true
    Webhook.sent[scoreKey] = true
    Webhook.sentAt = Webhook.sentAt or {}
    Webhook.sentAt[scoreKey] = os.clock()
    StickBug.finalSent = true
    StickBug.lockUntil = os.clock() + 480
    StickBug.peakScore = nil
    StickBug.lastScore = nil
    return true
  end
  return false
end

-- Wait for BSS to register the real end score (bar updates after 0:00), then post once.
function StickBug.finishChallenge()
  if StickBug.finalSent or StickBug.finishing then return end
  if not StickBug.canFinish() then return end
  StickBug.finishing = true
  StickBug.pendingFinal = true
  local runId = StickBug.runId
  local challengeAt = StickBug.challengeAt
  local maxT = StickBug.maxTimerSeen
  local joinedAt = StickBug.joinedAtTimer
  local sawLive = StickBug.sawLiveTimer
  task.spawn(function()
    local stable, hits = nil, 0
    local t0 = os.clock()
    while Session.alive and (os.clock() - t0) < 7 do
      StickBug.runId = runId
      StickBug.challengeAt = challengeAt
      StickBug.maxTimerSeen = maxT
      StickBug.joinedAtTimer = joinedAt
      StickBug.sawLiveTimer = sawLive
      StickBug.snapshotStats()
      local s = StickBug.readScoreAnywhere()
      if s then
        StickBug.lastScore = s
        if not StickBug.peakScore or s > StickBug.peakScore then
          StickBug.peakScore = s
        end
        if stable == s then
          hits = hits + 1
        else
          stable = s
          hits = 1
        end
      end
      -- after 2.5s of settle, if score stopped changing ≈1.2s, take it
      if (os.clock() - t0) >= 2.5 and hits >= 3 then
        break
      end
      task.wait(0.4)
    end
    StickBug.runId = runId
    StickBug.challengeAt = challengeAt
    StickBug.maxTimerSeen = maxT
    StickBug.joinedAtTimer = joinedAt
    StickBug.sawLiveTimer = true
    for _ = 1, 8 do
      if not Session.alive then return end
      if StickBug.fireFinal() then
        StickBug.resetChallengeState()
        return
      end
      task.wait(0.7)
      StickBug.snapshotStats()
    end
    StickBug.finishing = false
  end)
end

function StickBug.checkWebhook()
  if StickBug.lockUntil and os.clock() < StickBug.lockUntil then
    return
  end
  if StickBug.finalSent or StickBug.finishing then
    return
  end
  local live = StickBug.panelLive()
  local timer = live and StickBug.readTimerSec() or nil
  if live then
    -- Only START a run while the challenge is actually running (timer > 5s).
    -- 0:00 / end screen must never open a second run.
    -- Late inject OK: joining with 30s left still starts tracking.
    if not StickBug.inChallenge then
      if type(timer) ~= "number" or timer < 5 then
        return
      end
      -- Still in post-fire lock → ignore ghost panels / re-open spam
      if StickBug.lockUntil and os.clock() < StickBug.lockUntil then
        return
      end
      StickBug.inChallenge = true
      StickBug.finalSent = false
      StickBug.pendingFinal = false
      StickBug.finishing = false
      StickBug.sawLiveTimer = false
      StickBug.scoreLiveSeen = false
      StickBug.peakScore = nil
      StickBug.peakLvl = nil
      StickBug.prevLvl = nil
      StickBug.lastScore = nil
      StickBug.challengeAt = os.clock()
      StickBug.joinedAtTimer = timer
      StickBug.maxTimerSeen = timer
      StickBug.runId = tostring(player.UserId) .. "_" .. tostring(math.floor(os.clock() * 1000))
    end
    StickBug.sawPanel = true
    if type(timer) == "number" then
      StickBug.lastTimer = timer
      if not StickBug.maxTimerSeen or timer > StickBug.maxTimerSeen then
        StickBug.maxTimerSeen = timer
      end
      if timer > 1 then
        StickBug.sawLiveTimer = true
      end
    end
    -- Snapshot only while timer is live (avoids freezing end-screen leftovers as a "new" score)
    if type(timer) == "number" and timer > 0 then
      StickBug.snapshotStats()
    end
    if type(timer) == "number" and timer <= 0 and StickBug.sawLiveTimer then
      StickBug.finishChallenge()
    end
    if StickBug.challengeAt and (os.clock() - StickBug.challengeAt) >= 605 and StickBug.sawLiveTimer then
      StickBug.finishChallenge()
    end
  elseif StickBug.inChallenge then
    if StickBug.canFinish() then
      StickBug.finishChallenge()
    elseif StickBug.challengeAt and (os.clock() - StickBug.challengeAt) < 8 and (StickBug.maxTimerSeen or 0) < 15 then
      -- brief panel flicker at start — ignore
      StickBug.resetChallengeState()
    end
  end
end

function StickBug.zonePart(fieldName)
  local zones = Workspace:FindFirstChild("FlowerZones")
  if not zones then return nil end
  local zone = zones:FindFirstChild(fieldName)
  if not zone then
    for _, ch in ipairs(zones:GetChildren()) do
      if StickBug.resolveField(ch.Name) == fieldName then
        zone = ch
        break
      end
    end
  end
  return zone
end

function StickBug.teleport(fieldName)
  local zone = StickBug.zonePart(fieldName)
  local char = player.Character
  local root = char and char:FindFirstChild("HumanoidRootPart")
  if not zone or not root then return false end
  local pos
  if zone:IsA("BasePart") then
    pos = zone.Position
  else
    local ok, cf = pcall(function()
      return zone:GetPivot()
    end)
    if ok and cf then
      pos = cf.Position
    else
      local pp = zone:FindFirstChildWhichIsA("BasePart", true)
      pos = pp and pp.Position
    end
  end
  if not pos then return false end
  pcall(function()
    root.CFrame = CFrame.new(pos + Vector3.new(0, 6, 0))
  end)
  StickBug.lastField = fieldName
  StickBug.lastTpAt = os.clock()
  return true
end

function StickBug.hasBuff(word)
  local want = tostring(word):lower()
  for src, b in pairs(Buffs) do
    if type(src) == "string" and type(b) == "table" and src:lower():find(want, 1, true) then
      local left = buffLeft(src)
      if left == nil or left > 20 then
        return true
      end
    end
  end
  return false
end

function StickBug.ensureDrinks()
  local now = os.clock()
  if now - (StickBug.lastDrinkAt or 0) < 4 then return end
  local used = false
  if not StickBug.hasBuff("oil") then
    if ExtraUI.useItem("Oil") then used = true end
  end
  if not StickBug.hasBuff("tropical") then
    if ExtraUI.useItem("Tropical Drink") then used = true end
  end
  if used then StickBug.lastDrinkAt = now end
end

function StickBug.setStatus(text)
  StickBug.status = text
  if ExtraUI.stickStatus then
    ExtraUI.stickStatus.Text = text
  end
end

function StickBug.tick()
  if StickBug.drinkOn then
    StickBug.ensureDrinks()
  end
  -- webhook polling is only in StickBug.start score loop (avoids double finish)
  if StickBug.tpOn then
    local field = StickBug.readField()
    if field then
      local score = StickBug.lastScore
      local tip = score and (" · score " .. Webhook.fmtNum(score)) or ""
      StickBug.setStatus("Stick Bug @ " .. field .. tip)
      local now = os.clock()
      StickBug.noFieldSince = nil
      -- teleport ONCE per field: only when the Stick Bug moved to a different field (failed tries retry every 2s)
      if field ~= StickBug.lastField and now - (StickBug.tpTryAt or 0) >= 2 then
        StickBug.tpTryAt = now
        if StickBug.teleport(field) then
          StickBug.setStatus("TP → " .. field)
        else
          StickBug.setStatus("TP failed: " .. field)
        end
      end
    else
      -- panel gone for a while = challenge over: the next Stick Bug round teleports again
      local now = os.clock()
      StickBug.noFieldSince = StickBug.noFieldSince or now
      if now - StickBug.noFieldSince > 15 then StickBug.lastField = nil end
      StickBug.setStatus("waiting for Stick Bug panel…")
    end
  elseif StickBug.drinkOn then
    StickBug.setStatus("oil + tropical on")
  else
    StickBug.setStatus("off")
  end
end

function StickBug.setDrink(on)
  StickBug.drinkOn = on == true
  ExtraUI.vis.stickDrink = StickBug.drinkOn
  StickBug.ensureLoop()
end

function StickBug.setTp(on)
  StickBug.tpOn = on == true
  ExtraUI.vis.stickTp = StickBug.tpOn
  if not StickBug.tpOn then
    StickBug.lastField = nil
  end
  StickBug.ensureLoop()
end

function StickBug.ensureLoop()
  if not StickBug.drinkOn and not StickBug.tpOn then
    StickBug.gen = (StickBug.gen or 0) + 1
    StickBug.setStatus("off")
    return
  end
  if StickBug.running then return end
  StickBug.running = true
  StickBug.gen = (StickBug.gen or 0) + 1
  local gen = StickBug.gen
  task.spawn(function()
    while Session.alive and StickBug.gen == gen and (StickBug.drinkOn or StickBug.tpOn) do
      pcall(StickBug.tick)
      task.wait(1)
    end
    StickBug.running = false
  end)
end

function StickBug.start()
  -- always start OFF after inject: the toggles are built before this runs and show "off", so a saved "on"
  -- used to silently burn Oil / Tropical Drink (and teleport) while the switch looked disabled
  StickBug.drinkOn = false
  StickBug.tpOn = false
  ExtraUI.vis.stickDrink = false
  ExtraUI.vis.stickTp = false
  -- poll score/timer; faster while challenge UI is live
  StickBug.scoreGen = (StickBug.scoreGen or 0) + 1
  local gen = StickBug.scoreGen
  task.spawn(function()
    while Session.alive and StickBug.scoreGen == gen do
      pcall(StickBug.checkWebhook)
      task.wait(StickBug.inChallenge and 0.75 or 2)
    end
  end)
  if StickBug.drinkOn or StickBug.tpOn then
    StickBug.ensureLoop()
  end
end


-- ================= WHITE tab: screen (camera) alignment on hot keys =================
-- Default keys: "<" (Comma) turns the view left, ">" (Period) turns it right; both are re-bindable in the tab.
-- Snap mode: every press goes to the NEXT multiple of the step (so the view ends up aligned to the grid, e.g. 0/45/90 deg);
-- Rotate mode: every press turns by exactly one step. The turn is eased over a few frames and applied after the
-- default camera script (RenderStepped), around the character.
ExtraUI.White = {
  on = true, left = "Comma", right = "Period", step = 45, snap = true, pending = 0,
  file = "BuffTools_white.json", listening = nil, steps = { 15, 30, 45, 90 },
}
ExtraUI.White.keyText = function(name)
  if name == "Comma" then return "<   ( , )" end
  if name == "Period" then return ">   ( . )" end
  return tostring(name)
end
ExtraUI.White.save = function()
  if not canSave then return end
  local W = ExtraUI.White
  pcall(function()
    writefile(W.file, HttpService:JSONEncode({ on = W.on, left = W.left, right = W.right, step = W.step, snap = W.snap }))
  end)
end
ExtraUI.White.load = function()
  if not canSave then return end
  local W = ExtraUI.White
  local ok, v = pcall(function()
    if isfile(W.file) then return HttpService:JSONDecode(readfile(W.file)) end
  end)
  if ok and type(v) == "table" then
    if type(v.on) == "boolean" then W.on = v.on end
    if type(v.snap) == "boolean" then W.snap = v.snap end
    if tonumber(v.step) then W.step = math.clamp(tonumber(v.step), 5, 180) end
    for _, side in ipairs({ "left", "right" }) do
      if type(v[side]) == "string" and pcall(function() return Enum.KeyCode[v[side]] end) and Enum.KeyCode[v[side]] then
        W[side] = v[side]
      end
    end
  end
end
ExtraUI.White.load()
ExtraUI.White.yaw = function()
  local cam = Workspace.CurrentCamera
  if not cam then return nil end
  local look = cam.CFrame.LookVector
  return math.atan2(-look.X, -look.Z)
end
-- dir = +1: the view turns left, -1: right
ExtraUI.White.turn = function(dir)
  local W = ExtraUI.White
  local yaw = W.yaw()
  if not yaw then return end
  local s = math.rad(W.step)
  local delta
  if W.snap then
    local k = yaw / s
    local r = math.floor(k + 0.5)
    local aligned = math.abs(k - r) < 0.03
    local tk
    if dir > 0 then tk = aligned and (r + 1) or math.ceil(k) else tk = aligned and (r - 1) or math.floor(k) end
    delta = tk * s - yaw
  else
    delta = dir * s
  end
  W.target = yaw + delta
  W.hold = 5 -- keep forcing the exact target for a few frames (the camera script / game may fight back)
  W.apply(delta) -- instant, like Roblox's own snap: no easing
end
-- rotate the real camera around the character's vertical axis (same thing the default camera script does with the mouse)
ExtraUI.White.apply = function(delta)
  local cam = Workspace.CurrentCamera
  if not cam or math.abs(delta) < 1e-4 then return end
  local ch = player.Character
  local root = ch and ch:FindFirstChild("HumanoidRootPart")
  local f = root and root.Position or cam.Focus.Position
  local cf = CFrame.new(f.X, 0, f.Z) * CFrame.Angles(0, delta, 0) * CFrame.new(-f.X, 0, -f.Z) * cam.CFrame
  cam.CFrame = cf
end
do
  local stepName = "BT_WhiteAlign"
  pcall(function() RunService:UnbindFromRenderStep(stepName) end)
  -- after the default camera script (RenderPriority.Camera = 200): re-assert the target yaw for the first frames
  RunService:BindToRenderStep(stepName, Enum.RenderPriority.Camera.Value + 1, function()
    local W = ExtraUI.White
    if (W.hold or 0) <= 0 or not W.target then return end
    W.hold = W.hold - 1
    local y = W.yaw()
    if not y then return end
    local d = W.target - y
    d = (d + math.pi) % (2 * math.pi) - math.pi
    if math.abs(d) > 0.004 then W.apply(d) end
  end)
  Session.track({ Disconnect = function() pcall(function() RunService:UnbindFromRenderStep(stepName) end) end })
end
Session.track(UIS.InputBegan:Connect(function(input, gp)
  local W = ExtraUI.White
  if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
  if W.listening then
    local cb = W.listening
    W.listening = nil
    pcall(cb, input.KeyCode)
    return
  end
  if gp or not W.on then return end
  local nm = input.KeyCode.Name
  if nm == W.left then W.turn(1) elseif nm == W.right then W.turn(-1) end
end))


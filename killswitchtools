-- Reload: re-runs a LOCAL copy of this script (nothing is downloaded). Save the file as
-- workspace/BuffTools/BuffTools_clean.lua, or set getgenv().BuffToolsPath = "<path inside workspace>" before running.
-- Without a saved copy the button does nothing, so you never lose a running HUD by accident.
Session.reload = function()
  local path = (Session.env and Session.env.BuffToolsPath) or "BuffTools/BuffTools_clean.lua"
  local code
  pcall(function()
    if type(isfile) == "function" and type(readfile) == "function" and isfile(path) then
      code = readfile(path)
    end
  end)
  if type(code) ~= "string" or #code < 50 then
    print("[BuffTools] reload: no local copy at " .. tostring(path) .. " - script left running")
    return
  end
  Session.unload()
  task.defer(function()
    local fn
    pcall(function() fn = loadstring(code) end)
    if not fn then
      pcall(function()
        if type(load) == "function" then fn = load(code) end
      end)
    end
    if fn then task.spawn(fn) end
  end)
end


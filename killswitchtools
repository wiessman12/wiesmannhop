-- ================= ANTI-LAG (FPS tab) =================
-- Client side only: the server keeps the full world, we only stop rendering it.
--   antiTex     delete every Decal/Texture (one way, rejoin to get them back;
--               field-ball decals stay, the token ESP reads them)
--   antiBee     hide the bee swarm (Workspace.Bees / NPCBees), trails and particles
--   antiBalls   delete hive balloons (Workspace.Balloons). Tokens in Collectibles stay.
--   antiPlayers hide the other players, on this client only
-- Lives on ExtraUI: the main chunk is close to Luau's register limit.
ExtraUI.AntiLag = {
  on = { tex = false, bee = false, balls = false, players = false },
  conns = { tex = {}, bee = {}, balls = {}, players = {} },
  hooked = setmetatable({}, { __mode = "k" }),
  emitters = setmetatable({}, { __mode = "k" }),
  parts = setmetatable({}, { __mode = "k" }),
  chars = setmetatable({}, { __mode = "k" }),
}

ExtraUI.AntiLag.ours = function(inst)
  local p = inst
  for _ = 1, 6 do
    if not p then return false end
    if p.Name == "BuffToolsBeams" or p.Name == "BuffToolsMapStore" or p.Name == "BuffToolsVoid" then
      return true
    end
    p = p.Parent
  end
  return false
end

ExtraUI.AntiLag.drop = function(key)
  local list = ExtraUI.AntiLag.conns[key]
  if not list then return end
  for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
  ExtraUI.AntiLag.conns[key] = {}
end

ExtraUI.AntiLag.applyTex = function(on)
  on = on == true
  ExtraUI.AntiLag.on.tex = on
  ExtraUI.AntiLag.drop("tex")
  if not on then return end
  local col = Workspace:FindFirstChild("Collectibles")
  pcall(function()
    for _, d in ipairs(Workspace:GetDescendants()) do
      if (d:IsA("Decal") or d:IsA("Texture")) and not ExtraUI.AntiLag.ours(d) then
        if not (col and d:IsDescendantOf(col)) then pcall(function() d:Destroy() end) end
      end
    end
  end)
  table.insert(ExtraUI.AntiLag.conns.tex, Session.track(Workspace.DescendantAdded:Connect(function(d)
    if not (d:IsA("Decal") or d:IsA("Texture")) or ExtraUI.AntiLag.ours(d) then return end
    local c2 = Workspace:FindFirstChild("Collectibles")
    if c2 and d:IsDescendantOf(c2) then return end
    pcall(function() d:Destroy() end)
  end)))
end

ExtraUI.AntiLag.hideBee = function(inst, on)
  if not inst then return end
  pcall(function()
    if inst:IsA("BasePart") then inst.LocalTransparencyModifier = on and 1 or 0 end
  end)
  for _, d in ipairs(inst:GetDescendants()) do
    if d:IsA("BasePart") then
      pcall(function() d.LocalTransparencyModifier = on and 1 or 0 end)
    elseif d:IsA("Trail") or d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("PointLight") then
      pcall(function()
        if on then
          if ExtraUI.AntiLag.emitters[d] == nil then ExtraUI.AntiLag.emitters[d] = d.Enabled end
          d.Enabled = false
        else
          local was = ExtraUI.AntiLag.emitters[d]
          if was ~= nil then
            d.Enabled = was
            ExtraUI.AntiLag.emitters[d] = nil
          end
        end
      end)
    end
  end
end

ExtraUI.AntiLag.hookBeeFolder = function(f)
  if ExtraUI.AntiLag.hooked[f] then return end
  ExtraUI.AntiLag.hooked[f] = true
  for _, c in ipairs(f:GetChildren()) do ExtraUI.AntiLag.hideBee(c, true) end
  table.insert(ExtraUI.AntiLag.conns.bee, Session.track(f.ChildAdded:Connect(function(c)
    ExtraUI.AntiLag.hideBee(c, true)
  end)))
end

ExtraUI.AntiLag.applyBee = function(on)
  on = on == true
  ExtraUI.AntiLag.on.bee = on
  ExtraUI.AntiLag.drop("bee")
  if on then
    for _, nm in ipairs({ "Bees", "NPCBees" }) do
      local f = Workspace:FindFirstChild(nm)
      if f then ExtraUI.AntiLag.hookBeeFolder(f) end
    end
    table.insert(ExtraUI.AntiLag.conns.bee, Session.track(Workspace.ChildAdded:Connect(function(c)
      if ExtraUI.AntiLag.on.bee and (c.Name == "Bees" or c.Name == "NPCBees") then
        ExtraUI.AntiLag.hookBeeFolder(c)
      end
    end)))
  else
    for _, nm in ipairs({ "Bees", "NPCBees" }) do
      local f = Workspace:FindFirstChild(nm)
      if f then
        ExtraUI.AntiLag.hooked[f] = nil
        for _, c in ipairs(f:GetChildren()) do ExtraUI.AntiLag.hideBee(c, false) end
      end
    end
  end
end

ExtraUI.AntiLag.applyBalls = function(on)
  on = on == true
  ExtraUI.AntiLag.on.balls = on
  ExtraUI.AntiLag.drop("balls")
  local watched = ExtraUI.AntiLag.ballFolders
  if watched then
    for f in pairs(watched) do ExtraUI.AntiLag.hooked[f] = nil end
  end
  ExtraUI.AntiLag.ballFolders = setmetatable({}, { __mode = "k" })
  if not on then return end
  -- Workspace.Balloons only. Collectibles (field tokens) are left alone.
  -- Folders such as HiveBalloons stay, so new balloons can still be caught.
  local function watch(folder)
    if not folder or not folder.Parent then return end
    if not ExtraUI.AntiLag.hooked[folder] then
      ExtraUI.AntiLag.hooked[folder] = true
      ExtraUI.AntiLag.ballFolders[folder] = true
      table.insert(ExtraUI.AntiLag.conns.balls, Session.track(folder.ChildAdded:Connect(function(k)
        if not ExtraUI.AntiLag.on.balls then return end
        if k:IsA("Folder") then watch(k) else pcall(function() k:Destroy() end) end
      end)))
    end
    for _, c in ipairs(folder:GetChildren()) do
      if c:IsA("Folder") then watch(c) else pcall(function() c:Destroy() end) end
    end
  end
  local root = Workspace:FindFirstChild("Balloons")
  if root then watch(root) end
  table.insert(ExtraUI.AntiLag.conns.balls, Session.track(Workspace.ChildAdded:Connect(function(c)
    if ExtraUI.AntiLag.on.balls and c.Name == "Balloons" then watch(c) end
  end)))
end

ExtraUI.AntiLag.hideChar = function(plr, on)
  local char = plr and plr.Character
  if not char then return end
  if on then ExtraUI.AntiLag.chars[plr] = char end
  for _, d in ipairs(char:GetDescendants()) do
    if d:IsA("BasePart") then
      pcall(function()
        if on then
          if ExtraUI.AntiLag.parts[d] == nil then ExtraUI.AntiLag.parts[d] = d.LocalTransparencyModifier end
          d.LocalTransparencyModifier = 1
        else
          local was = ExtraUI.AntiLag.parts[d]
          if was ~= nil then
            d.LocalTransparencyModifier = was
            ExtraUI.AntiLag.parts[d] = nil
          end
        end
      end)
    end
  end
end

ExtraUI.AntiLag.applyPlayers = function(on)
  on = on == true
  ExtraUI.AntiLag.on.players = on
  ExtraUI.AntiLag.drop("players")
  if on then
    for _, o in ipairs(Players:GetPlayers()) do
      if o ~= player then
        ExtraUI.AntiLag.hideChar(o, true)
        table.insert(ExtraUI.AntiLag.conns.players, Session.track(o.CharacterAdded:Connect(function()
          ExtraUI.AntiLag.hideChar(o, true)
        end)))
      end
    end
    table.insert(ExtraUI.AntiLag.conns.players, Session.track(Players.PlayerAdded:Connect(function(o)
      if not ExtraUI.AntiLag.on.players then return end
      ExtraUI.AntiLag.hideChar(o, true)
      table.insert(ExtraUI.AntiLag.conns.players, Session.track(o.CharacterAdded:Connect(function()
        ExtraUI.AntiLag.hideChar(o, true)
      end)))
    end)))
  else

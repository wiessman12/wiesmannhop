ExtraUI.scan = function()
  -- hotbar tiles rarely change: re-walk PlayerActivesGui only every few seconds (or when a cached tile died)
  do
    local nowS = os.clock()
    local sl = ExtraUI.slots
    local has = sl ~= nil and next(sl) ~= nil
    if sl and (nowS - (ExtraUI.scanWalkAt or 0)) < (has and 3 or 1.5) then
      local alive = true
      for _, t in pairs(sl) do
        if not t.Parent then alive = false break end
      end
      if alive then return end
    end
    ExtraUI.scanWalkAt = nowS
  end
  if not ExtraUI.slots then ExtraUI.slots = {} end
  for k in pairs(ExtraUI.slots) do
    ExtraUI.slots[k] = nil
  end
  local pg = player:FindFirstChild("PlayerGui")
  if not pg then return end
  local pag = cachedPag
  if not pag or not pag.Parent then
    local sg = pg:FindFirstChild("ScreenGui")
    pag = sg and sg:FindFirstChild("PlayerActivesGui")
    cachedPag = pag
  end
  if not pag then
    pag = pg:FindFirstChild("PlayerActivesGui", true)
    cachedPag = pag
  end
  if not pag then return end
  for _, d in ipairs(pag:GetDescendants()) do
    if d:IsA("TextLabel") and string.lower(d.Name) == "texthotkey" then
      local n = tonumber(tostring(d.Text or ""):match("%d+"))
      if n and n >= 1 and n <= 9 then
        local tile = d.Parent or d
        local bestArea = math.huge
        local p = d
        while p and p ~= pag do
          if p.Name == "ProtoTile" and p:IsA("GuiObject") then
            tile = p
            bestArea = 0
            break
          end
          if p:IsA("GuiObject") then
            local s = p.AbsoluteSize
            local w, h = s.X, s.Y
            if w >= 52 and h >= 52 and w <= 110 and h <= w * 1.25 then
              local area = w * h
              if area < bestArea then
                tile = p
                bestArea = area
              end
            end
          end
          p = p.Parent
        end
        ExtraUI.slots[n] = tile
        local item = ExtraUI.auto["s" .. n]
        if item then item.slot = tile end
      end
    end
  end
end


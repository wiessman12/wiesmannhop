ExtraUI.hive = { grid = {}, cells = {}, info = {}, mut = {}, sel = nil, page = nil, hasHex = false }

ExtraUI.hiveHex = function(c)
  if typeof(c) ~= "Color3" then return "#ffffff" end
  return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

ExtraUI.hiveNum = function(n)
  local s = tostring(math.floor(tonumber(n) or 0))
  local out = s
  while true do
    local nxt, k = out:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
    out = nxt
    if k == 0 then break end
  end
  return out
end

-- bee art: BeeTypes.Thumbnails / GiftedThumbnails (hive cell art), else FaceOutline over BodyColor
ExtraUI.hiveBeeInfo = function(typeName)
  local H = ExtraUI.hive
  local got = H.info[typeName]
  if got then return got end
  local RS = game:GetService("ReplicatedStorage")
  local info = {
    color = Color3.fromRGB(84, 80, 88), thumb = "", gthumb = "", faceTex = "", faceColor = Color3.fromRGB(241, 241, 241),
    rarity = "", colorName = "", rarityColor = Color3.fromRGB(234, 228, 225),
  }
  local mod = RS:FindFirstChild("BeeTypes")
  local function texOf(o)
    if not o then return "" end
    if o:IsA("Decal") or o:IsA("Texture") then return o.Texture end
    if o:IsA("ImageLabel") or o:IsA("ImageButton") then return o.Image end
    if o:IsA("StringValue") then return o.Value end
    return ""
  end
  if mod then
    local th = mod:FindFirstChild("Thumbnails")
    local gt = mod:FindFirstChild("GiftedThumbnails")
    info.thumb = texOf(th and th:FindFirstChild(typeName))
    info.gthumb = texOf(gt and gt:FindFirstChild(typeName))
  end
  local BT
  if mod and mod:IsA("ModuleScript") then
    if H.BT == nil then
      local ok, m = pcall(require, mod)
      H.BT = (ok and type(m) == "table") and m or false
    end
    BT = H.BT or nil
  end
  local def
  if BT and type(BT.Get) == "function" then
    local ok, r = pcall(BT.Get, typeName)
    if ok and type(r) == "table" then
      def = r
    else
      ok, r = pcall(BT.Get, BT, typeName)
      if ok and type(r) == "table" then def = r end
    end
  end
  if def then
    if typeof(def.BodyColor) == "Color3" then info.color = def.BodyColor end
    if typeof(def.FaceColor) == "Color3" then info.faceColor = def.FaceColor end
    if typeof(def.RarityColor3) == "Color3" then info.rarityColor = def.RarityColor3 end
    if type(def.FaceOutline) == "string" and def.FaceOutline ~= "" then info.faceTex = def.FaceOutline end
    if info.gthumb == "" and type(def.GiftedThumbnail) == "string" then info.gthumb = def.GiftedThumbnail end
    if info.thumb == "" and type(def.Thumbnail) == "string" then info.thumb = def.Thumbnail end
    if type(def.Rarity) == "string" then info.rarity = def.Rarity end
    local tags = def.Tags
    if type(tags) == "table" then
      if info.rarity == "" and type(tags[3]) == "string" then info.rarity = tags[3]:gsub(" Bee$", "") end
      if type(tags[4]) == "string" then info.colorName = tags[4]:gsub(" Bee$", "") end
    end
  end
  -- real in-game face decal (BeeModels.<Type>.FaceTexture) + its tint
  info.faceDecalColor = Color3.new(1, 1, 1)
  for _, fname in ipairs({ "BeeModels", "GiftedBeeModels" }) do
    local fm = RS:FindFirstChild(fname)
    local bm = fm and fm:FindFirstChild(typeName)
    local fd = bm and bm:FindFirstChild("FaceTexture")
    if fd and (fd:IsA("Decal") or fd:IsA("Texture")) and fd.Texture ~= "" then
      info.faceTex = fd.Texture
      if typeof(fd.Color3) == "Color3" then info.faceDecalColor = fd.Color3 end
      if not def then
        -- bee without a BeeTypes entry (e.g. Digital): take look from the model itself
        local frame = bm:FindFirstChild("ComputerFrame")
        local bc = bm:FindFirstChild("BodyColor")
        if frame and frame:IsA("BasePart") then
          info.color = frame.Color
        elseif bc and bc:IsA("Color3Value") then
          info.color = bc.Value
        end
        local fgui = bm:FindFirstChild("FaceGui")
        local il = fgui and fgui:FindFirstChildWhichIsA("ImageLabel")
        if il and il.Image ~= "" then
          info.faceTex = il.Image
          info.faceDecalColor = Color3.new(1, 1, 1)
        end
      end
      break
    end
  end
  if info.rarity ~= "" and mod then
    local v = mod:FindFirstChild("Color" .. info.rarity)
    if v and v:IsA("Color3Value") and not (def and typeof(def.RarityColor3) == "Color3") then
      info.rarityColor = v.Value
    end
  end
  H.info[typeName] = info
  return info
end

-- mutation key (Energy / GatherMul / ConvRateMul ...) -> label + colour from BeeStats.BeeMutations
ExtraUI.hiveMut = function(key)
  local H = ExtraUI.hive
  key = tostring(key)
  local got = H.mut[key]
  if got then return got end
  local LABEL = {
    energy = "Max Energy", gather = "Gather", conversion = "Convert Rate", attack = "Attack",
    abilityrate = "Ability Rate", criticalchance = "Crit Chance", instantconversion = "Instant Convert",
    movespeed = "Movespeed",
  }
  local k = key:lower()
  k = k:gsub("mul$", "")
  k = k:gsub("convrate", "conversion")
  k = k:gsub("critchance", "criticalchance")
  k = k:gsub("^instantconv$", "instantconversion")
  local res = { color = Color3.fromRGB(190, 190, 200), label = LABEL[k] or key }
  local RS = game:GetService("ReplicatedStorage")
  local bs = RS:FindFirstChild("BeeStats")
  local mm = bs and bs:FindFirstChild("BeeMutations")
  if mm then
    local exact, loose
    for _, ch in ipairs(mm:GetChildren()) do
      if ch:IsA("Color3Value") then
        local n = ch.Name:lower():gsub("^color", "")
        if n == k then exact = ch.Value end
        if not loose and not n:find("old$") and #k >= 4 and (n:find(k, 1, true) or k:find(n, 1, true)) then
          loose = ch.Value
        end
      end
    end
    res.color = exact or loose or res.color
  end
  H.mut[key] = res
  return res
end

ExtraUI.hiveRead = function()
  local H = ExtraUI.hive
  local grid, total = {}, { bees = 0, lvl = 0, gifted = 0, mutated = 0, equipped = 0 }
  local stats = Value.statsLight()
  local hc = stats and Value.field(stats, "Honeycomb")
  if type(hc) ~= "table" then return nil end
  for ck, col in pairs(hc) do
    local c = tonumber(tostring(ck):match("^x(%d+)$"))
    if c and type(col) == "table" then
      for yk, cell in pairs(col) do
        local r = tonumber(tostring(yk):match("^y(%d+)$"))
        if r and type(cell) == "table" then
          local t = Value.field(cell, "Type")
          if type(t) == "string" then
            local gifted = false
            local traits = Value.field(cell, "Traits")
            if type(traits) == "table" then
              for _, v in pairs(traits) do
                if v == "Gifted" then gifted = true end
              end
            end
            local mutas = {}
            local m = Value.field(cell, "Mutas")
            if type(m) == "table" then
              for k, v in pairs(m) do
                mutas[#mutas + 1] = { key = tostring(k), val = v }
              end
              table.sort(mutas, function(a, b) return a.key < b.key end)
            end
            local equips = {}
            local eq = Value.field(cell, "Equips")
            if type(eq) == "table" then
              for _, e in pairs(eq) do
                local name = type(e) == "table" and Value.field(e, "T")
                if name then equips[#equips + 1] = tostring(name) end
              end
            end
            local lvl = tonumber(Value.field(cell, "Lvl")) or 0
            grid[c .. "," .. r] = {
              type = t, lvl = lvl, gifted = gifted, mutas = mutas, equips = equips, c = c, r = r,
              energy = Value.field(cell, "Energy"), mood = Value.field(cell, "Mood"), bond = Value.field(cell, "Bond"),
            }
            total.bees = total.bees + 1
            total.lvl = total.lvl + lvl
            if gifted then total.gifted = total.gifted + 1 end
            if #mutas > 0 then total.mutated = total.mutated + 1 end
            if #equips > 0 then total.equipped = total.equipped + 1 end
          end
        end
      end
    end
  end
  local unlocked = tonumber(Value.field(stats, "UnlockedCells"))
  total.slots = (unlocked and unlocked >= total.bees) and unlocked or 50
  H.grid = grid
  H.total = total
  return grid, total
end

ExtraUI.hiveDetail = function()
  local H = ExtraUI.hive
  if not H.detText then return end
  local sel = H.sel
  if H.detThumb then
    H.detThumb.Visible = false
    H.detThumb.ImageRectOffset = Vector2.new(0, 0)
    H.detThumb.ImageRectSize = Vector2.new(0, 0)
  end
  if not sel then
    H.detText.Text = '<font color="#8a8080">Hover or click a cell to inspect the bee.</font>'
    return
  end
  if (H.sub or 1) > 1 then
    -- meta hive: fixed build, every bee gifted
    local def = ExtraUI.metaHives[H.sub - 1]
    local rr = 11 - sel[2]
    local ch = def and def.layout:sub((sel[1] - 1) * 10 + rr, (sel[1] - 1) * 10 + rr) or ""
    local name = ch ~= "" and ExtraUI.metaNames[ch:byte() - 96] or nil
    if not name then
      H.detText.Text = '<font color="#8a8080">Empty cell</font>'
      return
    end
    if H.detThumb and def.asset and def.asset ~= "" then
      H.detThumb.Image = def.asset
      H.detThumb.ImageRectOffset = Vector2.new((sel[1] - 1) * 84, (rr - 1) * 74)
      H.detThumb.ImageRectSize = Vector2.new(84, 74)
      H.detThumb.Visible = true
    end
    local k = '<font color="#a6927c">'
    H.detText.Text = table.concat({
      string.format('<font size="22" color="#ff7a86"><b>%s Bee</b></font>', name),
      '<font color="#8a8080">' .. def.title .. "</font>",
      "",
      k .. "Level</font>   " .. def.lvl,
      k .. "Gifted</font>   " .. '<font color="#ffd23c">Yes</font>',
      k .. "Slot</font>   x" .. sel[1] .. ".y" .. sel[2],
    }, "\n")
    return
  end
  local d = H.grid[sel[1] .. "," .. sel[2]]
  if not d then
    local slots = (H.total and H.total.slots) or 50
    local locked = ((sel[2] - 1) * 5 + sel[1]) > slots
    H.detText.Text = '<font color="#8a8080">' .. (locked and "Locked slot" or "Empty cell") .. "  x" .. sel[1] .. ".y" .. sel[2] .. "</font>"
    return
  end
  local info = ExtraUI.hiveBeeInfo(d.type)
  if H.detThumb then
    local t = (d.gifted and info.gthumb ~= "") and info.gthumb or info.thumb
    if t == "" then t = info.faceTex end
    H.detThumb.Image = t
    H.detThumb.Visible = t ~= ""
  end
  local key = '<font color="#a6927c">'
  local lines = {}
  lines[#lines + 1] = string.format('<font size="22" color="%s"><b>%s Bee</b></font>', ExtraUI.hiveHex(info.rarityColor), d.type)
  local sub = {}
  if info.colorName ~= "" then sub[#sub + 1] = info.colorName end
  if info.rarity ~= "" then sub[#sub + 1] = info.rarity end
  if #sub > 0 then
    lines[#lines + 1] = '<font color="#8a8080">' .. table.concat(sub, "  ") .. "</font>"
  end
  lines[#lines + 1] = ""
  lines[#lines + 1] = key .. "Level</font>   " .. tostring(d.lvl)
  lines[#lines + 1] = key .. "Gifted</font>   " .. (d.gifted and '<font color="#ffd23c">Yes</font>' or "No")
  if #d.mutas > 0 then
    lines[#lines + 1] = key .. "Mutations</font>"
    for i = 1, #d.mutas do
      local mu = d.mutas[i]
      local mi = ExtraUI.hiveMut(mu.key)
      local v = tonumber(mu.val)
      local txt
      local mk = tostring(mu.key):lower():gsub("mul$", "")
      if mk == "movespeed" and v then
        -- movespeed mutation is flat and shown as stored: raw 5 -> +5
        local flat = v
        txt = (flat == math.floor(flat)) and string.format("%+d", flat) or string.format("%+.1f", flat)
      elseif v and v >= 0.5 and v <= 5 then
        txt = string.format("%+d%%", math.floor((v - 1) * 100 + 0.5))
      else
        txt = tostring(mu.val)
      end
      lines[#lines + 1] = string.format('   <font color="%s">%s  %s</font>', ExtraUI.hiveHex(mi.color), txt, mi.label)
    end
  else
    lines[#lines + 1] = key .. "Mutations</font>   none"
  end
  lines[#lines + 1] = key .. "Beequip</font>   " .. (#d.equips > 0 and table.concat(d.equips, ", ") or "none")
  if d.energy then
    -- max energy: BeeTypes field if the game exposes one, else base 300 x "Energy" mutation multiplier
    local baseMax
    local BT = H.BT
    if BT and type(BT.Get) == "function" then
      local okd, def = pcall(BT.Get, d.type)
      if okd and type(def) == "table" then
        for k, v in pairs(def) do
          if type(k) == "string" and type(v) == "number" and k:lower():find("energy", 1, true) and v >= 25 then
            baseMax = v
            break
          end
        end
      end
    end
    baseMax = baseMax or 300
    local mult = 1
    for i = 1, #d.mutas do
      local mu = d.mutas[i]
      local mv = tonumber(mu.val)
      if tostring(mu.key):lower() == "energy" and mv and mv >= 0.5 and mv <= 5 then mult = mult * mv end
    end
    local maxE = math.floor(baseMax * mult + 0.5)
    local curE = tonumber(d.energy) or 0
    if curE > maxE then maxE = math.floor(curE + 0.5) end
    lines[#lines + 1] = key .. "Energy</font>   " .. ExtraUI.hiveNum(curE) .. " / " .. ExtraUI.hiveNum(maxE)
  end
  if d.mood then lines[#lines + 1] = key .. "Mood</font>   " .. tostring(math.floor((tonumber(d.mood) or 0) * 100 + 0.5)) .. "%" end
  if d.type == "Digital" then
    -- Digital Bee: bond bar starts after the first 500B and goes to 4.5T
    local b = tonumber(d.bond) or 0
    lines[#lines + 1] = key .. "Bond</font>   " .. ExtraUI.hiveNum(math.max(0, b - 5e11)) .. " / " .. ExtraUI.hiveNum(4.5e12)
    -- drivers fed to the bee (stats.Totals.EggUses, capped per type)
    local cap = 500
    local okc, consts = pcall(function() return require(game:GetService("ReplicatedStorage").DigitalBeeConstants) end)
    if okc and type(consts) == "table" then
      for k, v in pairs(consts) do
        if type(k) == "string" and type(v) == "number" and v >= 100 and v <= 5000 and k:lower():find("driver", 1, true) and k:lower():find("max", 1, true) then
          cap = v
          break
        end
      end
    end
    local st = Value.statsLight()
    local tot = st and Value.field(st, "Totals")
    local uses = tot and Value.field(tot, "EggUses")
    if type(uses) == "table" then
      local parts = {}
      local defs = {
        { "RedDrive", "Red", "#ff5a5a" }, { "WhiteDrive", "White", "#f0f0f0" },
        { "BlueDrive", "Blue", "#5ab4ff" }, { "GlitchedDrive", "Glitched", "#e060ff" },
      }
      for _, df in ipairs(defs) do
        local n = math.min(cap, tonumber(Value.field(uses, df[1])) or 0)
        parts[#parts + 1] = string.format('<font color="%s">%s x%d</font>', df[3], df[2], n)
      end
      lines[#lines + 1] = key .. "Drivers</font>"
      lines[#lines + 1] = "   " .. table.concat(parts, "   ")
    end
  elseif d.bond then
    lines[#lines + 1] = key .. "Bond</font>   " .. ExtraUI.hiveNum(d.bond)
  end
  H.detText.Text = table.concat(lines, "\n")
end


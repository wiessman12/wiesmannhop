-- Buff Start/Dur from the server are on the server clock (Start is fractional, e.g. 1791987244.82).
-- os.time() is the player's own PC clock (integer, may be seconds off) -> use the synced server clock.
FieldFx.serverNow = function()
  local ok, t = pcall(function() return Workspace:GetServerTimeNow() end)
  if ok and type(t) == "number" then return t end
  return os.time()
end

local function buffLeft(src)
  local b = Buffs[src]
  if not b or type(b.start) ~= "number" or type(b.dur) ~= "number" then return nil end
  local left = b.start + b.dur - FieldFx.serverNow()
  if left <= 0 and type(b.evAt) == "number" then
    -- The server said "expired" but no Remove event came: if the clocks disagree, a live buff would look dead and
    -- Enable boost would re-roll x4 forever. Fall back to our own clock since the last Apply/Refresh event.
    local localLeft = b.dur - (os.clock() - b.evAt)
    if localLeft > 0 then return localLeft end
  end
  return math.max(0, left)
end


-- ===== ALERT TICK (buff bar + streams) — must sit after buffLeft / findStackTextNear =====
local function parseTimerText(s)
  if type(s) ~= "string" or s == "" then return nil end
  local a, b = s:match("(%d+)%s*:%s*(%d+)")
  if a and b then
    local v = tonumber(a) * 60 + tonumber(b)
    if v and v > 0 and v <= 600 then return v end
  end
  local n = s:match("(%d+%.?%d*)%s*[sS]")
  if n then
    local v = tonumber(n)
    if v and v > 0 and v <= 600 then return v end
  end
  -- (a bare number is the STACK counter of the tile, never a timer: reading it as seconds made x10 look like "10s left")
  return nil
end

local function findTimerNear(inst)
  local parent = inst.Parent
  for _ = 1, 5 do
    if not parent then break end
    local best = nil
    pcall(function()
      for _, ch in ipairs(parent:GetDescendants()) do
        if ch:IsA("TextLabel") or ch:IsA("TextButton") or ch:IsA("TextBox") then
          local v = parseTimerText(tostring(ch.Text or ""))
          if v and (not best or v < best) then best = v end
        end
      end
      for _, ch in ipairs(parent:GetDescendants()) do
        if ch:IsA("GuiObject") then
          local nm = string.lower(ch.Name or "")
          if nm:find("timer", 1, true) or nm:find("progress", 1, true) or nm:find("fill", 1, true) or nm == "bar" then
            local sc = nil
            pcall(function()
              sc = ch.Size.Y.Scale
              if not sc or sc <= 0 then sc = ch.Size.X.Scale end
            end)
            if type(sc) == "number" and sc > 0 and sc <= 1 then
              local est = sc * Config.PRECISION_DUR
              if est > 0 and (not best or est < best) then best = est end
            end
          end
        end
      end
    end)
    if best then return best end
    parent = parent.Parent
  end
  return nil
end


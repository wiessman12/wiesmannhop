    l.Size = UDim2.new(1, -36, 0, h)
    l.Font = font
    l.TextSize = size
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.TextColor3 = color
    l.TextTransparency = 1
    l.TextWrapped = wrap and true or false
    l.Text = text
    l.ZIndex = 42
    l.Parent = card
    labels[#labels + 1] = l
    y = y + h + 6
  end

  addLine(hello, 22, Color3.fromRGB(234, 228, 225), Enum.Font.GothamBold, 28, false)
  addLine("Added", 13, Color3.fromRGB(138, 128, 128), Enum.Font.Gotham, 16, false)
  if #added == 0 then
    addLine("—", 14, Color3.fromRGB(236, 226, 228), Enum.Font.GothamMedium, 18, false)
  else
    for i = 1, #added do
      addLine("·  " .. tostring(added[i]), 14, Color3.fromRGB(236, 226, 228), Enum.Font.GothamMedium, 36, true)
    end
  end
  addLine("Removed", 13, Color3.fromRGB(138, 128, 128), Enum.Font.Gotham, 16, false)
  if #removed == 0 then
    addLine("—", 14, Color3.fromRGB(236, 226, 228), Enum.Font.GothamMedium, 18, false)
  else
    for i = 1, #removed do
      addLine("·  " .. tostring(removed[i]), 14, Color3.fromRGB(236, 226, 228), Enum.Font.GothamMedium, 36, true)
    end
  end
  addLine("Click to close", 12, Color3.fromRGB(150, 124, 130), Enum.Font.Gotham, 16, false)
  card.Size = UDim2.fromOffset(400, y + 14)
  useFonts(card)

  local closed = false
  local function fadeText(goal, dur)
    local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for i = 1, #labels do
      TweenService:Create(labels[i], info, { TextTransparency = goal }):Play()
    end
  end
  local function dismiss()
    if closed then return end
    closed = true
    fadeText(1, 0.16)
    TweenService:Create(dim, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(card, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
      Position = UDim2.new(0.5, 0, 0.5, 16),
    }):Play()
    task.delay(0.18, function()
      pcall(function() dim:Destroy() end)
      pcall(function() card:Destroy() end)
    end)
  end

  dim.MouseButton1Click:Connect(dismiss)
  local hit = Instance.new("TextButton")
  hit.Size = UDim2.fromScale(1, 1)
  hit.BackgroundTransparency = 1
  hit.Text = ""
  hit.ZIndex = 43
  hit.Parent = card
  hit.MouseButton1Click:Connect(dismiss)

  TweenService:Create(dim, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.45 }):Play()
  TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
    Position = UDim2.fromScale(0.5, 0.5),
  }):Play()
  TweenService:Create(noteScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
  task.delay(0.2, function()
    if closed or not Session.alive then return end
    fadeText(0, 0.32)
  end)
  task.delay(14, function()
    if Session.alive then dismiss() end
  end)
end


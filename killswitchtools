-- ================= COUNTERS =================
local function handleCounter(key, t, v, max)
  if type(v) ~= "number" then return end
  if t.last then
    local d = v - t.last
    local half = max * 0.5
    if d <= -half then
      t.up = true
      t.vote = 3
      if t == CounterTrack.xf then xfBurstUntil = os.clock() + 1.6 end
    elseif d >= half then
      t.up = false
      t.vote = -3
    elseif d ~= 0 and math.abs(d) < half then
      t.vote = t.vote + d
      if math.abs(t.vote) >= 3 then t.up = t.vote > 0 end
    end
  end
  t.last = v
end

local function counterUntil(t, v, max)
  if type(v) ~= "number" then return nil, nil end
  if t.up then return math.max(0, max - v), v end
  return math.max(0, v), math.max(0, max - v)
end

local function calibrate(keyName, value, max, confirmed)
  local c = Calib[keyName]
  local srcKey = c.src
  if keyName == "sc" and not srcKey then
    srcKey = Cumul["Boost"] and "Boost" or (Cumul["Red Boost"] and "Red Boost" or nil)
    c.src = srcKey
  end
  if not srcKey or type(Cumul[srcKey]) ~= "number" then return false end
  c.offset = (value - Cumul[srcKey]) % max
  if confirmed then c.confirmed = true end
  return true
end

local function applyDerived(keyName, t, max)
  local c = Calib[keyName]
  if not c.offset or not c.src then return end
  if keyName == "xf" and Counters.xfCd then
    -- X-Flame cooldown (xflame_dump: "Use" -> no counter for ~20s): keep the count at 0 until it is over, then restart from 0
    if Counters.xfCd - FieldFx.serverNow() > 0 then
      Counters.xfWasCd = true
      return
    elseif Counters.xfWasCd then
      Counters.xfWasCd = false
      calibrate("xf", 0, max, false)
    end
  end
  local b = Cumul[c.src]
  if type(b) ~= "number" then return end
  local prog = (b + c.offset) % max
  handleCounter(keyName, t, prog, max)
  if keyName == "xf" then Counters.xflame = prog else Counters.scorch = prog end
end

-- ================= TOKEN CLASSIFICATION =================
-- Link is LAST. A shared decal (or a learned id that also sits on other tokens) must not
-- steal Baby Love / Inspire / Precision / Morph / Smile. That made every token a Token Link with a 4s timer stuck at 0s.
local function classifyIcon(icon)
  local id = iconId(icon)
  if not id then return nil, nil end
  if id == KNOWN_INSPIRE_ID or (IconMap.inspire and id == IconMap.inspire) then return "inspire", nil end
  if id == KNOWN_BABY_ID or (IconMap.baby and id == IconMap.baby) then return "baby", nil end
  if id == iconId(IconMap.target) then return "target", nil end
  if id == FieldFx.SMILE_ID or (IconMap.smile and id == IconMap.smile) then return "smile", nil end
  if id == KNOWN_PRECISION_ID or id == iconId(IconMap.precision) then return "precision", nil end
  local morphName = MorphIcons[id] or KNOWN_MORPH_ICONS[id]
  if type(morphName) == "string" then return "morph", morphName end
  if id == KNOWN_LINK_ID or (IconMap.link and id == IconMap.link and id ~= KNOWN_INSPIRE_ID and id ~= KNOWN_BABY_ID and id ~= KNOWN_PRECISION_ID and id ~= FieldFx.SMILE_ID and not KNOWN_MORPH_ICONS[id]) then
    return "link", nil
  end
  return nil, nil
end

local function recordMorphSpawn()
  local now = os.clock()
  if MorphTrack.lastTokenAt and (now - MorphTrack.lastTokenAt) < 8 then
    return
  end
  if MorphTrack.morphing then
    MorphTrack.lastTokenAt = now
    return
  end
  if MorphTrack.waitStart then
    local w = now - MorphTrack.waitStart
    if w >= 6 and w <= 720 then
      MorphTrack.waits[#MorphTrack.waits + 1] = w
      if #MorphTrack.waits > 10 then table.remove(MorphTrack.waits, 1) end
      MorphTrack.refreshStats()
    end
  end
  MorphTrack.lastTokenAt = now
  MorphTrack.waitStart = now
end

-- ================= REMOTE STREAMS =================
local function onBuffEvent(action, src, startTime, dur, combo)
  if type(src) ~= "string" then return end
  do -- probe: record every coco / combo buff event so the real Coco Combo signal can be seen in bufftools_alerts.log
    local lo = src:lower()
    if lo:find("coco", 1, true) or lo:find("combo", 1, true) then
      pcall(MorphTrack.dbg, "bev_" .. tostring(action) .. src,
        ("buff event %s '%s' start=%s dur=%s combo=%s"):format(tostring(action), src, tostring(startTime), tostring(dur), tostring(combo)), 2)
    end
  end
  if action == "Remove" then
    Buffs[src] = nil
    return
  end
  if action == "Apply" or action == "ChangeCombo" or action == "Refresh" then
    local b = Buffs[src]
    if not b then
      b = {}
      Buffs[src] = b
    end
    if type(startTime) == "number" and startTime > 0 then b.start = startTime end
    if type(dur) == "number" then b.dur = dur end
    if type(combo) == "number" then b.combo = combo end
    b.evAt = os.clock() -- when the server last (re)applied this buff: used to detect the end of a dice roll
    b.fromSlot = nil
    b.fromGui = nil
    -- Coconut Combo used / refreshed (not Remove). ChangeCombo = catch stacks climbing.
    if isCocoComboName(src) and (action == "Apply" or action == "Refresh" or action == "ChangeCombo") then
      MorphTrack.cocoSeen = true
      pcall(MorphTrack.playCocoCombo, "buff " .. action .. " '" .. src .. "' combo=" .. tostring(combo))
    end
  end
end

local function onAbilityEvent(payload)
  if type(payload) ~= "table" then return end
  local ss = rawget(payload, "Scorching Star")
  if type(ss) == "table" and type(rawget(ss, "Values")) == "table" then
    local v = rawget(ss.Values, 1)
    if type(v) == "number" then
      Counters.scorch = v
      CounterTrack.sc.last = v
      calibrate("sc", v, Config.SCORCH_MAX, true)
    end
  end
  local xf = rawget(payload, "X-Flame")
  if type(xf) == "table" and rawget(xf, "Action") == "Use" then
    -- xflame_dump: the proc arrives as {Action="Use", CooldownUntil=...} WITHOUT Values, the counter no longer wraps
    -- (it only restarts ~20s later), so this is the burst signal for the flame timers
    local now = os.clock()
    xfBurstUntil = now + 2
    Counters.xfBurstAt = now
    local cu = rawget(xf, "CooldownUntil")
    if type(cu) == "number" then Counters.xfCd = cu end
    Counters.xflame = 0
    CounterTrack.xf.last, CounterTrack.xf.up, CounterTrack.xf.vote = 0, true, 0
    pcall(calibrate, "xf", 0, Config.XFLAME_MAX, true)
    local fi = Counters.finfo
    if fi then
      for _, rec in pairs(fi) do
        if now - rec.t < 0.6 then rec.xf = true end -- flames whose event came a moment before "Use"
      end
    end
    Counters.xfPendUntil = now + 2.5
  end
  if type(xf) == "table" and type(rawget(xf, "Values")) == "table" then
    local v = rawget(xf.Values, 1)
    if type(v) == "number" then
      Counters.xflame = v
      CounterTrack.xf.last = v
      calibrate("xf", v, Config.XFLAME_MAX, true)
    end
  end
  -- Coconut Combo / Combo Coconuts ability Use
  for k, v in pairs(payload) do
    if type(k) == "string" and isCocoComboName(k) and type(v) == "table" then
      local act = rawget(v, "Action")
      if act == "Use" or act == "Apply" or act == nil then
        pcall(MorphTrack.playCocoCombo, "ability '" .. k .. "' action=" .. tostring(act))
      elseif act ~= "Update" then
        MorphTrack.dbg("coco_act_" .. k .. tostring(act), "ability '" .. k .. "' action=" .. tostring(act) .. " (not used as trigger)", 5)
      end
    end
  end
end

local function onCollectibleEvent(action, data)
  if type(data) ~= "table" then return end
  if action == "Spawn" then
    local id = rawget(data, "ID")
    local pos = rawget(data, "Pos")
    if id and typeof(pos) == "Vector3" then
      local icon = rawget(data, "Icon") or rawget(data, "IconId") or rawget(data, "Texture") or rawget(data, "Decal")
      local nm = rawget(data, "Name") or rawget(data, "Type") or rawget(data, "Ability") or rawget(data, "Token")
      if FieldFx.honeyName(nm) then
        local hid = iconId(icon)
        if hid then FieldFx.honey[hid] = true end
      end
      local kind, morphName = classifyIcon(icon)
      if not kind then
        kind, morphName = kindFromName(nm)
        if kind == "morph" or kind == "inspire" or kind == "baby" or kind == "link" or kind == "precision" or kind == "target" or kind == "smile" then
          rememberBeamIcon(nm, icon)
        end
        if kind == "target" then lastTpCollectAt = os.clock() end
      end
      local dur = rawget(data, "Dur")
      local st = rawget(data, "SpawnTime")
      if kind == "smile" and type(dur) == "number" then Counters.smileLife = dur end
      Tokens[id] = {
        kind = kind,
        icon = icon,
        morphName = morphName,
        name = nm,
        counted = false,
        pos = pos,
        expires = (type(st) == "number" and st or os.time()) + (type(dur) == "number" and dur or 15),
      }
      if kind == "morph" then
        recordMorphSpawn()
        Tokens[id].counted = true
      end
    end
  elseif action == "Collect" then
    local id = rawget(data, "ID")
    if id then
      local tok = Tokens[id]
      local nm = rawget(data, "Name") or rawget(data, "Type") or (tok and tok.name)
      if (tok and tok.kind == "target") or (select(1, kindFromName(nm)) == "target") then
        lastTpCollectAt = os.clock()
      end
      Tokens[id] = nil
    end
  end
end

-- icons are learned over time; re-classify tokens every poll so a
-- token spawned before its icon was known still gets its beam
local function reclassifyTokens()
  for id, tok in pairs(Tokens) do
    local icon = tok.icon
    if tok.part and tok.part.Parent then
      icon = FieldFx.tokenIconTex(tok.part) or icon
      tok.icon = icon
    end
    local k, morphName = classifyIcon(icon)
    -- World collectible parts keep leftover names like "Panda Bear Morph" after recycle.
    -- Never classify those from Name — only from the live icon.
    local isWorld = type(id) == "string" and id:sub(1, 2) == "w_"
    if not k and not isWorld then
      k, morphName = kindFromName(tok.name)
    end
    if k then
      if k ~= tok.kind then
        tok.kind = k
        if k == "morph" and not tok.counted then
          recordMorphSpawn()
          tok.counted = true
        end
      end
      tok.morphName = morphName
    else
      tok.kind = nil
      tok.morphName = nil
    end
  end
end


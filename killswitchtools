  key = "w_" .. tostring(worldPartSeq)
  worldPartKeys[part] = key
  return key
end
local function getCollectiblesFolder()
  if not cachedCollectibles or not cachedCollectibles.Parent then
    cachedCollectibles = Workspace:FindFirstChild("Collectibles")
  end
  return cachedCollectibles
end

-- icon of a world token. Several decals can sit on one part; a shared "link" face must lose
-- to Baby Love / Inspire / Precision / Morph / Smile on the same token.
FieldFx.ICON_RANK = { morph = 7, smile = 6, precision = 5, target = 4, baby = 3, inspire = 2, link = 1 }
FieldFx.tokenIconTex = function(inst)
  local bestTex, bestRank
  local function consider(t)
    if type(t) ~= "string" or t == "" then return end
    local k = classifyIcon(t)
    if not k then return end
    local r = FieldFx.ICON_RANK[k] or 0
    if not bestRank or r > bestRank then bestTex, bestRank = t, r end
  end
  local d = inst:FindFirstChildOfClass("Decal") or inst:FindFirstChildOfClass("Texture")
  if d then consider(d.Texture) end
  pcall(function()
    for _, o in ipairs(inst:GetDescendants()) do
      if o:IsA("Decal") or o:IsA("Texture") then consider(o.Texture)
      elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then consider(o.Image) end
    end
  end)
  return bestTex
end
FieldFx.tokenPos = function(inst)
  if inst:IsA("BasePart") then return inst.Position end
  local ok, cf = pcall(function() return inst:GetPivot() end)
  if ok and cf then return cf.Position end
  return nil
end
FieldFx.diagAt = 0

local function scanWorldTokens()
  local folder = getCollectiblesFolder()
  if not folder then return end
  local seen = {}
  local nParts, nKind = 0, 0
  for _, part in ipairs(folder:GetChildren()) do
    if part:IsA("BasePart") or part:IsA("Model") then
      nParts = nParts + 1
      local tex = FieldFx.tokenIconTex(part)
      local key = worldTokenKey(part)
      -- Icon only. Part.Name is reused after morph pickup and would mark Haste as morph.
      local kind, morphName = classifyIcon(tex)
      local ppos = FieldFx.tokenPos(part)
      if kind and ppos then
        nKind = nKind + 1
        seen[key] = true
        local tok = Tokens[key]
        local sameIcon = tok and iconId(tok.icon) == iconId(tex)
        if not tok then
          local life = (kind == "link") and 4 or ((kind == "target") and 8 or ((kind == "smile") and (Counters.smileLife or 14.4) or 15))
          Tokens[key] = {
            kind = kind,
            icon = tex,
            morphName = morphName,
            name = kind,
            counted = kind == "morph",
            pos = ppos,
            expires = os.time() + life,
            spawnedAt = os.clock(),
            part = part,
          }
          if kind == "morph" then recordMorphSpawn() end
        else
          if tok.kind == "link" and kind ~= "link" then
            tok.spawnedAt = os.clock()
          end
          if not sameIcon then
            tok.counted = kind == "morph"
            tok.spawnedAt = os.clock()
            if kind == "morph" then recordMorphSpawn() end
          end
          tok.kind = kind
          tok.icon = tex
          tok.morphName = morphName
          tok.name = kind
          tok.pos = ppos
          tok.part = part
          local life = (kind == "link") and 4 or ((kind == "target") and 8 or ((kind == "smile") and (Counters.smileLife or 14.4) or 15))
          local born = tok.spawnedAt or os.clock()
          tok.expires = os.time() + math.max(1, math.ceil(life - (os.clock() - born)))
        end
      else
        Tokens[key] = nil
      end
      if part:IsA("BasePart") then
        local hid = iconId(tex)
        if hid and FieldFx.honey[hid] and not kind then
          FieldFx.cover(part)
        elseif FieldFx.hidden[part] then
          FieldFx.uncover(part)
        end
      end
    end
  end
  for id, tok in pairs(Tokens) do
    if type(id) == "string" and id:sub(1, 2) == "w_" then
      if not seen[id] or (tok.part and not tok.part.Parent) then
        if tok.kind == "target" then lastTpCollectAt = os.clock() end
        Tokens[id] = nil
      end
    end
  end
  -- one-shot diagnostics: world has tokens but none classified -> print what they look like
  if nParts > 0 and nKind == 0 then
    local nowD = os.clock()
    if nowD - (FieldFx.diagAt or 0) > 45 then
      FieldFx.diagAt = nowD
      pcall(function()
        local out = {}
        for _, part in ipairs(folder:GetChildren()) do
          if #out >= 4 then break end
          local kids = {}
          for _, d in ipairs(part:GetDescendants()) do
            local t = ""
            if d:IsA("Decal") or d:IsA("Texture") then t = "=" .. tostring(d.Texture)
            elseif d:IsA("ImageLabel") then t = "=" .. tostring(d.Image) end
            kids[#kids + 1] = d.ClassName .. ":" .. d.Name .. t
            if #kids >= 6 then break end
          end
          out[#out + 1] = part.ClassName .. ":" .. part.Name .. " {" .. table.concat(kids, ", ") .. "}"
        end
        print("[BuffTools] diag: Collectibles has " .. nParts .. " parts, 0 recognised tokens. Sample: " .. table.concat(out, " | "))
      end)
    end
  end
end

local function onTokenEvent(payload)

-- Precise/Pollen/Honey marks (orange) + Target Practice discs (purple)
local FarmMarks = {}
local hookedFx = {}

local function asVec3(v)
  if typeof(v) == "Vector3" then return v end
  if typeof(v) == "CFrame" then return v.Position end
  if type(v) == "table" then
    local x = rawget(v, "X") or rawget(v, 1)
    local y = rawget(v, "Y") or rawget(v, 2)
    local z = rawget(v, "Z") or rawget(v, 3)
    if type(x) == "number" and type(y) == "number" and type(z) == "number" then
      return Vector3.new(x, y, z)
    end
  end
  return nil
end

local function asColor3(c)
  if typeof(c) == "Color3" then return c end
  if type(c) ~= "table" then return nil end
  local r = rawget(c, "R") or rawget(c, 1)
  local g = rawget(c, "G") or rawget(c, 2)
  local b = rawget(c, "B") or rawget(c, 3)
  if type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then return nil end
  if r > 1 or g > 1 or b > 1 then
    return Color3.fromRGB(r, g, b)
  end
  return Color3.new(r, g, b)
end

local function extractPulse(t, depth)
  if type(t) ~= "table" or depth > 5 then return nil end
  if tonumber(rawget(t, "Delay")) and tonumber(rawget(t, "Delay")) > 0 then
    return nil
  end
  local pos = asVec3(
    rawget(t, "Position") or rawget(t, "Pos") or rawget(t, "Origin")
      or rawget(t, "Goal") or rawget(t, "CFrame") or rawget(t, "Point")
  )
  local rad = tonumber(rawget(t, "GoalRadius"))
  local height = tonumber(rawget(t, "Height")) or 0
  local col = asColor3(rawget(t, "Color") or rawget(t, "Colour") or rawget(t, "Tint"))
  if pos and rad then
    return pos, rad, height, col
  end
  for _, v in pairs(t) do
    if type(v) == "table" then
      local p, r, h, c = extractPulse(v, depth + 1)
      if p then return p, r, h, c end
    end
  end
  return nil
end

local function pushFarmMark(pos, rad, kind)
  if typeof(pos) ~= "Vector3" then return end
  kind = kind or "mark"
  rad = tonumber(rad) or ((kind == "target") and Config.TP_RADIUS or Config.MARK_RADIUS)
  local now = os.clock()
  local life = (kind == "target") and Config.TP_LIFE or Config.MARK_LIFE
  for _, m in ipairs(FarmMarks) do
    if m.kind == kind then
      local dx = m.pos.X - pos.X
      local dz = m.pos.Z - pos.Z
      if (dx * dx + dz * dz) < 16 then
        m.pos = pos
        m.rad = rad
        m.expires = now + life
        return
      end
    end
  end
  FarmMarks[#FarmMarks + 1] = {
    pos = pos,
    rad = rad,
    kind = kind,
    born = now,
    expires = now + life,
  }
  while #FarmMarks > Config.MARK_MAX do
    table.remove(FarmMarks, 1)
  end
end

local function classifyPulse(rad, height, col)
  local orange = col and col.R > 0.85 and col.G > 0.45 and col.G < 0.85 and col.B < 0.25
  local purple = col and col.B > 0.35 and col.R > 0.15 and col.G < 0.55 and col.B >= col.G
  if purple then return "target" end
  -- Dump: mark rings are orange, Height=14, GoalRadius 14 or 18. Bombs are r=10/12/16 Height=4/8.
  if height >= 12 and (rad == 14 or rad == 18) then return "mark" end
  if orange and height >= 12 and rad >= 13 and rad <= 20 then return "mark" end
  return nil
end

local function ingestPulse(kindHint, data)
  local hint = tostring(kindHint or "")
  local pos, rad, height, col
  if type(data) == "table" then
    pos, rad, height, col = extractPulse(data, 1)
  elseif typeof(data) == "Vector3" then
    pos = data
  end
  if not pos then return end
  rad = tonumber(rad) or 0
  height = tonumber(height) or 0
  local low = hint:lower()
  local kind = classifyPulse(rad, height, col)
  if not kind then
    if low:find("target", 1, true) or low:find("practice", 1, true) then
      kind = "target"
    elseif low:find("mark", 1, true) then
      kind = "mark"
    end
  end
  local fresh = (os.clock() - lastTpCollectAt) <= 8
  local purple = kind == "target" or (col and col.B > 0.35 and col.R > 0.15 and col.G < 0.55 and col.B >= col.G)
  local orange = col and col.R > 0.75 and col.G > 0.25 and col.B < 0.45
  if pos and (purple or (fresh and orange)) then
    FieldFx.pushAim(pos, (rad > 0 and rad) or (purple and 12 or 8), purple and true or false)
  end
  if purple or kind == "target" then return end
  if not kind then return end
  if rad < 12 or rad > 22 then rad = Config.MARK_RADIUS end
  pushFarmMark(pos, rad, "mark")
end

-- Flames (xflame_dump): LocalFX "LocalFlames" {A="N", FID, P, T=life seconds, D=true when it re-casts a flame that burns there}
-- creates the part "Flm<FID>" in Workspace.PlayerFlames; {A="D", FID} removes it. T is the REAL life of that flame, and an
-- X-Flame flame that gets re-cast on the same spot (D=true) is a NEW part: it inherits the X-Flame tag + a fresh timer.
Counters.finfo = {}
Counters.flameFx = function(d)
  local fid = d.FID
  if fid == nil or d.A ~= "N" then return end
  local now = os.clock()
  local rec = { t = now, T = tonumber(d.T), pos = typeof(d.P) == "Vector3" and d.P or nil }
  if now <= xfBurstUntil and now >= (Counters.xfBurstAt or -99) - 0.3 then rec.xf = true end
  if d.D == true and rec.pos and not rec.xf then
    for part in pairs(xfTagged) do
      if part.Parent then
        local pp = part.Position
        if math.abs(pp.X - rec.pos.X) < 1 and math.abs(pp.Z - rec.pos.Z) < 1 then rec.xf = true break end
      end
    end
  end
  Counters.finfo[fid] = rec
  if rec.xf then Counters.xfPendUntil = now + 2.5 end
  Counters.finfoN = (Counters.finfoN or 0) + 1
  if Counters.finfoN > 400 then
    Counters.finfoN = 0
    for k, r in pairs(Counters.finfo) do
      if now - r.t > 30 then Counters.finfo[k] = nil end
    end
  end
end

local function onLocalFX(...)
  local args = { ... }
  if args[1] == "LocalTargetPracticeBeam" and type(args[2]) == "table" then
    pcall(FieldFx.markOnFx, args[2])
  end
  if args[1] == "LocalFlames" and type(args[2]) == "table" then
    pcall(Counters.flameFx, args[2])
  end
  for i = 1, #args do
    local a = args[i]
    if type(a) == "string" then
      local s = a:lower()
      if a == "RingPulse" or s:find("ring", 1, true) or s:find("target", 1, true) or s:find("mark", 1, true) then
        ingestPulse(a, args[i + 1])
      end
    elseif type(a) == "table" and (rawget(a, "GoalRadius") or rawget(a, "Radius")) then
      ingestPulse("RingPulse", a)
    end
  end
end

local function hookFxRemote(ev)
  if not ev or hookedFx[ev] then return end
  hookedFx[ev] = true
  Session.track(ev.OnClientEvent:Connect(function(...)
    onLocalFX(...)
  end))
end

-- Duped tokens: remaining-life counter above every duped token (smiley-faced dupes + duped Morph).
-- Dump facts: DupedTokenCreate({EndTime, Pos, Icon, ID, ...}), DupedTokenCharge(id, serverTime),
-- DupedTokenDestroy(id, pickedUp). EndTime is on the server clock: serverTime = DistributedGameTime + offset
-- (offset is learned from the Charge payloads; before the first Charge we use the measured life classes).
FieldFx.Dupe = {
  tokens = {},
  claimed = {},
  offS = {},
  off = nil,
  MORPH = {
    [1472580249] = true, [1472532912] = true, [1472491940] = true,
    [1472425802] = true, [2032949183] = true, [1489734171] = true,
  },
  LONG = {
    [2000457501] = true, [2499514197] = true, [2499540966] = true,
    [4528208186] = true, [8173559749] = true, [253828517] = true,
  },
}
do
  local D = FieldFx.Dupe

  function D.iconId(v)
    local s = tostring(v or "")
    return tonumber(s:match("%d+"))
  end

  -- Wiki: duped life = original token life x 2 x (1 + 0.05 x Digital Bee level).
  -- Measured at level 10 (x3.0): 4.76s -> 14.28s, so the level-less bases (x2) are:
  D.BASE_NORMAL, D.BASE_LONG, D.BASE_MORPH = 9.52, 19.4, 36.13

  function D.level()
    local l = D.digiLevel and D.digiLevel() or nil
    return l or 10
  end

  function D.classLife(icon)
    local base = D.BASE_NORMAL
    if icon and D.MORPH[icon] then base = D.BASE_MORPH
    elseif icon and D.LONG[icon] then base = D.BASE_LONG end
    return base * (1 + 0.05 * D.level())
  end

  function D.onCreate(d)
    if type(d) ~= "table" or d.ID == nil then return end
    local icon = D.iconId(d.Icon)
    local now = os.clock()
    local life = D.classLife(icon)
    local et = tonumber(d.EndTime)
    D.tokens[d.ID] = {
      id = d.ID,
      icon = icon,
      morph = icon ~= nil and D.MORPH[icon] == true,
      pos = typeof(d.Pos) == "Vector3" and d.Pos or nil,
      endTime = et,
      born = now,
      guessEnd = now + life,
    }
    -- server-clock offset estimate from the expected life (median over creates; Charge gives the exact one)
    if et then
      local G = D.offG
      if not G then G = {}; D.offG = G end
      G[#G + 1] = et - life - Workspace.DistributedGameTime
      if #G > 9 then table.remove(G, 1) end
      local c = table.clone(G)
      table.sort(c)
      D.offGuess = c[math.ceil(#c / 2)]
    end
  end

  function D.onCharge(id, st)
    st = tonumber(st)
    if not st then return end
    local sample = st - Workspace.DistributedGameTime
    local S = D.offS
    S[#S + 1] = sample
    if #S > 9 then table.remove(S, 1) end
    local c = table.clone(S)
    table.sort(c)
    D.off = c[math.ceil(#c / 2)]
  end

  function D.drop(id)
    local tok = D.tokens[id]
    if not tok then return end
    D.tokens[id] = nil
    if tok.part then D.claimed[tok.part] = nil end
    if tok.gui then pcall(function() tok.gui:Destroy() end) end
    if tok.fake then pcall(function() tok.fake:Destroy() end) end
  end

  function D.left(tok)
    local off = D.off or D.offGuess
    if off and tok.endTime then
      local l = tok.endTime - (Workspace.DistributedGameTime + off)
      if l > -3 and l < 240 then return l end
    end
    return tok.guessEnd - os.clock()
  end

  function D.findPart(tok)
    local cam = Workspace:FindFirstChild("Camera") or Workspace.CurrentCamera
    local folder = cam and cam:FindFirstChild("DupedTokens")
    if not folder then return nil end
    local best, bd = nil, 14
    for _, p in ipairs(folder:GetChildren()) do
      if p:IsA("BasePart") and not D.claimed[p] then
        local d = tok.pos and (p.Position - tok.pos).Magnitude or 0
        if d < bd then best, bd = p, d end
      end
    end
    return best
  end

  function D.makeGui(tok, adornee)
    local bb = Instance.new("BillboardGui")
    bb.Name = "BTDupeTimer"
    bb.Size = UDim2.fromOffset(tok.morph and 76 or 56, tok.morph and 26 or 20)
    bb.StudsOffset = Vector3.new(0, tok.morph and 3.4 or 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 300
    bb.Adornee = adornee
    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.fromScale(1, 1)
    lab.BackgroundTransparency = 1
    lab.Font = Enum.Font.GothamBold
    lab.TextSize = tok.morph and 19 or 15
    lab.TextStrokeTransparency = 0.25
    lab.TextStrokeColor3 = Color3.fromRGB(10, 10, 14)
    lab.Parent = bb
    tok.gui, tok.lab = bb, lab
    -- on the token itself, not BuffToolsBeams: clearing rays must not delete these timers
    bb.Parent = adornee
  end

  function D.step()
    local now = os.clock()
    for id, tok in pairs(D.tokens) do
      local left = D.left(tok)
      if left < -4 then
        D.drop(id)
      else
        if tok.part and not tok.part.Parent then
          D.claimed[tok.part] = nil
          tok.part = nil
        end
        if not tok.part then
          local p = D.findPart(tok)
          if p then
            tok.part = p
            D.claimed[p] = id
          elseif tok.pos and not tok.fake and now - tok.born > 2.5 then
            local f = Instance.new("Part")
            f.Name = "BTDupeAnchor"
            f.Anchored, f.CanCollide, f.CanQuery, f.CanTouch = true, false, false, false
            f.Transparency = 1
            f.Size = Vector3.new(1, 1, 1)
            f.Position = tok.pos
            f.Parent = Workspace.CurrentCamera or Workspace
            tok.fake = f
          end
        end
        local adornee = tok.part or tok.fake
        if adornee then
          if not tok.gui or not tok.gui.Parent then D.makeGui(tok, adornee) end
          if tok.gui and tok.gui.Parent and tok.gui.Parent ~= adornee then
            tok.gui.Parent = adornee
            tok.gui.Adornee = adornee
          end
          local l = math.max(left, 0)
          tok.lab.Text = string.format("%.1fs", l)
          if tok.morph then
            tok.lab.TextColor3 = l < 6 and Color3.fromRGB(255, 80, 60) or Color3.fromRGB(255, 196, 64)
          else
            tok.lab.TextColor3 = l < 5 and Color3.fromRGB(255, 80, 60)
              or (l < 10 and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(150, 255, 170))
          end
        end
      end
    end
  end

  function D.start()
    local acc = 0
    Session.track(RunService.Heartbeat:Connect(function(dt)
      if not Session.alive then return end
      acc = acc + dt
      if acc < 0.08 then return end
      acc = 0
      if next(D.tokens) then pcall(D.step) end
    end))
  end
  D.start()
end

-- On-screen notifications (Notify tab): "PINK BLOOM" banner + Smiley logs ("SMILEY +1.23B").
-- Per notification: on/off, screen position (fraction of the screen) and size; saved in bufftools_notify.json.
-- Smiley amount = honey from one Smile pick. The game tags the pick on the Pollen Give (g contains Smile).
-- Honey Give has no Smile tag, so the honey is that pollen times the session convert rate
-- (untagged honey / pollen). One pick is a burst of Give events, summed with a short debounce.
do
  local N = { file = "bufftools_notify.json", labs = {}, prev = {}, drag = nil,
    smile = { pollen = 0, honey = 0, tok = 0, picks = 0, total = 0, last = 0 } }
  FieldFx.Notif = N
  N.DEF = {
    bloom = { on = true, x = 0.5, y = 0.5, size = 1 },
    smiley = { on = true, x = 0.5, y = 0.4, size = 1 }, -- "Smiley notify": centre banner
    slog = { on = true, x = 0, y = 0, size = 1 },       -- "Smiley log": right-edge panel (own size; position = drag the panel)
  }
  N.cfg = { bloom = {}, smiley = {}, slog = {} }
  for k, d in pairs(N.DEF) do
    for f, v in pairs(d) do N.cfg[k][f] = v end
  end
  N.STYLE = {
    bloom = { text = 62, col = Color3.fromRGB(255, 105, 180), stroke = Color3.fromRGB(110, 0, 66), sample = "PINK BLOOM", tag = "Pink Bloom" },
    -- smiley: [Smile icon] +amount, in the game's honey-label colours (rgb 255,226,128 / near-black stroke)
    smiley = { text = 50, col = Color3.fromRGB(255, 226, 128), stroke = Color3.fromRGB(14, 13, 12), sample = "+1.23B", tag = "Smiley notify", icon = true },
  }
  N.HONEY, N.HSTROKE = Color3.fromRGB(255, 226, 128), Color3.fromRGB(14, 13, 12)
  N.iconAsset = nil
  function N.asset()
    if N.iconAsset then return N.iconAsset end
    local ok, a = pcall(btAsset, PACK.smile, nil)
    if ok and type(a) == "string" and a ~= "" then N.iconAsset = a end
    return N.iconAsset or ""
  end
  task.spawn(N.asset) -- load the icon from the local cache in the background (BuffTools/icons_r2/Smile.png)

  -- icon sits left of the centred amount text; call after the text is set
  function N.iconAt(icon, lab)
    local tb = lab.TextBounds.X
    local sz = math.floor(lab.TextSize * 1.15)
    icon.Size = UDim2.fromOffset(sz, sz)
    icon.Position = UDim2.new(0.5, -tb / 2 - 10, 0.5, 0)
  end
  N.SUF = { "", "K", "M", "B", "T", "Qd", "Qn", "Sx", "Sp", "Oc", "No", "Dc" }

  function N.fmt(n)
    n = tonumber(n) or 0
    if n < 1000 then return string.format("%d", math.floor(n + 0.5)) end
    local e = math.min(math.floor(math.log10(n) / 3), #N.SUF - 1)
    local v = n / 10 ^ (e * 3)
    if tonumber(string.format("%.2f", v)) >= 1000 and e < #N.SUF - 1 then
      e = e + 1
      v = n / 10 ^ (e * 3)
    end
    local s = string.format("%.2f", v)
    s = s:gsub("0+$", "")
    s = s:gsub("%.$", "")
    return s .. N.SUF[e + 1]
  end

  function N.save()
    if not canSave then return end
    pcall(function() writefile(N.file, HttpService:JSONEncode(N.cfg)) end)
  end

  function N.load()
    if not canSave then return end
    local ok, v = pcall(function()
      if isfile(N.file) then return HttpService:JSONDecode(readfile(N.file)) end
    end)
    if not ok or type(v) ~= "table" then return end
    for k, c in pairs(N.cfg) do
      local s = v[k]
      if type(s) == "table" then
        if type(s.on) == "boolean" then c.on = s.on end
        if tonumber(s.x) then c.x = math.clamp(tonumber(s.x), 0.03, 0.97) end
        if tonumber(s.y) then c.y = math.clamp(tonumber(s.y), 0.03, 0.97) end
        if tonumber(s.size) then c.size = math.clamp(tonumber(s.size), 0.4, 3) end
      end
    end
  end
  N.load()

  function N.root()
    if N.gui and N.gui.Parent then return N.gui end
    local g = Instance.new("ScreenGui")
    g.Name = "BuffToolsNotify"
    g.ResetOnSpawn = false
    g.IgnoreGuiInset = true
    g.DisplayOrder = 200
    g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    if syn and syn.protect_gui then pcall(function() syn.protect_gui(g) end) end
    g.Parent = player:WaitForChild("PlayerGui")
    N.gui = g
    return g
  end

  -- apply saved position + size to the live banner and to the move preview
  function N.place(kind)
    local c = N.cfg[kind]
    local L = N.labs[kind]
    if L and L.lab.Parent then
      L.lab.Position = UDim2.fromScale(c.x, c.y)
      L.us.Scale = c.size
    end
    local P = N.prev[kind]
    if P and P.fr.Parent then
      P.fr.Position = UDim2.fromScale(c.x, c.y)
      P.us.Scale = c.size
    end
  end

  function N.lab(kind)
    local L = N.labs[kind]
    if L and L.lab.Parent then return L end
    local st = N.STYLE[kind]
    local l = Instance.new("TextLabel")
    l.Name = "Notify_" .. kind
    l.AnchorPoint = Vector2.new(0.5, 0.5)
    l.Size = UDim2.fromOffset(460, 80)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBlack
    l.TextSize = st.text
    l.TextColor3 = st.col
    l.TextStrokeColor3 = st.stroke
    l.TextTransparency, l.TextStrokeTransparency = 1, 1
    l.Parent = N.root()
    local us = Instance.new("UIScale")
    us.Parent = l
    local sub = Instance.new("TextLabel")
    sub.Name = "Sub"
    sub.BackgroundTransparency = 1
    sub.AnchorPoint = Vector2.new(0.5, 0)
    sub.Position = UDim2.new(0.5, 0, 1, -6)
    sub.Size = UDim2.new(1, 0, 0, 24)
    sub.Font = Enum.Font.GothamBold
    sub.TextSize = 20
    sub.TextColor3 = st.icon and N.HONEY or Color3.fromRGB(255, 225, 250)
    sub.TextStrokeColor3 = st.stroke
    sub.TextTransparency, sub.TextStrokeTransparency = 1, 1
    sub.Parent = l
    local icon = nil
    if st.icon then
      icon = Instance.new("ImageLabel")
      icon.Name = "Icon"
      icon.BackgroundTransparency = 1
      icon.AnchorPoint = Vector2.new(1, 0.5)
      icon.Image = N.asset()
      icon.ScaleType = Enum.ScaleType.Fit
      icon.ImageTransparency = 1
      icon.Parent = l
    end
    L = { lab = l, sub = sub, us = us, tok = 0, icon = icon }
    N.labs[kind] = L
    N.place(kind)
    return L
  end

  -- 0.00-0.12 pop in, 0.12-0.70 hold, 0.70-1.00 fade out  (= 1.0s total)
  function N.show(kind, text, subText)
    local c = N.cfg[kind]
    if not c or not c.on then return end
    local L = N.lab(kind)
    local lab, sub = L.lab, L.sub
    L.tok = L.tok + 1
    local my = L.tok
    lab.Text = text
    sub.Text = subText or ""
    N.place(kind)
    lab.TextTransparency, lab.TextStrokeTransparency = 1, 1
    sub.TextTransparency, sub.TextStrokeTransparency = 1, 1
    local icon = L.icon
    if icon then
      if icon.Image == "" then icon.Image = N.asset() end
      icon.ImageTransparency = 1
      N.iconAt(icon, lab)
    end
    lab.Size = UDim2.fromOffset(380, 66)
    local tin = TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    TweenService:Create(lab, tin, { TextTransparency = 0, TextStrokeTransparency = 0.1, Size = UDim2.fromOffset(460, 80) }):Play()
    TweenService:Create(sub, tin, { TextTransparency = 0, TextStrokeTransparency = 0.3 }):Play()
    if icon then TweenService:Create(icon, tin, { ImageTransparency = 0 }):Play() end
    task.delay(0.7, function()
      if L.tok ~= my or not lab.Parent then return end
      local tout = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
      TweenService:Create(lab, tout, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
      TweenService:Create(sub, tout, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
      if icon then TweenService:Create(icon, tout, { ImageTransparency = 1 }):Play() end
    end)
    task.delay(1.0, function()
      if L.tok ~= my or not lab.Parent then return end
      lab.TextTransparency, lab.TextStrokeTransparency = 1, 1
      sub.TextTransparency, sub.TextStrokeTransparency = 1, 1
      if icon then icon.ImageTransparency = 1 end
    end)
  end

  -- Move mode: both banners stay on screen as draggable frames showing where / how big they will appear
  function N.preview(on)
    N.previewOn = on == true
    N.drag = nil
    N.prev = {}
    if N.pgui then pcall(function() N.pgui:Destroy() end) N.pgui = nil end
    if not N.previewOn then return end
    local g = Instance.new("ScreenGui")
    g.Name = "BuffToolsNotifyPreview"
    g.ResetOnSpawn = false
    g.IgnoreGuiInset = true
    g.DisplayOrder = 210
    g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    if syn and syn.protect_gui then pcall(function() syn.protect_gui(g) end) end
    g.Parent = player:WaitForChild("PlayerGui")
    N.pgui = g
    for _, kind in ipairs({ "bloom", "smiley" }) do
      local st, c = N.STYLE[kind], N.cfg[kind]
      local fr = Instance.new("Frame")
      fr.Name = "Prev_" .. kind
      fr.AnchorPoint = Vector2.new(0.5, 0.5)
      fr.Size = UDim2.fromOffset(460, 80)
      fr.BackgroundColor3 = st.stroke
      fr.BackgroundTransparency = 0.45
      fr.BorderSizePixel = 0
      fr.Active = true
      fr.Parent = g
      Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 10)
      local us = Instance.new("UIScale")
      us.Parent = fr
      local sk = Instance.new("UIStroke")
      sk.Color = st.col
      sk.Thickness = 2
      sk.Parent = fr
      local t = Instance.new("TextLabel")
      t.BackgroundTransparency = 1
      t.Size = UDim2.fromScale(1, 1)
      t.Font = Enum.Font.GothamBlack
      t.TextSize = st.text
      t.TextColor3 = st.col
      t.TextStrokeColor3 = st.stroke
      t.TextStrokeTransparency = 0.1
      t.Text = st.sample
      t.Parent = fr
      if st.icon then
        local ic = Instance.new("ImageLabel")
        ic.BackgroundTransparency = 1
        ic.AnchorPoint = Vector2.new(1, 0.5)
        ic.Image = N.asset()
        ic.ScaleType = Enum.ScaleType.Fit
        ic.Parent = fr
        N.iconAt(ic, t)
      end
      local tag = Instance.new("TextLabel")
      tag.BackgroundTransparency = 1
      tag.AnchorPoint = Vector2.new(0.5, 1)
      tag.Position = UDim2.new(0.5, 0, 0, -4)
      tag.Size = UDim2.new(1, 0, 0, 18)
      tag.Font = Enum.Font.GothamBold
      tag.TextSize = 14
      tag.TextColor3 = Color3.fromRGB(255, 244, 244)
      tag.TextStrokeTransparency = 0.4
      tag.Text = st.tag .. "  -  drag to move"
      tag.Parent = fr
      N.prev[kind] = { fr = fr, us = us }
      N.place(kind)
      fr.InputBegan:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        N.drag = { kind = kind, start = inp.Position, x0 = c.x, y0 = c.y }
        local endConn
        endConn = inp.Changed:Connect(function()
          if inp.UserInputState ~= Enum.UserInputState.End then return end
          N.drag = nil
          endConn:Disconnect()
          N.save()
        end)
      end)
    end
  end

  Session.track(UIS.InputChanged:Connect(function(inp)
    local D = N.drag
    if not D then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    local cam = currentCamera()
    local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local d = inp.Position - D.start
    local c = N.cfg[D.kind]
    c.x = math.clamp(D.x0 + d.X / vp.X, 0.03, 0.97)
    c.y = math.clamp(D.y0 + d.Y / vp.Y, 0.03, 0.97)
    N.place(D.kind)
  end))

  function N.resetPos(kind)
    local c, d = N.cfg[kind], N.DEF[kind]
    c.x, c.y = d.x, d.y
    N.place(kind)
    N.save()
  end

  function N.setSize(kind, v)
    N.cfg[kind].size = math.clamp(math.floor(v * 100 + 0.5) / 100, 0.4, 3)
    if kind == "slog" then
      local P = FieldFx.SmilePanel
      if P and P.applyScale then P.applyScale() end
    else
      N.place(kind)
    end
    N.save()
  end

  -- Smiley logs: sum the Give burst of one Smile token pick, then show its honey once
  function N.onGive(act, d)
    if act ~= "Give" or type(d) ~= "table" or d.C ~= "Pollen" then return end
    if FieldFx.PStats.key(d.g) ~= "Smile" then return end
    local pollen = tonumber(d.R)
    if not pollen then pollen = (tonumber(d.A) or 0) + (tonumber(d.c) or 0) end
    if pollen <= 0 then return end
    local S = N.smile
    S.pollen = S.pollen + pollen
    S.tok = S.tok + 1
    local my = S.tok
    task.delay(0.35, function()
      if S.tok == my then pcall(N.flush) end
    end)
  end

  function N.flush()
    local S = N.smile
    local pollen = S.pollen
    S.pollen, S.honey = 0, 0
    if pollen <= 0 then return end
    local PS = FieldFx.PStats
    local rate = PS.hpp
    if not rate and PS.pol.total > 0 then rate = (PS.hon.total or 0) / PS.pol.total end
    local honey = pollen * (rate or 0)
    if honey <= 0 then return end
    local amt = honey
    S.picks = S.picks + 1
    S.total = S.total + amt
    S.last = amt
    local main = honey
    local subText = "#" .. S.picks .. "  -  total " .. N.fmt(S.total)
    if N.cfg.smiley.on then
      print(string.format("[BuffTools] smiley #%d: +%s (session total %s)", S.picks, N.fmt(main), N.fmt(S.total)))
    end
    N.show("smiley", "+" .. N.fmt(main), subText)
    -- right-edge log (built next to the Scorch log, see FieldFx.SmilePanel)
    local P = FieldFx.SmilePanel
    if P and P.add then pcall(P.add, main) end
  end

  -- empties the right-edge Smiley log and the session counters (HUD tab + Notify tab buttons)
  function N.clearLog()
    local P = FieldFx.SmilePanel
    if P and P.clear then P.clear() end
    local S = N.smile
    S.picks, S.total, S.last = 0, 0, 0
  end

  function N.destroy()
    N.drag = nil
    N.prev = {}
    N.labs = {}
    if N.gui then pcall(function() N.gui:Destroy() end) N.gui = nil end
    if N.pgui then pcall(function() N.pgui:Destroy() end) N.pgui = nil end
  end
  Session.track({ Disconnect = N.destroy })
end

-- Pink Bloom (bloom_dump): Workspace.Happenings.PoppablePlants.Bloom (Model) with "Petal" UnionOperations.
-- A Pink Bloom has pink petals: Color3.fromRGB(255, 130, 201) (== ReplicatedStorage.PetalTypes.Pink.Color).
-- Pink one gets a neon Highlight outline + a centered "PINK BLOOM" banner for 1.0s (once per bloom).
-- Kept inside a do-block: the main chunk is close to Lua's 200-locals limit.
do
  local PB = { state = setmetatable({}, { __mode = "k" }), hl = {}, shown = 0 }
  FieldFx.PinkBloom = PB
  local PINK = { 255, 130, 201 }
  local TOL = 8

  local function isPinkPart(p)
    local ok, c = pcall(function() return p.Color end)
    if not ok or typeof(c) ~= "Color3" then return false end
    return math.abs(c.R * 255 - PINK[1]) <= TOL
      and math.abs(c.G * 255 - PINK[2]) <= TOL
      and math.abs(c.B * 255 - PINK[3]) <= TOL
  end

  -- Only Pepper Patch counts: Workspace.FlowerZones["Pepper Patch"] box (XZ + margin).
  -- Player away from the field -> nothing is scanned (slow 1s poll), highlights are dropped.
  PB.near, PB.zoneAt = false, -99

  function PB.findZone()
    local z = PB.zone
    if z and z.Parent then return z end
    PB.zone, PB.zcf, PB.zsize = nil, nil, nil
    local now = os.clock()
    if now - PB.zoneAt < 2 then return nil end
    PB.zoneAt = now
    local zones = Workspace:FindFirstChild("FlowerZones")
    if not zones then return nil end
    for _, ch in ipairs(zones:GetChildren()) do
      local n = string.lower(ch.Name)
      if n == "pepper patch" or n == "pepperpatch" or n == "pepper field" then
        local cf, size
        if ch:IsA("BasePart") then
          cf, size = ch.CFrame, ch.Size
        elseif ch:IsA("Model") then
          local ok, c, s = pcall(function() return ch:GetBoundingBox() end)
          if ok then cf, size = c, s end
        end
        if cf and size then
          PB.zone, PB.zcf, PB.zsize = ch, cf, size
          return ch
        end
      end
    end
    return nil
  end

  function PB.inZone(pos, margin)
    local cf, size = PB.zcf, PB.zsize
    if not cf or not pos then return false end
    local lp = cf:PointToObjectSpace(pos)
    return math.abs(lp.X) <= size.X * 0.5 + margin
      and math.abs(lp.Z) <= size.Z * 0.5 + margin
      and math.abs(lp.Y) <= size.Y * 0.5 + 150
  end

  function PB.isPink(model)
    local petals = 0
    for _, d in ipairs(model:GetDescendants()) do
      if d.Name == "Petal" and d:IsA("BasePart") then
        petals = petals + 1
        if isPinkPart(d) then return true, petals end
      end
    end
    return false, petals
  end

  function PB.banner()
    FieldFx.Notif.show("bloom", "PINK BLOOM") -- position / size / on-off come from the Notify tab
  end

  function PB.mark(model)
    local h = Instance.new("Highlight")
    h.Name = "BTPinkBloom"
    h.Adornee = model
    h.FillColor = Color3.fromRGB(255, 105, 180)
    h.OutlineColor = Color3.fromRGB(255, 20, 147)
    h.FillTransparency = 0.65
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = Workspace:FindFirstChild("BuffToolsBeams") or Workspace.CurrentCamera or Workspace
    PB.hl[model] = h
  end

  function PB.drop(model)
    local h = PB.hl[model]
    PB.hl[model] = nil
    if h then pcall(function() h:Destroy() end) end
  end

  -- Petals that fly out of a popped Pink Bloom: Workspace.Particles.PetalPart (MeshPart, rgb(255,130,201)).
  -- Bright pink fill + white outline through walls so they are easy to spot and collect.
  PB.petals, PB.petalN = {}, 0

  function PB.petalDrop(part)
    local h = PB.petals[part]
    if not h then return end
    PB.petals[part] = nil
    PB.petalN = PB.petalN - 1
    pcall(function() h:Destroy() end)
  end

  function PB.petal(part)
    if not PB.near or PB.petals[part] or PB.petalN >= 20 then return end -- Roblox allows ~31 Highlights in total
    if part.Name ~= "PetalPart" or not part:IsA("BasePart") then return end
    if not PB.inZone(part.Position, 60) or not isPinkPart(part) then return end
    local h = Instance.new("Highlight")
    h.Name = "BTPinkPetal"
    h.Adornee = part
    h.FillColor = Color3.fromRGB(255, 105, 180)
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.FillTransparency = 0.25
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = Workspace:FindFirstChild("BuffToolsBeams") or Workspace.CurrentCamera or Workspace
    PB.petals[part] = h
    PB.petalN = PB.petalN + 1
    part.AncestryChanged:Connect(function(_, parent)
      if not parent then PB.petalDrop(part) end
    end)
  end

  function PB.step()
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    PB.near = PB.findZone() ~= nil and root ~= nil and PB.inZone(root.Position, 70)
    if not PB.near then
      for m in pairs(PB.hl) do PB.drop(m) end
      for p in pairs(PB.petals) do PB.petalDrop(p) end
      return
    end
    -- ChildAdded (PB.start) catches petals live; this full scan is only a ~1s fallback (Particles can hold thousands of parts)
    PB.scanN = (PB.scanN or 0) + 1
    local particles = PB.scanN % 4 == 1 and Workspace:FindFirstChild("Particles")
    if particles then
      for _, ch in ipairs(particles:GetChildren()) do
        if ch.Name == "PetalPart" then PB.petal(ch) end
      end
    end
    for part in pairs(PB.petals) do
      if not part.Parent then PB.petalDrop(part) end
    end
    local hap = Workspace:FindFirstChild("Happenings")
    local folder = hap and hap:FindFirstChild("PoppablePlants")
    local live = {}
    if folder then
      for _, m in ipairs(folder:GetChildren()) do
        local okp, piv = pcall(function() return m:IsA("Model") and m:GetPivot().Position end)
        if okp and piv and PB.inZone(piv, 40) then
          live[m] = true
          local st = PB.state[m]
          if not st then
            st = { pink = false, checks = 0, born = os.clock() }
            PB.state[m] = st
          end
          if st.pink and not PB.hl[m] then
            PB.mark(m) -- came back to the field: outline again, no second banner
          elseif not st.pink and st.checks < 10 then
            st.checks = st.checks + 1
            local pink, petals = PB.isPink(m)
            if petals == 0 then st.checks = st.checks - 1 end -- petals not replicated yet: don't burn a check
            if pink then
              st.pink = true
              PB.mark(m)
              PB.shown = PB.shown + 1
              pcall(PB.banner)
            end
          end
        end
      end
    end
    for m in pairs(PB.hl) do
      if not live[m] or not m.Parent then PB.drop(m) end
    end
  end

  function PB.start()
    local acc = 0
    Session.track(RunService.Heartbeat:Connect(function(dt)
      if not Session.alive then return end
      acc = acc + dt
      if acc < (PB.near and 0.25 or 1.0) then return end
      acc = 0
      pcall(PB.step)
    end))
    -- catch petals the moment they spawn (they can live well under the 0.25s poll)
    task.spawn(function()
      local particles = Workspace:WaitForChild("Particles", 30)
      if not particles or not Session.alive then return end
      Session.track(particles.ChildAdded:Connect(function(ch)
        if ch.Name ~= "PetalPart" or not PB.near then return end
        task.defer(function() pcall(PB.petal, ch) end)
      end))
    end)
    Session.track({ Disconnect = function()
      for m in pairs(PB.hl) do PB.drop(m) end
      for p in pairs(PB.petals) do PB.petalDrop(p) end
    end })
  end
  PB.start()
end

-- Pollen by ability (stats_dump): ServerItemPackEvent "Give" {C="Pollen", R=total, A+c=R, g={tags..., source}}
-- g ends with the source: {"Dark Scythe","Tool"}, {"Movement Collection"}, {..., "Bee Gather"}, {"Target Practice"} ...
-- sources_dump: the tag list is NOT "source last". Examples:
--   Smile:  {Bee Ability, Event Bee Ability, Smile, Bee, Digital Bee, ... Gifted Bee}
--   Target Practice: {Bee Ability, Target Practice, Red Ability, Bee, Precise Bee, ...}
--   Flame / Mark Surge / Triangulate / Scratch / Red Pulse: {<name>, <colour> Ability, Bee, ...}
--   Bomb: {Bomb, Red Bomb, ...}   Tool: {Dark Scythe, Tool}   Bee Gather: {Bee, ..., Bee Gather}
--   a trailing "Duped Ability" means the pollen came from a duped copy of the token
FieldFx.PStats = {
  since = os.clock(),
  hon = { tot = {}, total = 0, n = 0, dup = 0, smilePicks = 0, lastSmile = -99, direct = {}, convert = 0, got = {} },
  pol = { tot = {}, total = 0, n = 0, dup = 0, smilePicks = 0, lastSmile = -99, direct = {}, convert = 0, got = {} },
  weights = {}, weightC = 0, paid = false, held = 0, hpp = nil,
}
FieldFx.PStats.reset = function()
  local P = FieldFx.PStats
  P.since = os.clock()
  P.weights, P.weightC, P.paid, P.held, P.hpp = {}, 0, false, 0, nil
  for _, b in ipairs({ P.hon, P.pol }) do
    b.tot, b.total, b.n, b.dup, b.smilePicks, b.lastSmile = {}, 0, 0, 0, 0, -99
    b.direct, b.convert, b.got = {}, 0, {}
  end
end
FieldFx.PStats.key = function(g)
  if type(g) == "string" and g ~= "" then return g end -- e.g. g = "Star Saw"
  if type(g) ~= "table" then return "Other" end
  local arr = {}
  if #g > 0 then
    for i = 1, #g do arr[i] = g[i] end
  else
    -- honey Give events sometimes ship tags as a dict, not a list
    for _, v in pairs(g) do
      if type(v) == "string" then arr[#arr + 1] = v end
    end
  end
  if #arr == 0 then return "Other" end
  local n = #arr
  for i = 1, n do
    if arr[i] == "Tool" and type(arr[1]) == "string" and arr[1] ~= "Tool" then return "Tool = " .. arr[1] end
  end
  if arr[1] == "Bomb" and type(arr[2]) == "string" then return "Bomb = " .. arr[2] end
  if arr[n] == "Bee Gather" then return "Bee Gather" end
  for i = 1, n do
    if arr[i] == "Planter" then return "Planter" end
    if arr[i] == "Bubble" then return "Bubble" end
  end
  for i = 1, n do
    local s = arr[i]
    if type(s) == "string" and s ~= "Bee" and not s:find(" Ability$") then return s end
  end
  return "Other"
end
-- Honey formula (honey_formula_dump, same session the leaderstat matched honey A exactly):
--   pollen R = total, c = instant-converted pollen, A = backpack (hive take sums to A).
--   the honey packet right after a pollen batch equals sum(c) * honeyPerPollen.
--   honeyPerPollen was 1.449 on the first pairs and ~1.55 across that session. It moves with buffs
--   (other sessions were 1.74 and 1.81). It is one rate for every ability.
--   S honey (Flame Fuel, blooms, ...) is extra and not part of c.
FieldFx.PStats.honeySource = function(d)
  local P = FieldFx.PStats
  if type(d.S) == "string" and d.S ~= "" and d.S ~= "Honey" then return d.S end
  local g = d.g
  if type(g) == "string" or type(g) == "table" then
    local k = P.key(g)
    if k ~= "Other" then return k end
  end
  return nil
end
-- A pollen wave is every collect until the next honey packet. That packet and any honey
-- after it, until the next collect, belong to this wave and are split by c. Nothing is left over.
FieldFx.PStats.pay = function(amt)
  local P = FieldFx.PStats
  local wc = P.weightC
  if type(amt) ~= "number" or amt <= 0 or wc <= 0 then return false end
  local got = P.hon.got
  for k, c in pairs(P.weights) do
    got[k] = (got[k] or 0) + amt * (c / wc)
  end
  return true
end
FieldFx.PStats.notePollen = function(k, c)
  if type(c) ~= "number" or c <= 0 or type(k) ~= "string" then return end
  local P = FieldFx.PStats
  if P.paid then
    P.weights, P.weightC, P.paid = {}, 0, false
  end
  P.weights[k] = (P.weights[k] or 0) + c
  P.weightC = P.weightC + c
  if P.held > 0 then
    P.pay(P.held)
    P.held = 0
  end
end
FieldFx.PStats.noteInstant = function(amt)
  local P = FieldFx.PStats
  if not P.pay(amt) then
    P.held = P.held + amt
    return true
  end
  P.paid = true
  return true
end
-- Rows: honey paired to the pollen that made it, plus S honey. Anything still loose is shared by pollen R.
FieldFx.PStats.honeyRows = function()
  local P = FieldFx.PStats
  local h, p = P.hon, P.pol
  local merged = {}
  local function add(k, v)
    if type(k) == "string" and type(v) == "number" and v > 0 then merged[k] = (merged[k] or 0) + v end
  end
  for k, v in pairs(h.got or {}) do add(k, v) end
  for k, v in pairs(h.direct or {}) do add(k, v) end
  local convert = h.convert or 0
  if convert > 0 and p.total > 0 then
    for k, v in pairs(p.tot) do add(k, convert * (v / p.total)) end
  elseif convert > 0 then
    add("Convert", convert)
  end
  local keys = {}
  for k in pairs(merged) do keys[#keys + 1] = k end
  table.sort(keys, function(a, b) return merged[a] > merged[b] end)
  local rows = {}
  for i, k in ipairs(keys) do
    local nm = k
    if k == "Smile" and p.smilePicks > 0 then nm = k .. " ×" .. tostring(p.smilePicks) end
    rows[i] = { nm, merged[k] }
  end
  local directSum = 0
  for _, v in pairs(h.direct or {}) do directSum = directSum + v end
  local fromPollen = math.max(0, (h.total or 0) - directSum)
  local dup = (p.total > 0) and (fromPollen * (p.dup / p.total)) or 0
  return rows, h.total or 0, dup, convert
end
-- Session honey AND pollen by ability (ServerItemPackEvent "Give", C="Honey" or C="Pollen").
-- The Stats tab switches which bag it shows. Smiley banner reads Smile pollen on its own.
FieldFx.PStats.add = function(act, d)
  pcall(FieldFx.Notif.onGive, act, d) -- Smiley logs (own debounce, independent of the stats below)
  if act ~= "Give" or type(d) ~= "table" then return end
  if d.C ~= "Honey" and d.C ~= "Pollen" then return end
  local P = FieldFx.PStats
  if d.C == "Honey" then
    local amt = tonumber(d.A) or 0
    if amt <= 0 then return end
    local b = P.hon
    local src = P.honeySource(d)
    b.total = b.total + amt
    b.n = b.n + 1
    if src then
      b.direct[src] = (b.direct[src] or 0) + amt
    else
      P.noteInstant(amt)
    end
    if P.pol.total > 0 then P.hpp = b.total / P.pol.total end
    return
  end
  local amt = tonumber(d.R)
  if not amt then amt = (tonumber(d.A) or 0) + (tonumber(d.c) or 0) end
  if amt <= 0 then return end
  local b = P.pol
  local k = P.key(d.g)
  P.notePollen(k, tonumber(d.c) or 0)
  b.tot[k] = (b.tot[k] or 0) + amt
  b.total = b.total + amt
  b.n = b.n + 1
  if type(d.g) == "table" then
    for i = 1, #d.g do
      if d.g[i] == "Duped Ability" then b.dup = b.dup + amt break end
    end
  end
  if k == "Smile" then
    local now = os.clock()
    if now - b.lastSmile > 0.8 then b.smilePicks = b.smilePicks + 1 end
    b.lastSmile = now
  end
  if b.total > 0 and P.hon.total > 0 then P.hpp = P.hon.total / b.total end
end

-- Lifetime pollen by tag (sources_dump): player data Totals.Pollen.ByTag {tag = pollen}, Totals.Pollen.All = total.
-- ByTag counts EVERY tag of a hit (bee types, colours...), so only ability-like tags are kept; every hit has exactly one
-- ability tag, so the kept rows add up to ~Totals.Pollen.All (that is the "pollen by ability" table).
FieldFx.PStats.TOOL_WORDS = { "Scythe", "Dipper", "Rake", "Staff", "Wand", "Scoop", "Magnet", "Vacuum", "Ballooner" }
-- ability_dump: "Gold Bubble" (inside Bubble), "Planter" (= sum of the *Planter variants), "Bomb" (= sum of the *Bomb variants)
-- and "Tool" (= sum of the tools) are parents, so only one level is counted; with that the rows add up to Pollen.All.
-- Collectibles holds token pick counts: "Smile Token", "Target Practice", "Red Bomb" ... -> returned as the 3rd value of a row.
FieldFx.PStats.TOKEN_KEY = {
  ["Smile"] = "Smile Token", ["Target Practice"] = "Target Practice", ["Triangulate"] = "Triangulate",
  ["Mark Surge"] = "Mark Surge", ["Red Pulse"] = "Red Pulse", ["Blue Pulse"] = "Blue Pulse", ["Scratch"] = "Scratch",
  ["Beamstorm"] = "Beamstorm", ["Meteor"] = "Meteor", ["Fetch"] = "Fetch", ["Tornado"] = "Tornado",
  ["Falling Coconut"] = "Falling Coconut",
}
FieldFx.PStats.lifeRows = function(bt, all, col)
  local P = FieldFx.PStats
  local rows, sum = {}, 0
  local minV = (all or 0) * 1e-4 -- below 0.01% goes to "Other"
  local function add(name, v, tokKey)
    if v <= 0 or v < minV then return end
    local cnt = nil
    if tokKey and type(col) == "table" then
      local n = tonumber(rawget(col, tokKey))
      if n and n > 0 then cnt = n end
    end
    rows[#rows + 1] = { name, v, cnt }
    sum = sum + v
  end
  for k, v in pairs(bt) do
    if type(k) == "string" and type(v) == "number" and v > 0 then
      if k == "Bee" or k == "Tool" or k == "Bomb" or k == "Gold Bubble" or k:find(" Bee$") or k:find(" Ability$") then
        -- generic / bee type / colour tag / subtype: not a source
      elseif k:find(" Bomb$") or k:find(" Bomb%+$") then
        add("Bomb = " .. k, v, k)
      elseif k:find(" Planter$") then
        -- variants of "Planter"
      else
        local isTool = false
        for _, w in ipairs(P.TOOL_WORDS) do
          if k:find(w, 1, true) then isTool = true break end
        end
        if isTool then add("Tool = " .. k, v)
        else add(k, v, P.TOKEN_KEY[k]) end
      end
    end
  end
  table.sort(rows, function(a, b) return a[2] > b[2] end)
  local total = all or sum
  if total > sum * 1.001 then rows[#rows + 1] = { "Other", total - sum } end
  return rows, total
end
-- Lifetime honey split by ability is not in Totals.Pollen (that table is pollen).
-- If the save ever grows a Honey.ByTag (or another Totals table with ByTag and "Honey" in the name), use it.
-- Otherwise the lifetime view says so, and the session counter is the live honey.
FieldFx.PStats.loadLifetime = function()
  if type(getgc) ~= "function" then return nil, "getgc is not available in this executor" end
  local bestH, bestCol, bestAll = nil, nil, -1
  local ok, err = pcall(function()
    local uid = player.UserId
    for _, t in ipairs(getgc(true)) do
      if type(t) == "table" then
        local tot = rawget(t, "Totals")
        if type(tot) == "table" then
          local u = rawget(t, "UserId")
          if u == nil or u == uid then
            local function consider(h)
              if type(h) ~= "table" then return end
              local all, bt = rawget(h, "All"), rawget(h, "ByTag")
              if type(bt) == "table" and type(all) == "number" and all > bestAll then
                bestAll, bestH, bestCol = all, h, rawget(tot, "Collectibles")
              end
            end
            local honey = rawget(tot, "Honey")
            if type(honey) == "table" then consider(honey) end
            for k, v in pairs(tot) do
              if type(k) == "string" and type(v) == "table" and k:lower():find("honey", 1, true) then
                consider(v)
              end
            end
          end
        end
      end
    end
  end)
  if not ok then return nil, tostring(err) end
  if not bestH then return nil, "lifetime honey per ability is not stored — session counts honey since inject" end
  return { hon = bestH, col = bestCol, at = os.clock() }
end
FieldFx.PStats.lifeView = function(life)
  local h = life.hon
  local all, bt = tonumber(rawget(h, "All")) or 0, rawget(h, "ByTag")
  if type(bt) ~= "table" then return {}, 0 end
  return FieldFx.PStats.lifeRows(bt, all, life.col)
end

-- Each stream is hooked at most once; hookStreams() is retried (see below) because on a fresh join the
-- Events folder / remotes may not exist yet when the script is injected (that left buffs/tokens dead
-- until "Reload script").
Streams.hooked = {}
local function hookStreams()
  local events = ReplicatedStorage:FindFirstChild("Events")
  if not events then return false end
  local H = Streams.hooked
  local function one(name, flag, handler)
    if H[name] then return end
    local r = events:FindFirstChild(name)
    if r and r:IsA("RemoteEvent") then
      H[name] = true
      Session.track(r.OnClientEvent:Connect(handler))
      if flag then Streams[flag] = true end
    end
  end
  pcall(function()
    one("ServerBuffEvent", "buff", function(...) onBuffEvent(...) end)
    one("PlayerAbilityEvent", "ability", function(...) onAbilityEvent(...) end)
    one("CollectibleEvent", "collectible", function(...)
      local args = { ... }
      onCollectibleEvent(args[1], args[2])
    end)
    one("ServerAbilityTokenEvent", "tokens", function(...) onTokenEvent(...) end)
    one("ServerItemPackEvent", nil, function(act, d) pcall(FieldFx.PStats.add, act, d) end)
    one("DupedTokenCreate", nil, function(d) pcall(FieldFx.Dupe.onCreate, d) end)
    one("DupedTokenCharge", nil, function(id, st) pcall(FieldFx.Dupe.onCharge, id, st) end)
    one("DupedTokenDestroy", nil, function(id) pcall(FieldFx.Dupe.drop, id) end)
    local lfx = events:FindFirstChild("LocalFX")
    if lfx and lfx:IsA("RemoteEvent") then
      hookFxRemote(lfx)
    end
  end)
  pcall(function()
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
      if d.Name == "LocalFX" and d:IsA("RemoteEvent") then
        hookFxRemote(d)
      end
    end
  end)
  return H.ServerBuffEvent and H.PlayerAbilityEvent and H.CollectibleEvent and H.ServerAbilityTokenEvent and H.DupedTokenCreate and H.DupedTokenCharge and H.DupedTokenDestroy and true or false
end
hookStreams()
task.spawn(function()
  -- keep retrying for ~2 minutes until every stream is hooked
  for _ = 1, 60 do
    if not Session.alive then return end
    if hookStreams() then return end
    task.wait(2)
  end
end)


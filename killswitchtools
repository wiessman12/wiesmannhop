  f.Size = UDim2.fromOffset(250, 72)
  local p = savedPos[id]
  f.Position = p and UDim2.new(p.sx or 0, p.x, p.sy or 0, p.y) or UDim2.fromOffset(16, 60 + (index - 1) * 78)
  f.BorderSizePixel = 0
  f.Active = true
  f.Parent = gui
  f.BackgroundTransparency = 1
  makeDraggable(f)

  local badge = Instance.new("Frame")
  badge.Size = UDim2.fromOffset(42, 42)
  badge.Position = UDim2.new(0, 0, 0, 10)
  badge.BackgroundTransparency = 1

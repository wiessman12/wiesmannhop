local function rememberBeamIcon(name, icon)
  local kind, morphName = kindFromName(name)
  local id = iconId(icon)
  if not kind or not id then return kind, morphName end
  if kind == "morph" then
    MorphIcons[id] = morphName
  elseif kind == "inspire" then
    IconMap.inspire = id
  elseif kind == "baby" then
    IconMap.baby = id
  elseif kind == "link" then
    -- never learn a link id that is already another token's face
    if id ~= KNOWN_INSPIRE_ID and id ~= KNOWN_BABY_ID and id ~= KNOWN_PRECISION_ID and id ~= FieldFx.SMILE_ID and not KNOWN_MORPH_ICONS[id] and id ~= IconMap.inspire and id ~= IconMap.baby and id ~= IconMap.precision and id ~= IconMap.smile and id ~= iconId(IconMap.target) then
      IconMap.link = id
    end
  elseif kind == "precision" then
    IconMap.precision = id
  elseif kind == "target" then
    IconMap.target = id
  elseif kind == "smile" then
    IconMap.smile = id
  end
  return kind, morphName
end
local MorphTrack = {
  waits = {},
  waitStart = os.clock(),
  lastTokenAt = nil,
  morphing = false,
  lastName = nil,
  p1 = 18, p2 = 56, p3 = 170,

function Webhook.tickBoostRun()
  if not ExtraUI.boost.run then return end
  local run = ExtraUI.boostRun
  if run.boostHooked then return end
  local started = run.boostStartedAt
  if type(started) ~= "number" then return end
  local needMin = tonumber(Session.webhookBoostMinutes) or 20
  local elapsed = (os.clock() - started) / 60
  if elapsed >= needMin then
    run.boostHooked = true
    local beforeH, nowH, gained
    pcall(function()
      beforeH = run.honeyStart
      nowH = getHoney() or HoneySt.seen
      if type(beforeH) == "number" and type(nowH) == "number" then
        gained = nowH - beforeH
      end
    end)
    local fields = {
      { name = "Time", value = "**" .. string.format("%.0f", elapsed) .. " min**", inline = true },
      { name = "Honey before", value = type(beforeH) == "number" and ("**" .. fmtHoney(beforeH) .. "**") or "—", inline = true },
      { name = "Honey now", value = type(nowH) == "number" and ("**" .. fmtHoney(nowH) .. "**") or "—", inline = true },
    }
    if type(gained) == "number" then
      local sign = gained >= 0 and "+" or ""
      fields[#fields + 1] = {
        name = "Gained",
        value = "**" .. sign .. fmtHoney(gained) .. "**",
        inline = true,
      }
    end
    Webhook.event(
      "boost_min_" .. tostring(math.floor(needMin)) .. "_" .. tostring(player.UserId) .. "_" .. tostring(math.floor(started)),
      "Enable boost · " .. tostring(math.floor(needMin)) .. "+ min",
      "**" .. player.Name .. "** finished a boost run.",
      Webhook.COLOR,
      {
        thumbnail = Webhook.IMG_BOOST,
        fields = fields,
        author = {
          name = player.Name,
          icon_url = Webhook.IMG_EXTRACT,
        },
      }
    )
  end
end


local Sched = { lastGui = 0, lastGc = os.clock(), phaseStart = os.clock() }

-- initial scan right away; lastGc blocks the poll loop from repeating it immediately
task.spawn(function()
  pcall(gcScan)
end)

task.spawn(function()
  while Session.alive and gui.Parent do
    local okLoop, errLoop = pcall(function()
      local now = os.clock()

      if now - Sched.lastGui >= Config.GUI_SCAN_INTERVAL then
        Sched.lastGui = now
        guiScan()
      end

      local learned = essentialsLearned()
      local inLearnPhase = (now - Sched.phaseStart) < Config.LEARN_PHASE_TIME
      local gcInterval = nil
      if not learned then
        if inLearnPhase then
          gcInterval = 15
        elseif (Sched.slowPasses or 0) < 3 then
          gcInterval = 30
        end
      end
      if gcInterval and now - Sched.lastGc >= gcInterval then
        Sched.lastGc = now
        if not inLearnPhase then
          Sched.slowPasses = (Sched.slowPasses or 0) + 1
        end
        gcScan()
      end

      -- every stage is isolated: an error in one of them must never freeze the others (auto-use chips, boost, ping)
      local function stage(name, fn, ...)
        local okS, errS = pcall(fn, ...)
        if not okS then
          local key = name .. tostring(errS)
          if Sched.lastStageErr ~= key then
            Sched.lastStageErr = key
            log("loop stage '" .. name .. "' error:", errS)
          end
        end
      end
      stage("readAll", readAll)
      if now - (Sched.lastWorld or 0) >= 0.7 then
        Sched.lastWorld = now
        stage("scanWorldTokens", scanWorldTokens)
        stage("reclassifyTokens", reclassifyTokens)
      end
      stage("renderTiles", renderTiles)
      stage("ExtraUI.tick", ExtraUI.tick, now)
      if now - Region.lastPing >= 1 then
        Region.lastPing = now
        stage("ping", Region.paintPing)
      end
    end)
    if not okLoop then
      log("loop error:", errLoop)
    end
    task.wait(Config.POLL_INTERVAL)
  end
end)


local function placeOutlineSeg(part, a, b)
  local dx, dz = b.X - a.X, b.Z - a.Z
  local len = math.sqrt(dx * dx + dz * dz)
  if len < 0.12 then
    hidePuddle(part)
    return
  end
  local mid = Vector3.new((a.X + b.X) * 0.5, a.Y, (a.Z + b.Z) * 0.5)
  local look = Vector3.new(b.X, a.Y, b.Z)
  part.Size = Vector3.new(0.55, 1.15, len + 0.08)
  part.Color = Farm.green
  part.Transparency = 0
  part.CFrame = CFrame.lookAt(mid, look)
end

local function hideOutline()
  for i = 1, #Farm.segs do
    hidePuddle(Farm.segs[i])
  end
end

local function drawOutlineLoop(pts)
  if not pts or #pts < 3 then
    hideOutline()
    return
  end
  local n = #pts
  if n > 56 then
    local slim = {}
    local step = n / 56
    for i = 0, 55 do
      slim[#slim + 1] = pts[math.floor(i * step) + 1]
    end
    pts, n = slim, #slim
  end
  for i = 1, n do
    local a = pts[i]
    local b = pts[i % n + 1]
    placeOutlineSeg(ensureOutlineSeg(i), a, b)
  end
  for i = n + 1, #Farm.segs do
    hidePuddle(Farm.segs[i])
  end
end

local function marksCovering(pos, marks)
  local n = 0
  for _, m in ipairs(marks) do
    local dx = pos.X - m.pos.X
    local dz = pos.Z - m.pos.Z
    if (dx * dx + dz * dz) <= (m.rad * m.rad) then
      n = n + 1
    end
  end
  return n
end


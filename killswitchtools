function MapCut.ensureStore()
  if MapCut.store then return end
  local folder = Instance.new("Folder")
  folder.Name = "BuffToolsMapStore"
  MapCut.store = folder
end

function MapCut.boxOf(inst)
  if inst:IsA("BasePart") then
    return inst.Position, inst.Size * 0.5
  end
  if inst:IsA("Model") then
    local ok, cf, size = pcall(function()
      local c, s = inst:GetBoundingBox()
      return c, s
    end)
    if ok and typeof(cf) == "CFrame" and typeof(size) == "Vector3" then
      return cf.Position, size * 0.5
    end
  end
  return nil, nil
end

function MapCut.isPepper(name)
  local n = string.lower(name)
  return n == "pepper patch" or n == "pepperpatch" or n == "pepper field"
end

function MapCut.isShrine(name)
  local n = string.lower(name)
  return string.find(n, "wind shrine", 1, true) ~= nil or string.find(n, "windshrine", 1, true) ~= nil
end

function MapCut.isCoconutField(name)
  local n = string.lower(name)
  return n == "coconut field" or n == "coconutfield"
end

function MapCut.grow(pos, half)
  local a = pos - half
  local b = pos + half
  local bounds = MapCut.bounds
  if not bounds then
    MapCut.bounds = { min = a, max = b }
    return
  end
  bounds.min = Vector3.new(math.min(bounds.min.X, a.X), math.min(bounds.min.Y, a.Y), math.min(bounds.min.Z, a.Z))
  bounds.max = Vector3.new(math.max(bounds.max.X, b.X), math.max(bounds.max.Y, b.Y), math.max(bounds.max.Z, b.Z))
end

function MapCut.buildBounds()
  local zoneSkip = {
    flowers = true,
    particles = true,
    particleeffects = true,
    debris = true,
    bees = true,
  }
  MapCut.bounds = nil
  local pepperPos, pepperHalf
  local shrinePos, shrineHalf, shrineSize
  local function walk(inst, depth)
    if depth > 8 then return end
    if zoneSkip[string.lower(inst.Name)] then return end
    local pos, half = MapCut.boxOf(inst)
    if pos and half then
      if MapCut.isPepper(inst.Name) then
        pepperPos, pepperHalf = pos, half
      elseif MapCut.isShrine(inst.Name) then
        local mag = half.Magnitude
        if mag < 140 and (not shrineSize or mag < shrineSize) then
          shrinePos, shrineHalf, shrineSize = pos, half, mag
        end
      end
    end
    if inst:IsA("Folder") or inst:IsA("Model") then
      local kids = inst:GetChildren()
      for i = 1, #kids do
        walk(kids[i], depth + 1)
      end
    end
  end
  local roots = Workspace:GetChildren()
  for i = 1, #roots do
    walk(roots[i], 0)
  end

  if pepperPos then
    MapCut.grow(pepperPos, pepperHalf)
  else
    MapCut.grow(Vector3.new(-488.3, 123.7, 529.2), Vector3.new(55, 18, 70))
  end
  if shrinePos then
    MapCut.grow(shrinePos, shrineHalf)
  else
    local bounds = MapCut.bounds
    bounds.min = bounds.min - Vector3.new(48, 16, 48)
    bounds.max = bounds.max + Vector3.new(48, 70, 48)
  end
  MapCut.bounds.min = MapCut.bounds.min - Vector3.new(58, 130, 58)
  MapCut.bounds.max = MapCut.bounds.max + Vector3.new(58, 36, 58)
  return true
end

function MapCut.overlaps(pos, half)
  local bounds = MapCut.bounds
  if not bounds then return false end
  return pos.X + half.X >= bounds.min.X and pos.X - half.X <= bounds.max.X
    and pos.Y + half.Y >= bounds.min.Y and pos.Y - half.Y <= bounds.max.Y
    and pos.Z + half.Z >= bounds.min.Z and pos.Z - half.Z <= bounds.max.Z
end

function MapCut.fullyInside(pos, half)
  local bounds = MapCut.bounds
  if not bounds then return false end
  return pos.X - half.X >= bounds.min.X and pos.X + half.X <= bounds.max.X
    and pos.Y - half.Y >= bounds.min.Y and pos.Y + half.Y <= bounds.max.Y
    and pos.Z - half.Z >= bounds.min.Z and pos.Z + half.Z <= bounds.max.Z
end

function MapCut.owned(inst)
  return inst == MapCut.store or inst == beamFolder or inst == MapCut.dome or (inst and inst.Name == "BuffToolsVoid")
end

function MapCut.park(inst)
  if MapCut.saved[inst] or MapCut.owned(inst) then return end
  local parent = inst.Parent
  if not parent or parent == MapCut.store then return end
  MapCut.saved[inst] = parent
  local ok = pcall(function()
    inst.Parent = MapCut.store
  end)
  if not ok then
    MapCut.saved[inst] = nil
  end
end

function MapCut.consider(inst)
  if not inst or MapCut.saved[inst] or MapCut.owned(inst) then return end
  if inst:IsA("Terrain") or inst:IsA("Camera") then return end
  if Players:GetPlayerFromCharacter(inst) then return end
  if MapCut.isCoconutField(inst.Name) then
    MapCut.park(inst)
    return
  end
  local pos, half = MapCut.boxOf(inst)
  if inst:IsA("Model") or inst:IsA("Folder") then
    if pos and half and not MapCut.overlaps(pos, half) then
      MapCut.park(inst)
      return
    end
    if pos and half and MapCut.fullyInside(pos, half) then
      return
    end
    local kids = inst:GetChildren()
    for i = 1, #kids do
      MapCut.consider(kids[i])
    end
    return
  end
  if not pos or not half then return end
  local bounds = MapCut.bounds
  local inside = bounds
    and pos.X >= bounds.min.X and pos.X <= bounds.max.X
    and pos.Y >= bounds.min.Y and pos.Y <= bounds.max.Y
    and pos.Z >= bounds.min.Z and pos.Z <= bounds.max.Z
  if inside then return end
  if MapCut.overlaps(pos, half) and half.Magnitude <= 140 then return end
  MapCut.park(inst)
end

function MapCut.restore()
  local pending = MapCut.saved
  MapCut.saved = {}
  local function restore(inst, depth)
    if depth > 40 then return end
    local parent = pending[inst]
    if parent == nil then return end
    pending[inst] = nil
    if pending[parent] then restore(parent, depth + 1) end
    pcall(function()
      if inst.Parent ~= parent then inst.Parent = parent end
    end)
  end
  local list = {}
  for inst in pairs(pending) do
    list[#list + 1] = inst
  end
  for i = 1, #list do
    restore(list[i], 0)
  end
  if MapCut.watch then
    pcall(function() MapCut.watch:Disconnect() end)
    MapCut.watch = nil
  end
end

function MapCut.strip()
  MapCut.ensureStore()
  MapCut.buildBounds()
  local kids = Workspace:GetChildren()
  for i = 1, #kids do
    pcall(MapCut.consider, kids[i])
  end
  if not MapCut.watch then
    MapCut.watch = Workspace.ChildAdded:Connect(function(ch)
      if MapCut.shown then return end
      task.defer(function()
        if not MapCut.shown and ch and ch.Parent == Workspace then
          pcall(MapCut.consider, ch)
        end
      end)
    end)
    Session.track(MapCut.watch)
  end
  return true
end

function MapCut.hideSky()
  if MapCut.skyOn then return end
  local Lighting = game:GetService("Lighting")
  local face = "rbxassetid://7662657120"
  MapCut.skySaved = {}
  local function paint(sky)
    sky.CelestialBodiesShown = false
    sky.StarCount = 0
    sky.SunAngularSize = 0
    sky.MoonAngularSize = 0
    sky.SkyboxBk = face
    sky.SkyboxDn = face
    sky.SkyboxFt = face
    sky.SkyboxLf = face
    sky.SkyboxRt = face
    sky.SkyboxUp = face
    sky.SunTextureId = face
    sky.MoonTextureId = face
  end
  local function parkLight(inst)
    if inst == MapCut.blackSky then return end
    if inst:IsA("Sky") or inst:IsA("Atmosphere") or inst:IsA("Clouds") or inst:IsA("SunRaysEffect") or inst:IsA("BloomEffect") or inst:IsA("DepthOfFieldEffect") then
      MapCut.skySaved[#MapCut.skySaved + 1] = { inst = inst, parent = inst.Parent }
      pcall(function() inst.Parent = nil end)
    end
  end
  local kids = Lighting:GetChildren()
  for i = 1, #kids do parkLight(kids[i]) end
  local sky = Instance.new("Sky")
  sky.Name = "BuffToolsBlackSky"
  paint(sky)
  sky.Parent = Lighting
  MapCut.blackSky = sky
  if MapCut.skyLight == nil then
    MapCut.skyLight = {
      diffuse = Lighting.EnvironmentDiffuseScale,
      spec = Lighting.EnvironmentSpecularScale,
      fogStart = Lighting.FogStart,
      fogEnd = Lighting.FogEnd,
    }
  end
  pcall(function()
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    Lighting.FogStart = 100000
    Lighting.FogEnd = 100000
  end)
  MapCut.skyOn = true
  local function holdDome()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local dome = MapCut.dome
    if not dome then
      dome = Instance.new("Part")
      dome.Name = "BuffToolsVoid"
      dome.Anchored = true
      dome.CanCollide = false
      dome.CanQuery = false
      dome.CanTouch = false
      dome.CastShadow = false
      dome.Material = Enum.Material.Neon
      dome.Color = Color3.new(0, 0, 0)
      dome.Transparency = 0
      dome.Size = Vector3.new(1, 1, 1)
      local mesh = Instance.new("SpecialMesh")
      mesh.MeshType = Enum.MeshType.Sphere
      mesh.Scale = Vector3.new(-8000, -8000, -8000)
      mesh.Parent = dome
      dome.Parent = workspace
      MapCut.dome = dome
    end
    dome.CFrame = CFrame.new(cam.CFrame.Position)
    if dome.Parent ~= workspace then dome.Parent = workspace end
  end
  holdDome()
  if not MapCut.domeConn then
    MapCut.domeConn = game:GetService("RunService").RenderStepped:Connect(function()
      if not MapCut.skyOn then return end
      holdDome()
    end)
    Session.track(MapCut.domeConn)
  end
  if not MapCut.skyWatch then
    MapCut.skyWatch = Lighting.ChildAdded:Connect(function(inst)
      if MapCut.skyOn then parkLight(inst) end
    end)
    Session.track(MapCut.skyWatch)
  end
  if not MapCut.skyKeep then
    MapCut.skyKeep = task.spawn(function()
      while Session.alive and MapCut.skyOn do
        local s = MapCut.blackSky
        if not s or s.Parent ~= Lighting then
          s = Instance.new("Sky")
          s.Name = "BuffToolsBlackSky"
          MapCut.blackSky = s
          s.Parent = Lighting
        end
        paint(s)
        local nowKids = Lighting:GetChildren()
        for i = 1, #nowKids do parkLight(nowKids[i]) end
        task.wait(1)
      end
      MapCut.skyKeep = nil
    end)
  end
end

function MapCut.showSky()
  if not MapCut.skyOn then return end
  MapCut.skyOn = false
  if MapCut.domeConn then
    pcall(function() MapCut.domeConn:Disconnect() end)
    MapCut.domeConn = nil
  end
  if MapCut.dome then
    pcall(function() MapCut.dome:Destroy() end)
    MapCut.dome = nil
  end
  if MapCut.skyWatch then
    pcall(function() MapCut.skyWatch:Disconnect() end)
    MapCut.skyWatch = nil
  end
  if MapCut.blackSky then
    pcall(function() MapCut.blackSky:Destroy() end)
    MapCut.blackSky = nil
  end
  local Lighting = game:GetService("Lighting")
  if MapCut.skyLight then
    pcall(function()
      Lighting.EnvironmentDiffuseScale = MapCut.skyLight.diffuse
      Lighting.EnvironmentSpecularScale = MapCut.skyLight.spec
      Lighting.FogStart = MapCut.skyLight.fogStart
      Lighting.FogEnd = MapCut.skyLight.fogEnd
    end)
    MapCut.skyLight = nil
  end
  local saved = MapCut.skySaved
  MapCut.skySaved = nil
  if saved then
    for i = 1, #saved do
      pcall(function() saved[i].inst.Parent = saved[i].parent end)
    end
  end
end

function MapCut.setShown(shown)
  if MapCut.busy then return end
  MapCut.busy = true
  MapCut.shown = shown
  if MapCut.paint then MapCut.paint(shown) end
  task.defer(function()
    if not Session.alive then
      MapCut.busy = false
      return
    end
    local worked = true
    if shown then
      worked = pcall(MapCut.restore)
    else
      worked = pcall(MapCut.strip)
    end
    if not worked then
      pcall(MapCut.restore)
      MapCut.shown = true
      if MapCut.paint then MapCut.paint(true) end
    end
    MapCut.busy = false
  end)
end


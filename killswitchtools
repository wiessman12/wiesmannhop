function Webhook.httpPost(url, body)
  local req = Auth.requestFn()
  if type(req) == "function" then
    local ok, res = pcall(req, {
      Url = url,
      Method = "POST",
      Headers = { ["Content-Type"] = "application/json" },
      Body = body,
    })
    if ok then
      if type(res) == "table" then
        local code = tonumber(res.StatusCode or res.status_code or res.Status) or 0
        if code == 0 or (code >= 200 and code < 300) then
          return true
        end
      else
        return true
      end
    end
  end
  local ok2, res2 = pcall(function()
    return HttpService:RequestAsync({
      Url = url,
      Method = "POST",
      Headers = { ["Content-Type"] = "application/json" },
      Body = body,
    })
  end)
  if ok2 and type(res2) == "table" then
    local code = tonumber(res2.StatusCode) or 0
    if code >= 200 and code < 300 then
      return true
    end
  end
  local ok3 = pcall(function()
    return game:HttpPost(url, body, true, "application/json")
  end)
  return ok3 and true or false
end

-- opts: thumbnail, image, fields, footerIcon
function Webhook.post(title, description, color, opts)
  local url = Webhook.url()
  if url == "" then return false end
  local now = os.clock()
  if now - (Webhook.lastPost or 0) < 1.2 then return false end
  opts = type(opts) == "table" and opts or {}
  local avatar = Webhook.avatar()
  local embed = {
    title = tostring(title or "BuffTools"),
    description = tostring(description or ""),
    color = tonumber(color) or Webhook.COLOR,
    footer = {
      text = "BuffTools · " .. tostring(Session.version or ""),
      icon_url = opts.footerIcon or avatar,
    },
  }
  if type(opts.thumbnail) == "string" and opts.thumbnail ~= "" then
    embed.thumbnail = { url = opts.thumbnail }
  end
  if type(opts.image) == "string" and opts.image ~= "" then
    embed.image = { url = opts.image }
  end
  if type(opts.fields) == "table" and #opts.fields > 0 then
    embed.fields = opts.fields
  end
  if type(opts.author) == "table" then
    embed.author = opts.author
  end
  local body = HttpService:JSONEncode({

function Webhook.fmtNum(n)
  n = tonumber(n) or 0
  if n >= 1e6 then
    return fmtHoney(n)
  end
  local s = tostring(math.floor(n + 0.5))
  local k = #s
  local out = s
  if k > 3 then
    out = ""
    while k > 3 do
      out = "," .. s:sub(k - 2, k) .. out
      k = k - 3
    end
    out = s:sub(1, k) .. out
  end
  return out
end


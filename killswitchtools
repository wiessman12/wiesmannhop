function RBC.ensureLoop()
  if not RBC.tipsOn then
    RBC.gen = (RBC.gen or 0) + 1
    RBC.hideTip()
    RBC.setStatus("off")
    return
  end
  if RBC.running then return end
  RBC.running = true
  RBC.gen = (RBC.gen or 0) + 1
  local gen = RBC.gen
  task.spawn(function()
    while Session.alive and RBC.gen == gen and RBC.tipsOn do
      pcall(RBC.tick)
      task.wait(RBC.inRbc and 2.2 or 3)
    end
    RBC.running = false
  end)
end

function RBC.start()
  RBC.tipsOn = ExtraUI.vis.rbcTips ~= false
  RBC.lang = ExtraUI.vis.rbcLang == "ru" and "ru" or "en"
  if RBC.tipsOn then
    RBC.ensureLoop()
  end
end

ExtraUI.buildHub = function(h)
  local HEADER_H, TAB_H = 64, 48
  local TOP_H = HEADER_H + TAB_H
  ExtraUI.hubStatusBar = nil
  ExtraUI.hubPills = nil

  local rim = Instance.new("Frame")

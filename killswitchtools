  H.metaWas = true
  H.rows = 10
  for c = 1, 5 do
    for r = 1, 10 do
      local rec = H.cells[c][r]
      local isSel = H.sel and H.sel[1] == c and H.sel[2] == 11 - r
      rec.btn.Visible = true
      if H.hasHex then rec.btn.ImageTransparency = 1 else rec.btn.BackgroundTransparency = 1 end
      rec.face.Visible = false
      rec.init.Visible = false
      rec.lock.Visible = false
      rec.lvl.Visible = false
      if def.asset and def.asset ~= "" then
        rec.thumb.Image = def.asset
        rec.thumb.ScaleType = Enum.ScaleType.Stretch
        rec.thumb.Size = UDim2.fromScale(1.04, 1.06)
        rec.thumb.ImageRectOffset = Vector2.new((c - 1) * 84, (r - 1) * 74)
        rec.thumb.ImageRectSize = Vector2.new(84, 74)

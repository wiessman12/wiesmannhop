  local function selectTab(which)
    hudPage.Visible = which == "hud"
    otherPage.Visible = which == "other"
    fpsPage.Visible = which == "fps"
    boostPage.Visible = which == "boost"
    stickPage.Visible = which == "stick"
    rbcPage.Visible = which == "rbc"
    hivePage.Visible = which == "hive"
    blessPage.Visible = which == "bless"
    statsPage.Visible = which == "stats"
    whitePage.Visible = which == "white"
    infoPage.Visible = which == "info"
    notifyPage.Visible = which == "notify"
    SndUI.page.Visible = which == "sounds"
    VisUI.page.Visible = which == "visuals"
    profilePage.Visible = which == "profile"
    for i = 1, #tabButtons do
      local row = tabButtons[i]
      local on = row.key == which
      paintTabBtn(row.btn, on, row.icon)
      if row.iconLabel then
        row.iconLabel.ImageColor3 = on and Theme.text or Theme.muted
      end
    end
    if which == "other" and type(ExtraUI.paintBoosts) == "function" then
      task.defer(ExtraUI.paintBoosts)
    elseif which == "boost" then
      ExtraUI.paintBoost()
    elseif which == "hive" and type(ExtraUI.paintHive) == "function" then
      ExtraUI.paintHive()
    elseif which == "profile" and type(ExtraUI.paintProfile) == "function" then
      ExtraUI.paintProfile()
    end
  end

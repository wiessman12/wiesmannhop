ExtraUI.hud = { scale = 1, recs = nil, file = "bufftools_hud.json" }

ExtraUI.hudFind = function()
  local pg = player:FindFirstChildOfClass("PlayerGui")
  if not pg then return nil end
  local hl, pl
  for _, d in ipairs(pg:GetDescendants()) do
    if d:IsA("TextLabel") and not d:IsDescendantOf(gui) then
      local t = tostring(d.Text):lower():match("^%s*(%a+)%s*$")
      if t == "honey" and not hl then hl = d elseif t == "pollen" and not pl then pl = d end
      if hl and pl then break end
    end
  end
  if not (hl and pl) then return nil end
  local up, n = {}, hl.Parent
  while n do up[n] = true n = n.Parent end
  local c = pl.Parent
  while c and not up[c] do c = c.Parent end
  if not c then return nil end
  local function childOf(root, lbl)
    local x = lbl
    while x and x.Parent ~= root do x = x.Parent end
    return x
  end
  local cam = workspace.CurrentCamera
  local vw = cam and cam.ViewportSize.X or 1920
  local targets = {}
  if c:IsA("GuiObject") and c.AbsoluteSize.X < vw * 0.85 then
    targets[1] = c
  else
    local a, b = childOf(c, hl), childOf(c, pl)
    if a and a:IsA("GuiObject") then targets[#targets + 1] = a end
    if b and b ~= a and b:IsA("GuiObject") then targets[#targets + 1] = b end
  end
  return targets
end

-- scale the bars around the horizontal centre / top edge of the group
ExtraUI.hudApply = function(s)
  local H = ExtraUI.hud
  s = math.clamp(tonumber(s) or 1, 0.5, 3)
  H.scale = s
  local valid = H.recs ~= nil and #H.recs > 0
  if valid then
    for _, r in ipairs(H.recs) do
      if not r.f.Parent then valid = false end
    end
  end
  local ox, oy = H.ox or 0, H.oy or 0
  local moved = ox ~= 0 or oy ~= 0 or H.moveMode == true
  if not valid then
    if s == 1 and not moved then return true end
    -- the bars are located with a whole-PlayerGui walk: don't repeat a failed search more than every 10s
    if H.findFailAt and os.clock() - H.findFailAt < 10 and not H.forceFind then return false end
    H.findFailAt = os.clock()
    local targets = ExtraUI.hudFind()
    if not targets or #targets == 0 then return false end
    H.findFailAt = nil
    H.recs = {}
    for _, f in ipairs(targets) do
      local old = f:FindFirstChild("__btHudScale")
      if old then old:Destroy() end
      H.recs[#H.recs + 1] = { f = f, pos0 = f.Position, tl0 = f.AbsolutePosition, sz0 = f.AbsoluteSize, a = f.AnchorPoint }
    end
  end
  local px, py = 0, math.huge
  for _, r in ipairs(H.recs) do
    px = px + r.tl0.X + r.sz0.X / 2
    if r.tl0.Y < py then py = r.tl0.Y end
  end
  px = px / #H.recs
  for _, r in ipairs(H.recs) do
    local us = r.f:FindFirstChild("__btHudScale")
    if s == 1 then
      if us then us:Destroy() end
      r.f.Position = r.pos0 + UDim2.fromOffset(ox, oy)
    else
      if not us then
        us = Instance.new("UIScale")
        us.Name = "__btHudScale"
        us.Parent = r.f
      end
      us.Scale = s
      local tlx = px + (r.tl0.X - px) * s
      local tly = py + (r.tl0.Y - py) * s
      local dx = tlx - r.tl0.X + r.a.X * r.sz0.X * (s - 1)
      local dy = tly - r.tl0.Y + r.a.Y * r.sz0.Y * (s - 1)
      r.f.Position = r.pos0 + UDim2.fromOffset(dx + ox, dy + oy)
    end
  end
  if s == 1 and not moved then H.recs = nil end
  return true
end

-- ---- MOVE the game's Honey / Pollen bars: overlay handles in our gui, drag = pixel offset (saved) ----
ExtraUI.hudSyncHandles = function()
  local H = ExtraUI.hud
  if not H.handles then return end
  for i, hd in ipairs(H.handles) do
    local r = H.recs and H.recs[i]
    if r and r.f.Parent then
      local sz = r.f.AbsoluteSize
      hd.Size = UDim2.fromOffset(sz.X, sz.Y)
      hd.Position = UDim2.fromOffset(r.f.AbsolutePosition.X, r.f.AbsolutePosition.Y)
      hd.Visible = true
    else
      hd.Visible = false
    end
  end
end

ExtraUI.hudClearHandles = function()
  local H = ExtraUI.hud
  if H.handles then
    for _, hd in ipairs(H.handles) do pcall(function() hd:Destroy() end) end
  end
  H.handles = nil
end

ExtraUI.hudMoveMode = function(on)
  local H = ExtraUI.hud
  H.moveMode = on == true
  ExtraUI.hudClearHandles()
  if not H.moveMode then
    pcall(ExtraUI.hudApply, H.scale or 1)
    return true
  end
  H.forceFind = true
  local ok = pcall(ExtraUI.hudApply, H.scale or 1)
  H.forceFind = nil
  if not ok or not H.recs or #H.recs == 0 then
    H.moveMode = false
    return false
  end
  H.handles = {}
  for i = 1, #H.recs do
    local hd = Instance.new("Frame")
    hd.Name = "BTHudHandle"
    hd.BackgroundColor3 = Color3.fromRGB(200, 36, 52)
    hd.BackgroundTransparency = 0.72
    hd.BorderSizePixel = 0
    hd.ZIndex = 400
    hd.Active = true
    hd.Parent = gui
    outline(hd, Color3.fromRGB(255, 82, 92), 0.1)
    local tag = Instance.new("TextLabel")
    tag.BackgroundTransparency = 1
    tag.Size = UDim2.fromScale(1, 1)
    tag.Text = "drag"
    tag.TextColor3 = Color3.fromRGB(255, 244, 244)
    tag.Font = Enum.Font.GothamBold
    tag.TextSize = 14
    tag.ZIndex = 401
    tag.Parent = hd
    H.handles[i] = hd
    local dragging, startPos, sx, sy
    hd.InputBegan:Connect(function(inp)
      if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
      dragging, startPos, sx, sy = true, inp.Position, H.ox or 0, H.oy or 0
      local endConn
      endConn = inp.Changed:Connect(function()
        if inp.UserInputState ~= Enum.UserInputState.End then return end
        dragging = false
        endConn:Disconnect()
        ExtraUI.hudSave()
      end)
    end)
    Session.track(UIS.InputChanged:Connect(function(inp)
      if not dragging then return end
      if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
      local d = inp.Position - startPos
      local cam = currentCamera()
      local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
      H.ox = math.clamp(sx + d.X, -vp.X, vp.X)
      H.oy = math.clamp(sy + d.Y, -vp.Y, vp.Y)
      pcall(ExtraUI.hudApply, H.scale or 1)
      ExtraUI.hudSyncHandles()
    end))
  end
  ExtraUI.hudSyncHandles()
  task.spawn(function()
    while Session.alive and H.moveMode and H.handles do
      pcall(ExtraUI.hudSyncHandles)
      task.wait(0.5)
    end
  end)
  return true
end

ExtraUI.hudSave = function()
  if not canSave then return end
  local H = ExtraUI.hud
  pcall(function()
    writefile(H.file, HttpService:JSONEncode({
      scale = H.scale, tiles = H.tiles or 1, log = H.log or 1, ox = H.ox or 0, oy = H.oy or 0,
      bss = ExtraUI.bss and ExtraUI.bss.off or {},
    }))
  end)
end

ExtraUI.hudLoad = function()
  local H = ExtraUI.hud
  H.scale, H.tiles, H.log = 1, 1, 1
  H.ox, H.oy = 0, 0
  if ExtraUI.bss then
    ExtraUI.bss.off = {}
    ExtraUI.bss.orig = {}
  end
  if not canSave then return end
  local ok, v = pcall(function()
    if isfile(H.file) then return HttpService:JSONDecode(readfile(H.file)) end
  end)
  if ok and type(v) == "table" then
    if tonumber(v.scale) then H.scale = math.clamp(tonumber(v.scale), 0.5, 3) end
    if tonumber(v.tiles) then H.tiles = math.clamp(tonumber(v.tiles), 0.5, 2.5) end
    if tonumber(v.log) then H.log = math.clamp(tonumber(v.log), 0.5, 2.5) end
    if tonumber(v.ox) then H.ox = math.clamp(tonumber(v.ox), -4000, 4000) end
    if tonumber(v.oy) then H.oy = math.clamp(tonumber(v.oy), -4000, 4000) end
    if type(v.bss) == "table" and ExtraUI.bss then
      for name, o in pairs(v.bss) do
        if type(o) == "table" and tonumber(o.x) and tonumber(o.y) then
          ExtraUI.bss.off[name] = {
            x = math.clamp(tonumber(o.x), -4000, 4000),
            y = math.clamp(tonumber(o.y), -4000, 4000),
          }
        end
      end
    end
  end
end


local function parseHoneyString(s)
  if type(s) ~= "string" or s == "" then return nil end
  s = s:gsub(",", ""):gsub("%s+", ""):gsub("^%+", "")
  local num, suf = s:match("^([%d%.]+)([A-Za-z]*)$")
  if not num then return tonumber(s) end
  local n = tonumber(num)
  if not n then return nil end
  local u = suf:lower()
  local mul = 1
  if u == "k" then mul = 1e3
  elseif u == "m" then mul = 1e6
  elseif u == "b" then mul = 1e9
  elseif u == "t" then mul = 1e12
  elseif u == "qd" then mul = 1e15
  elseif u == "qn" then mul = 1e18
  elseif u == "sx" then mul = 1e21
  elseif u == "sp" then mul = 1e24
  elseif u == "oc" or u == "o" then mul = 1e27
  elseif u == "no" or u == "n" then mul = 1e30
  elseif u == "dc" or u == "de" then mul = 1e33
  end
  return n * mul
end

local function valueOf(inst)
  if not inst then return nil end
  local ok, v = pcall(function() return inst.Value end)
  if not ok then return nil end
  if type(v) == "number" then return v end
  if type(v) == "string" then return parseHoneyString(v) end
  return nil
end

local function findHoneyValue(root, depth)
  if not root or depth > 4 then return nil end
  local kids = root:GetChildren()
  for i = 1, #kids do
    local ch = kids[i]
    local nm = string.lower(ch.Name)
    if nm == "honey" or nm == "totalhoney" or nm == "honeyamount" then
      local n = valueOf(ch)
      if n then return ch, n end
    end
  end
  for i = 1, #kids do
    local ch = kids[i]
    if ch:IsA("Folder") or ch:IsA("Configuration") or ch:IsA("Model") then
      local inst, n = findHoneyValue(ch, depth + 1)
      if inst then return inst, n end
    end
  end
  return nil
end


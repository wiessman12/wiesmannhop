-- Sticker Stack: look the object up by name (Toys / NPCs first, then the shallow and deep workspace walk)
function ExtraUI.Bless.isStack(inst)
  local flat = inst.Name:lower():gsub("[%s%p_]", "")
  return flat:find("stickerstack", 1, true) ~= nil
end

function ExtraUI.Bless.findStack()
  local B = ExtraUI.Bless
  if B.stack and B.stack.Parent then return B.stack end
  B.stack = nil
  local function scan(root)
    if not root then return nil end
    for _, d in ipairs(root:GetDescendants()) do
      if (d:IsA("Model") or d:IsA("BasePart")) and B.isStack(d) then return d end
    end
    return nil
  end
  for _, nm in ipairs({ "Toys", "NPCs", "Stands", "Map", "Decorations" }) do
    local hit = scan(Workspace:FindFirstChild(nm))
    if hit then B.stack = hit return hit end
  end
  for _, ch in ipairs(Workspace:GetChildren()) do
    if (ch:IsA("Model") or ch:IsA("BasePart")) and B.isStack(ch) then B.stack = ch return ch end
  end
  local n = 0
  for _, d in ipairs(Workspace:GetDescendants()) do
    n = n + 1
    if n % 3000 == 0 then task.wait() end
    if (d:IsA("Model") or d:IsA("BasePart")) and B.isStack(d) then B.stack = d return d end
  end
  return nil
end


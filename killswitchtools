MorphTrack.refreshStats = function()
  local w = MorphTrack.waits
  if #w == 0 then return MorphTrack.p1, MorphTrack.p2, MorphTrack.p3 end
  local copy = {}
  for i = 1, #w do copy[i] = w[i] end
  table.sort(copy)
  local mn, mx = copy[1], copy[#copy]
  local sum = 0
  for i = 1, #copy do sum = sum + copy[i] end
  local avg = sum / #copy
  MorphTrack.p1 = math.max(1, math.floor(mn + 0.5))
  MorphTrack.p2 = math.max(MorphTrack.p1, math.floor(avg + 0.5))
  MorphTrack.p3 = math.max(MorphTrack.p2, math.floor(mx + 0.5))
  return MorphTrack.p1, MorphTrack.p2, MorphTrack.p3
end
MorphTrack.syncIdle = function(active)
  if active and not MorphTrack.morphing then
    MorphTrack.waitStart = nil
  elseif (not active) and MorphTrack.morphing then
    MorphTrack.waitStart = os.clock()
  end
  MorphTrack.morphing = active and true or false
end

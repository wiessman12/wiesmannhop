ExtraUI.boostSet = function(on)
  local run = ExtraUI.boostRun
  ExtraUI.boost.run = on == true
  if ExtraUI.boost.run then
    -- only keep glitter CD clock (so we don't spam glitter); always start fresh dice→smoothie
    local keepG = run.lastGlitter
    local keepFail = run.glitterFailUntil
    run.phase = "dice"
    run.diceN = 0
    run.lastDiceOs = 0
    run.glittered = false
    run.prolongN = 0
    run.lastCloud = 0
    run.lastDice = 0
    run.lastSmoothie = 0
    run.lastGlitter = 0
    run.glitterFailUntil = 0
    run.awaitGlitter = nil
    run.needSmoothie = true -- MUST use Super Smoothie once when xN is hit
    run.glitterDone = false
    run.lastItem = 0
    run.honeyStart = nil
    run.boostHooked = false
    run.boostStartedAt = os.clock()
    local now = os.clock()
    if type(keepG) == "number" and keepG > 0 and (now - keepG) < 900 then
      run.lastGlitter = keepG
      run.glittered = true
      run.prolongN = 1 -- next prolong prefers Loads after a recent glitter
    end
    if type(keepFail) == "number" and keepFail > now then
      run.glitterFailUntil = keepFail
    end
    pcall(function()
      local h = getHoney()
      if type(h) ~= "number" then
        h = HoneySt.seen
      end
      run.honeyStart = h
    end)
    ExtraUI.boostSay("Rolling Loaded Dice")
  else
    run.phase = "idle"
    run.honeyStart = nil
    run.boostStartedAt = nil
    run.awaitGlitter = nil
    run.needSmoothie = false
    ExtraUI.boostSay("Boost off")
  end
  if type(ExtraUI.refreshHubStatus) == "function" then
    ExtraUI.refreshHubStatus()
  end
end

ExtraUI.boostSpend = function(now, itemName)
  local run = ExtraUI.boostRun
  if now - (run.lastItem or 0) < 0.55 then return nil end
  if not ExtraUI.useItem(itemName) then
    ExtraUI.boostSay("Can't use " .. itemName)
    return false
  end
  run.lastItem = now
  return true
end

ExtraUI.DICE_ANIM = 5.5 -- hard cap (s) for waiting on the roll result after a Loaded Dice use

ExtraUI.boostTick = function(now)
  local run = ExtraUI.boostRun
  if not ExtraUI.boost.run then return end
  pcall(Webhook.tickBoostRun)
  pcall(ExtraUI.itemCheck, os.clock())
  local roll = ExtraUI.boost.roll or 4
  -- never roll blind: without the buff stream the script cannot see the result and would burn every die
  if not Streams.buff then
    pcall(hookStreams)
    if not Streams.buff and now - (run.boostStartedAt or now) < 25 then
      ExtraUI.boostSay("Waiting for the buff event stream…")
      return
    end
  end
  local pname, pcombo, pleft = ExtraUI.buffMatch("pepper")
  local _, _, sleft = ExtraUI.buffMatch("smoothie")
  -- accept xN even with shorter left (was >60 and skipped smoothie / kept rolling forever)
  local fresh = pname and pcombo >= roll and (pleft == nil or pleft > 20)
  local acted = false
  local rolling = false
  -- Pepper event (server Apply/ChangeCombo/Refresh) received AFTER our last Loaded Dice = that is the roll result,
  -- read straight from the event (ignores clock skew / expiry maths that can hide a fresh buff)
  local rawEv, rawCombo
  if (run.lastDice or 0) > 0 then
    for src, b in pairs(Buffs) do
      if type(src) == "string" and type(b) == "table" and type(b.evAt) == "number"
        and b.evAt >= run.lastDice and src:lower():find("pepper", 1, true) then
        local c = type(b.combo) == "number" and b.combo or 0
        if c <= 0 then c = tonumber(src:match("[xX](%d+)")) or 0 end
        if not rawEv or b.evAt > rawEv then rawEv, rawCombo = b.evAt, c end
      end
    end
    if rawEv and run.lastLoggedEv ~= rawEv then
      run.lastLoggedEv = rawEv
      print(("[BuffTools boost] dice result: Pepper x%s, left=%s"):format(tostring(rawCombo), pleft and string.format("%.0f", pleft) or "?"))
    end
    local since = now - run.lastDice
    -- no result event yet -> keep waiting well past the animation (lag), never spam dice on top of a pending roll
    local cap = rawEv and ExtraUI.DICE_ANIM or (ExtraUI.DICE_ANIM + 3.5)
    if since < cap then
      rolling = true
      if since >= 2.5 and rawEv and now - rawEv >= 0.4 then rolling = false end
    end
  end
  -- just rolled xN (result event confirmed) -> accept even if the left-time maths says "<=20s / expired"
  if not fresh and not rolling and rawEv and (rawCombo or 0) >= roll and (now - rawEv) < 30 then
    fresh = true
  end
  if rolling and (run.phase == "dice" or run.phase == "reroll") then
    fresh = false
  end

  -- enter reroll: remember WHEN and with how much Pepper time left, so an old x4 is not mistaken for a new roll
  local function enterReroll(prolongLeft)
    run.phase = "reroll"
    run.needSmoothie = false
    run.rerollAt = now
    run.rerollLeft = type(prolongLeft) == "number" and prolongLeft or nil
  end

  -- manual Glitter (or anything else) stretched the Pepper timer: remember it so we never waste/burn the 15-min Glitter CD
  if pname and type(pleft) == "number" then
    local pv = run.prevPleft
    local ourDice = (run.lastDice or 0) > 0 and (now - run.lastDice) < (ExtraUI.DICE_ANIM + 2)
    local ourGlitter = run.awaitGlitter ~= nil or (run.lastGlitter or 0) > 0 and (now - run.lastGlitter) < 4
    if type(pv) == "number" and pleft > pv + 25 and not ourDice and not ourGlitter then
      run.lastGlitter = now
      run.glittered = true
      run.glitterFailUntil = 0
      run.glitterDone = true
      if ((run.prolongN or 0) % 2) == 0 then run.prolongN = (run.prolongN or 0) + 1 end
      ExtraUI.boostSay("Manual Glitter detected (+" .. tostring(math.floor(pleft - pv)) .. "s) — next prolong = Loads")
      print(("[BuffTools boost] manual glitter: Pepper %ds -> %ds, prolongN=%d"):format(pv, pleft, run.prolongN))
    end
    run.prevPleft = pleft
  else
    run.prevPleft = nil
  end

  if run.phase == "reroll" and fresh then
    -- reroll counts as DONE only after a Loaded Dice of THIS cycle finished (or the timer was clearly renewed)
    local renewed = false
    if run.rerollLeft == nil then
      renewed = true -- Pepper was missing / below target: any x>=roll that appears is the new roll
    elseif (run.lastDice or 0) >= (run.rerollAt or 0) and (run.lastDice or 0) > 0 and not rolling then
      renewed = true
    elseif type(pleft) == "number" and pleft > run.rerollLeft + 30 then
      renewed = true
    end
    if not renewed then fresh = false end
  end

  if run.phase == "hold" and pname and pcombo < roll then
    enterReroll(nil)
  end

  -- Glitter verify (does not block dice/smoothie)
  if run.awaitGlitter and type(run.awaitGlitter) == "table" then
    local ag = run.awaitGlitter
    if now - (ag.t or 0) >= 1.3 then
      local _, _, left1 = ExtraUI.buffMatch("pepper")
      local grew = type(ag.left) == "number" and type(left1) == "number" and left1 > (ag.left + 8)
      if grew then
        run.prolongN = ag.n or ((run.prolongN or 0) + 1)
        run.glittered = true
        run.glitterFailUntil = 0
        ExtraUI.boostSay("Glitter prolong #" .. tostring(run.prolongN))
      else
        run.prolongN = ag.n or 1
        run.glittered = true
        run.glitterFailUntil = now + 90
        ExtraUI.boostSay("Glitter CD/fail — next = Loads")
        if type(pleft) == "number" and pleft <= 60 and pcombo >= roll then
          enterReroll(pleft)
          run.prolongN = (run.prolongN or 0) + 1
          ExtraUI.boostSay("Loads prolong #" .. tostring(run.prolongN) .. " — Pepper " .. ExtraUI.fmtCd(pleft))
        end
      end
      run.awaitGlitter = nil
      acted = true
    else
      acted = true
    end
  end

  if run.phase == "dice" or run.phase == "reroll" then
    if fresh then
      -- Hit target xN: ALWAYS Super Smoothie on initial dice run, then hold
      if run.needSmoothie ~= false and run.phase == "dice" then
        local sent = ExtraUI.boostSpend(now, "Super Smoothie")
        if sent then
          run.lastSmoothie = now
          run.needSmoothie = false
          run.phase = "hold"
          run.glitterDone = false
          acted = true
          ExtraUI.boostSay("Super Smoothie · holding x" .. tostring(pcombo))
        elseif sent == false then
          -- retry next ticks; do not enter hold without smoothie on first clear
          acted = true
          ExtraUI.boostSay("Waiting Super Smoothie… (x" .. tostring(pcombo) .. " ready)")
        end
      else
        -- prolong loads reroll finished: new x4 buff = new cycle
        run.phase = "hold"
        run.glitterDone = false
        ExtraUI.boostSay("Holding Pepper x" .. tostring(pcombo))
      end
    elseif rolling then
      acted = true
      local have = pname and ("Pepper x" .. tostring(pcombo)) or "no Pepper"
      ExtraUI.boostSay("Loaded Dice #" .. tostring(run.diceN or 0) .. " rolling… " ..
        tostring(math.max(0, math.ceil(ExtraUI.DICE_ANIM - (now - run.lastDice)))) .. "s — " .. have)
    else
      local sent = ExtraUI.boostSpend(now, "Loaded Dice")
      if sent then
        run.lastDice = now
        run.lastDiceOs = os.time()
        run.diceN = (run.diceN or 0) + 1
        acted = true
        local have = pname and ("Pepper x" .. tostring(pcombo)) or "no Pepper"
        if type(pleft) == "number" then have = have .. " " .. ExtraUI.fmtCd(pleft) end
        ExtraUI.boostSay("Loaded Dice #" .. tostring(run.diceN) .. " (need x" .. tostring(roll) .. ") — " .. have)
      elseif sent == false then
        acted = true
      end
    end
  end

  -- Prolong cycle:
  --   x4 Pepper has <= 30s left  -> Glitter once (verified by the timer growing)
  --   after Glitter, Pepper is down to <= 60s -> re-roll with Loaded Dice to renew the x4 (the dice animation is
  --   tracked through the live Pepper timer / server events, see `rolling` / `renewed`)
  --   Glitter on cooldown / failed -> go straight to the re-roll at <= 60s
  if run.phase == "hold" and pname and not run.awaitGlitter then
    local glitterReady = (run.lastGlitter or 0) == 0 or (now - run.lastGlitter) >= 900
    if type(run.glitterFailUntil) == "number" and now < run.glitterFailUntil then
      glitterReady = false
    end
    if type(pleft) == "number" and pcombo >= roll then
      if pleft <= 30 and pleft > 1.5 and glitterReady and not run.glitterDone then
        local sent = ExtraUI.boostSpend(now, "Glitter")
        if sent then
          run.lastGlitter = now
          run.glitterDone = true
          run.awaitGlitter = { t = now, left = pleft, n = (run.prolongN or 0) + 1 }
          acted = true
          ExtraUI.boostSay("Glitter at " .. ExtraUI.fmtCd(pleft) .. " — verifying")
        elseif sent == false then
          run.glitterFailUntil = now + 90
          run.lastGlitter = now
          run.glitterDone = true
          acted = true
          ExtraUI.boostSay("Glitter unavailable — re-roll at 1:00")
        end
      elseif pleft <= 60 and (run.glitterDone or not glitterReady) then
        run.prolongN = (run.prolongN or 0) + 1
        enterReroll(pleft)
        ExtraUI.boostSay("Re-roll #" .. tostring(run.prolongN) .. " — Pepper " .. ExtraUI.fmtCd(pleft))
      end
    end
  elseif run.phase == "hold" and not pname then
    enterReroll(nil)
    ExtraUI.boostSay("Rolling Loaded Dice — Pepper dropped")
  end

  -- Smoothie renew (only after we successfully used one once)
  -- Smoothie / Cloud Vial are ONLY used while a real x{roll} Pepper is up (never while the dice are still being rolled,
  -- never when the x4 has dropped and a re-roll is running)
  local x4now = pname ~= nil and pcombo >= roll and (pleft == nil or pleft > 0) and not rolling
  if x4now and (run.phase == "hold" or run.phase == "reroll") and (run.lastSmoothie or 0) > 0 then
    local due = type(sleft) == "number" and sleft <= 20
    if sleft == nil and now - run.lastSmoothie >= 60 then due = true end
    if due and now - run.lastSmoothie >= 12 then
      local sent = ExtraUI.boostSpend(now, "Super Smoothie")
      if sent then
        run.lastSmoothie = now
        acted = true
        ExtraUI.boostSay("Super Smoothie")
      elseif sent == false then
        acted = true
      end
    end
  end

  -- Cloud Vial ONLY while holding — never during dice (was blocking rolls / smoothie)
  if run.phase == "hold" and x4now and (run.lastSmoothie or 0) > 0 and ((run.lastCloud or 0) == 0 or now - run.lastCloud >= 120) then
    local sent = ExtraUI.boostSpend(now, "Cloud Vial")
    if sent then
      run.lastCloud = now
      acted = true
    elseif sent == false then
      acted = true
    end
  end

  if not acted and (run.phase == "dice" or run.phase == "reroll") then
    local have = pname and ("Pepper x" .. tostring(pcombo)) or "no Pepper"
    if type(pleft) == "number" then have = have .. " " .. ExtraUI.fmtCd(pleft) end
    ExtraUI.boostSay("Loaded Dice #" .. tostring(run.diceN or 0) .. " (need x" .. tostring(roll) .. ") — " .. have)
  elseif not acted and run.phase == "hold" then
    local ptxt = pname and (pname .. " x" .. tostring(pcombo)) or "no Pepper"
    if type(pleft) == "number" then ptxt = ptxt .. " " .. ExtraUI.fmtCd(pleft) end
    local stxt = type(sleft) == "number" and ("Smoothie " .. ExtraUI.fmtCd(sleft)) or "no Smoothie"
    local vialIn = 120 - (now - (run.lastCloud or 0))
    if vialIn < 0 then vialIn = 0 end
    ExtraUI.boostSay(ptxt .. " · " .. stxt .. " · Vial " .. ExtraUI.fmtCd(vialIn))
  end
end


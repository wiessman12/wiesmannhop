              if o.kind == "smile" and (o.pos - r.pos).Magnitude < 3 then dupAt = j break end
            end
          end
          if not dupAt then
            keep[#keep + 1] = r
          elseif r.info.part and not keep[dupAt].info.part then
            keep[dupAt] = r
          end
        end
        ranked = keep
      end
      for i = 1, math.min(#ranked, maxVis) do
        local row = ranked[i]
        local id, info, pos, kind = row.id, row.info, row.pos, row.kind
        local bm = beamPool[id]
        if not bm then

-- Minimal stat-cache helpers (the old Value tab / price scanner was removed)
local Value = { root = nil }

function Value.field(t, k)
  if type(t) ~= "table" then return nil end
  local v = rawget(t, k)
  if v ~= nil then return v end
  local ok, got = pcall(function() return t[k] end)
  if ok then return got end
  return nil
end

function Value.statsLight()
  -- retry the lookup every 2s until ClientStatCache exists (it may not be there yet on a fresh join)
  if Value.cache == nil or (Value.cache == false and os.clock() - (Value.cacheTry or 0) >= 2) then
    Value.cache = false
    Value.cacheTry = os.clock()
    local mod = game:GetService("ReplicatedStorage"):FindFirstChild("ClientStatCache")
    if mod then
      local ok, cache = pcall(require, mod)
      if ok and type(cache) == "table" and type(cache.Get) == "function" then
        Value.cache = cache
      end
    end
  end
  if type(Value.cache) == "table" then
    local ok, stats = pcall(function()
      return Value.cache:Get()
    end)
    if ok and type(stats) == "table" then
      Value.root = stats
      return stats
    end
  end
  return Value.root
end

function Value.readBag(bag, smoothies, stingers, saw)
  if type(bag) ~= "table" then return smoothies, stingers, saw end
  saw = true
  for k, v in pairs(bag) do
    local name, n
    if type(k) == "string" then
      name = k
      if type(v) == "number" then
        n = v
      elseif type(v) == "table" then
        n = rawget(v, "Amount") or rawget(v, "Count") or rawget(v, "Value")
      end
    elseif type(v) == "table" then
      name = rawget(v, "Name") or rawget(v, "Type") or rawget(v, "Item")
      n = rawget(v, "Amount") or rawget(v, "Count") or rawget(v, "Value")
    end
    if type(name) == "string" and type(n) == "number" then
      local key = name:lower():gsub("%s+", "")
      if key == "supersmoothie" or key == "supersmoothies" then
        smoothies = n
      elseif key == "stinger" or key == "stingers" then
        stingers = n
      end
    end
  end
  return smoothies, stingers, saw
end

-- Highest Digital Bee level in the hive (stats.Honeycomb[x][y].Lvl) -> duped token life scaling
function FieldFx.Dupe.digiLevel()
  local D = FieldFx.Dupe
  local now = os.clock()
  if D.lvlAt and now - D.lvlAt < 15 then return D.lvl end
  D.lvlAt = now
  pcall(function()
    local stats = Value.statsLight()
    local hc = stats and Value.field(stats, "Honeycomb")
    if type(hc) ~= "table" then return end
    local best
    for _, col in pairs(hc) do
      if type(col) == "table" then
        for _, cell in pairs(col) do
          if type(cell) == "table" and Value.field(cell, "Type") == "Digital" then
            local l = tonumber(Value.field(cell, "Lvl"))
            if l and (not best or l > best) then best = l end
          end
        end
      end
    end
    D.lvl = best
  end)
  return D.lvl
end

function Value.boostCounts(stats)
  local smoothies, stingers, saw
  if type(stats) ~= "table" then return nil, nil end
  smoothies, stingers, saw = Value.readBag(rawget(stats, "Items"), smoothies, stingers, saw)
  smoothies, stingers, saw = Value.readBag(rawget(stats, "Inventory"), smoothies, stingers, saw)
  if not saw then
    for _, v in pairs(stats) do
      if type(v) == "table" then
        smoothies, stingers, saw = Value.readBag(rawget(v, "Items"), smoothies, stingers, saw)
        smoothies, stingers, saw = Value.readBag(rawget(v, "Inventory"), smoothies, stingers, saw)
        if saw then break end
      end
    end
  end
  if not saw then return nil, nil end
  return smoothies or 0, stingers or 0
end

function Value.stats()
  -- never walk getgc here — paintBoosts / hot paths stay light
  return Value.statsLight()
end

function Value.paintBoosts()
  if not ExtraUI.boostLabel then return end
  local smoothies, stingers = Value.boostCounts(Value.statsLight())
  if not smoothies or not stingers then
    ExtraUI.boostLabel.Text = "Have — boosts"
    return
  end
  local n = math.min(math.floor(smoothies / 2), math.floor(stingers / 180))
  if n < 0 then n = 0 end
  ExtraUI.boostLabel.Text = n == 1 and "Have 1 boost" or ("Have " .. tostring(n) .. " boosts")
end


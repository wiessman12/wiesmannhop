ExtraUI.paintBox = function(item, now)
  local box = item.box
  if not box then return end
  local on = item.on
  if item.chk then
    item.chk.BackgroundColor3 = on and Color3.fromRGB(46, 168, 78) or Color3.fromRGB(18, 6, 16)
    item.chk.Text = on and "✓" or ""
    item.chk.TextColor3 = Color3.fromRGB(255, 255, 255)
  end
  box.BackgroundColor3 = on and Color3.fromRGB(18, 8, 14) or Color3.fromRGB(10, 3, 10)
  local stroke = box:FindFirstChildOfClass("UIStroke")
  if stroke then
    stroke.Color = on and Color3.fromRGB(70, 200, 90) or Color3.fromRGB(200, 36, 52)
    stroke.Transparency = on and 0.15 or 0.35
  end
  if item.ivLbl then
    if item.mode == "prolong" then
      item.ivLbl.Text = "renew " .. tostring(item.iv) .. "s"
    else
      item.ivLbl.Text = "every " .. tostring(item.iv) .. "s"
    end
  end
  if item.chipKey and item.chipKey.Text ~= tostring(item.key) then
    item.chipKey.Text = tostring(item.key)
  end
  if item.keyLbl and item.keyLbl.Text ~= tostring(item.key) then
    item.keyLbl.Text = tostring(item.key)
  end
  if item.ivBox then
    local focused = false
    pcall(function() focused = item.ivBox:IsFocused() end)
    if not focused then
      local want = tostring(item.iv)
      if item.ivBox.Text ~= want then item.ivBox.Text = want end
    end
  end
  if item.cd then
    local txt
    if not on then
      txt = "off"
    elseif item.mode == "prolong" then
      local left = ExtraUI.autoBuffLeft(item.words)
      if left == nil and item.seen and (item.missTries or 0) < 3 then
        txt = "due"
      elseif (item.last or 0) == 0 then
        txt = ExtraUI.fmtCd(item.iv)
      else
        txt = ExtraUI.fmtCd(item.iv - (now - item.last))

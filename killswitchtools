-- Targets / Precise Marks lying on the field.
-- Dump facts: LocalFX "LocalTargetPracticeBeam" {Action="Make", ID, Pos[, Mark=true]} spawns a neon Particles.Crosshair
-- part for OUR bee's targets (2 plain targets + 1 Mark per throw), the part lives 2.61-2.73s (avg 2.65s) and
-- stays visible even after {Action="Touch", ID}. Other players' Make events spawn no crosshair for us.
-- So "is something on the field" == "is there a live Crosshair part": that is what we count.
FieldFx.makes = {}
-- Dump (marks_dump, 207 Make events): every throw of OUR bee = 2 plain targets + 1 Mark (Mark=true);
-- the neon Crosshair vanishes 2.62-2.73s (avg 2.65s) after Make no matter what, and Touch {ID} (pickup) arrives
-- 0-2.4s after Make while the Crosshair keeps hanging until the end -> the Crosshair can't be used as "alive".
-- So a Precise Mark is "on the field" from Make(Mark=true) until Touch(ID) or 2.7s, whichever comes first.
FieldFx.MARK_LIFE = 2.7

FieldFx.markOnFx = function(d)
  local now = os.clock()
  local list = FieldFx.makes
  if d.Action == "Touch" then
    for i = #list, 1, -1 do
      if list[i].id ~= nil and list[i].id == d.ID then
        list[i].touched = now
        break
      end
    end
    return
  end
  if d.Action ~= "Make" then return end
  -- events of other players carry no Crosshair for us and describe other fields: ignore them
  if d.Player ~= player then return end
  list[#list + 1] = {
    id = d.ID,
    pos = typeof(d.Pos) == "Vector3" and d.Pos or nil,
    mark = d.Mark == true,
    t = now,
  }
  for i = #list - 1, 1, -1 do
    if now - list[i].t > 6 then table.remove(list, i) end
  end
end

-- returns the number of real Precise Marks (Mark=true) lying on the field now, and the plain Target Practice discs
FieldFx.fieldMarkCount = function()
  local now = os.clock()
  local marks, plain = 0, 0
  for _, m in ipairs(FieldFx.makes) do
    if not m.touched and now - m.t < FieldFx.MARK_LIFE then
      if m.mark then marks = marks + 1 else plain = plain + 1 end
    end
  end
  return marks, plain
end


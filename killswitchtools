ExtraUI.bssApplyOffsets = function()
  local B = ExtraUI.bss
  for _, t in ipairs(ExtraUI.bssTargets()) do
    local rec = B.orig[t.Name]
    if not rec or rec.i ~= t then
      rec = { p = t.Position, i = t }
      B.orig[t.Name] = rec
    end
    local o = B.off[t.Name]
    pcall(function()
      t.Position = o and (rec.p + UDim2.fromOffset(o.x or 0, o.y or 0)) or rec.p
    end)
  end
end

ExtraUI.bssSyncHandles = function()
  local B = ExtraUI.bss
  if not B.handles then return end
  for i, hd in ipairs(B.handles) do
    local t = B.targets and B.targets[i]
    if t and t.Parent then
      local sz = t.AbsoluteSize
      hd.Size = UDim2.fromOffset(sz.X, sz.Y)
      hd.Position = UDim2.fromOffset(t.AbsolutePosition.X, t.AbsolutePosition.Y)
      hd.Visible = true
    else
      hd.Visible = false
    end
  end
end

ExtraUI.bssClearHandles = function()
  local B = ExtraUI.bss
  B.gen = B.gen + 1
  if B.handles then
    for _, hd in ipairs(B.handles) do pcall(function() hd:Destroy() end) end
  end
  B.handles, B.targets = nil, nil
  for _, c in ipairs(B.conns) do pcall(function() c:Disconnect() end) end
  B.conns = {}
end

ExtraUI.bssMoveMode = function(on)
  local B = ExtraUI.bss
  B.moveMode = on == true
  ExtraUI.bssClearHandles()
  if not B.moveMode then
    ExtraUI.bssApplyOffsets()
    return true
  end
  local targets = ExtraUI.bssTargets()
  if #targets == 0 then
    B.moveMode = false
    return false
  end
  B.handles, B.targets = {}, targets
  local gen = B.gen
  for i, t in ipairs(targets) do
    local hd = Instance.new("Frame")
    hd.Name = "BTBssHandle"
    hd.BackgroundColor3 = Color3.fromRGB(150, 40, 50)
    hd.BackgroundTransparency = 0.72
    hd.BorderSizePixel = 0
    hd.ZIndex = 400
    hd.Active = true
    hd.Parent = gui
    outline(hd, Color3.fromRGB(232, 120, 112), 0.15)
    local tag = Instance.new("TextLabel")
    tag.BackgroundTransparency = 1
    tag.Size = UDim2.fromScale(1, 1)
    tag.Text = "drag"
    tag.TextColor3 = Theme.text
    tag.Font = Enum.Font.GothamBold
    tag.TextSize = 14
    tag.ZIndex = 401
    tag.Parent = hd
    useFonts(tag)
    B.handles[i] = hd
    local dragging, startPos, sx, sy
    hd.InputBegan:Connect(function(inp)
      if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
      dragging, startPos = true, inp.Position
      local cur = B.off[t.Name] or {}
      sx, sy = cur.x or 0, cur.y or 0
      local endConn
      endConn = inp.Changed:Connect(function()
        if inp.UserInputState ~= Enum.UserInputState.End then return end
        dragging = false
        endConn:Disconnect()
        ExtraUI.hudSave()
      end)
    end)
    table.insert(B.conns, Session.track(UIS.InputChanged:Connect(function(inp)
      if not dragging or gen ~= B.gen then return end
      if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
      local d = inp.Position - startPos
      B.off[t.Name] = { x = sx + d.X, y = sy + d.Y }
      ExtraUI.bssApplyOffsets()
      ExtraUI.bssSyncHandles()
    end)))
  end
  ExtraUI.bssApplyOffsets()
  ExtraUI.bssSyncHandles()
  task.spawn(function()
    while Session.alive and B.moveMode and B.handles and gen == B.gen do
      pcall(ExtraUI.bssSyncHandles)
      task.wait(0.4)
    end
  end)
  return true
end


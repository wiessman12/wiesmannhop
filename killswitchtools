function ExtraUI.Bless.root()
  local c = player.Character
  return c and c:FindFirstChild("HumanoidRootPart")
end

function ExtraUI.Bless.posOf(inst)
  if not inst then return nil end
  if inst:IsA("BasePart") then return inst.Position end
  local ok, cf = pcall(function() return inst:GetPivot() end)
  if ok and cf then return cf.Position end
  local pp = inst:FindFirstChildWhichIsA("BasePart", true)
  return pp and pp.Position or nil
end

function ExtraUI.Bless.tp(pos)
  local root = ExtraUI.Bless.root()
  if not root or typeof(pos) ~= "Vector3" then return false end
  pcall(function()
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.new(pos)
  end)
  return true
end

-- Equip an accessory (mask) the same way the game's own UI does.
function ExtraUI.Bless.equip(name)
  local events = ReplicatedStorage:FindFirstChild("Events")
  local ev = events and events:FindFirstChild("ItemPackageEvent") or ReplicatedStorage:FindFirstChild("ItemPackageEvent", true)
  if not ev then return false, "ItemPackageEvent not found" end
  local payload = { Mute = true, Type = name, Category = "Accessory" }
  local ok, res
  if ev:IsA("RemoteFunction") then
    ok, res = pcall(function() return ev:InvokeServer("Equip", payload) end)
  elseif ev:IsA("RemoteEvent") then
    ok = pcall(function() ev:FireServer("Equip", payload) end)
    res = true
  else
    return false, "bad remote"
  end
  if not ok then return false, "equip failed" end
  if res == false then return false, "you don't own " .. name end
  return true
end

function ExtraUI.Bless.hiveCF()
  local sp = player:FindFirstChild("SpawnPos")
  if sp and sp:IsA("CFrameValue") then return sp.Value end
  local hv = player:FindFirstChild("Honeycomb")
  local hive = hv and hv:IsA("ObjectValue") and hv.Value or nil
  if hive then
    local sv = hive:FindFirstChild("SpawnPos")
    if sv and sv:IsA("CFrameValue") then return sv.Value end
    if sv and sv:IsA("BasePart") then return sv.CFrame end
    local ok, cf = pcall(function() return hive:GetPivot() end)
    if ok and cf then return cf end
  end
  return nil
end

function ExtraUI.Bless.tpHive()
  local cf = ExtraUI.Bless.hiveCF()
  if not cf then return false, "own hive not found (claim a hive first)" end
  if ExtraUI.Bless.tp(cf.Position + Vector3.new(0, 4, 0)) then return true end
  return false, "no character"
end

function ExtraUI.Bless.tpMountain()
  local root = ExtraUI.Bless.root()

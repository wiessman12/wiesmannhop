local function closeHub()
  stopHubTweens()
  local back = hub.Position
  local info = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
  local tPos = TweenService:Create(hub, info, { Position = back + UDim2.fromOffset(0, 10), BackgroundTransparency = 0.2 })
  local tScale = TweenService:Create(hubScale, info, { Scale = 0.95 })
  local tDim = TweenService:Create(hubDim, info, { BackgroundTransparency = 1 })
  local tSh = TweenService:Create(hubShadow, info, { BackgroundTransparency = 0.9 })
  hubTweens = { tPos, tScale, tDim, tSh }

-- Right-edge scorch log for the current boosting streak (collapsed by default).
function ScorchPanel.build()
  local P = ScorchPanel
  local CW, EW, HH, RH = P.cw, P.ew, P.hh, P.rh

  function P.layout()
    local n = #P.items
    local h = P.open and (HH + RH * math.max(n, 1) + 4) or HH
    local w = P.open and EW or CW
    if P.tw then pcall(function() P.tw:Cancel() end) end
    if P.root then
      pinOnScreen(P.root, w, h)
      P.tw = TweenService:Create(P.root, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(w, h),
      })
      P.tw:Play()
      local tw = P.tw
      tw.Completed:Connect(function()
        if P.tw == tw and P.root then pinOnScreen(P.root, w, h) end
      end)
    end
    if P.arrow then P.arrow.Text = P.open and "›" or "‹" end
    if P.body then P.body.Visible = P.open end
  end

  function P.paint()
    if not P.body then return end
    local items, rows = P.items, P.rows
    for i = 1, math.max(#items, #rows) do
      local row = rows[i]
      if not row then
        row = Instance.new("TextLabel")
        row.BackgroundTransparency = 1
        row.Font = Enum.Font.GothamBold
        row.TextSize = 11
        row.TextColor3 = FieldFx.Notif.HONEY -- same letter colour as the Smiley log
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.Size = UDim2.new(1, -8, 0, RH)
        row.Position = UDim2.fromOffset(6, (i - 1) * RH)
        row.ZIndex = 8
        row.Parent = P.body
        addStroke(row, true)
        useFont(row)
        rows[i] = row
      end
      local it = items[i]
      if it then
        row.Text = tostring(it.n) .. " Scorch  " .. fmtHoney(it.g)
        row.TextColor3 = FieldFx.Notif.HONEY
        row.Visible = true
      else
        row.Text = ""
        row.Visible = false
      end
    end
    if #items == 0 and rows[1] then
      rows[1].Text = "—"
      rows[1].TextColor3 = Theme.muted
      rows[1].Visible = true
    end
    P.layout()
  end

  local root = Instance.new("Frame")
  root.Name = "__scorchlog"
  root:SetAttribute("BTTile", true)
  root.Size = UDim2.fromOffset(CW, HH)
  local sp = savedPos["__scorchlog"]
  root.Position = sp and UDim2.new(sp.sx or 0, sp.x, sp.sy or 0, sp.y) or UDim2.new(1, -CW, 0.36, 0)
  root.Active = true
  root.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
  root.BackgroundTransparency = 0.22
  root.BorderSizePixel = 0
  root.ClipsDescendants = true
  root.ZIndex = 6
  root.Parent = gui
  corner(root, 6)
  outline(root, Color3.fromRGB(200, 36, 52), 0.45)
  P.root = root

  local head = Instance.new("Frame")
  head.Size = UDim2.new(1, 0, 0, HH)
  head.BackgroundTransparency = 1
  head.BorderSizePixel = 0
  head.ZIndex = 7
  head.Parent = root

  local sic = Instance.new("ImageLabel")
  sic.BackgroundTransparency = 1
  sic.Size = UDim2.fromOffset(HH - 8, HH - 8)
  sic.Position = UDim2.fromOffset(6, 4)
  sic.ScaleType = Enum.ScaleType.Fit
  sic.Image = btAsset(PACK.scorch, nil)
  sic.ZIndex = 8
  sic.Parent = head
  btFallbackBadge(sic, "SS", 11, false)

  local lab = Instance.new("TextLabel")

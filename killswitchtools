local function rbxUrl(id)
  if type(id) ~= "string" or id == "" then return "" end
  if id:find("rbxasset", 1, true) then return id end
  return "rbxassetid://" .. id
end

local customAssetCache = {}

local function ensureIconCacheDir()
  if type(makefolder) == "function" then
    pcall(makefolder, "BuffTools")
    pcall(makefolder, "BuffTools/icons_r2")
    pcall(makefolder, "BuffTools/sounds")
  end
end
pcall(ensureIconCacheDir)

local function tryCustom(path)
  if type(getcustomasset) ~= "function" then
    return nil
  end
  local ok, res = pcall(getcustomasset, path)
  if ok and type(res) == "string" and res ~= "" then
    return res
  end
  return nil
end

local function btAsset(filename, rbxFallback)
  if type(filename) ~= "string" or filename == "" then
    return rbxUrl(rbxFallback)
  end
  local cached = customAssetCache[filename]
  if type(cached) == "string" and cached ~= "" then
    return cached
  end
  -- Prefer local pack / cache when the executor already has real PNGs
  for i = 1, #ICON_PREFIXES do
    local path = ICON_PREFIXES[i] .. filename
    if type(isfile) ~= "function" or isfile(path) then
      local res = tryCustom(path)
      if res then
        customAssetCache[filename] = res
        return res
      end
    end
  end
  -- Hard rbxassetid fallback — never leave beam HUD Image empty (green broken asset)
  local fb = rbxUrl(rbxFallback)
  if fb ~= "" then
    customAssetCache[filename] = fb
  end
  return fb
end


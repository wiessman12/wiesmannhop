ExtraUI.bestField = function()
  local bestName, bestN = nil, 0
  local words = ExtraUI.fieldWords
  for src, b in pairs(Buffs) do
    if type(src) == "string" and type(b) == "table" and type(b.combo) == "number" and b.combo > 0 then
      local low = src:lower()
      local skip = low == "boost" or low == "red boost" or low == "blue boost" or low == "white boost"
      if not skip and not low:find("morph", 1, true) and not low:find("petal", 1, true) then
        local left = buffLeft(src)
        if left == nil or left > 0 then
          local hit = false
          for i = 1, #words do
            if low:find(words[i], 1, true) then
              hit = true
              break
            end
          end
          if hit and b.combo > bestN then
            bestN = b.combo
            bestName = src
          end
        end
      end
    end
  end
  return bestName, bestN
end

ExtraUI.buffMatch = function(word)
  local bestName, bestCombo, bestLeft = nil, -1, nil
  local want = tostring(word):lower()
  for src, b in pairs(Buffs) do
    if type(src) == "string" and type(b) == "table" and src:lower():find(want, 1, true) then
      local left = buffLeft(src)
      if left == nil or left > 0 then
        local combo = type(b.combo) == "number" and b.combo or 0
        if combo <= 0 then
          local digits = src:match("[xX](%d+)")
          combo = tonumber(digits) or 0
        end
        local better = combo > bestCombo
        if not better and combo == bestCombo and type(left) == "number" then
          better = bestLeft == nil or left > bestLeft
        end
        if better then
          bestName, bestCombo, bestLeft = src, combo, left
        end
      end
    end
  end
  if not bestName then return nil, 0, nil end
  return bestName, bestCombo, bestLeft
end

-- Server confirmation. PlayerActivesCommand is a RemoteEvent (FireServer has no reply), so "fired" is not "used":
-- an item use is only CONFIRMED when the server's buff stream (onBuffEvent -> Buffs[src].evAt) applies / refreshes the
-- matching buff AFTER we fired. Unconfirmed uses are reported (log + status line) instead of silently counted as success.
ExtraUI.itemWatch = {}
ExtraUI.itemFailN = {}
ExtraUI.ITEM_WORDS = {
  ["Loaded Dice"] = { "pepper" },
  ["Super Smoothie"] = { "smoothie" },
  ["Cloud Vial"] = { "cloud" },
  ["Glitter"] = { "pepper", "glitter" },
  ["Oil"] = { "oil" },
  ["Tropical Drink"] = { "tropical" },
}
ExtraUI.ITEM_WAIT = { ["Loaded Dice"] = 9, ["Glitter"] = 6 } -- default 4s; dice need the whole roll animation
-- alternate display names are only retried for items whose buff we can really see (never for dice: they must not double-roll)
ExtraUI.ITEM_ALT = { ["Super Smoothie"] = { "SuperSmoothie", "Smoothie" } }

ExtraUI.itemSeen = function(itemName, since)
  local words = ExtraUI.ITEM_WORDS[itemName]
  if not words then return nil end -- unknown item: nothing to verify against
  for src, b in pairs(Buffs) do
    if type(src) == "string" and type(b) == "table" and type(b.evAt) == "number" and b.evAt >= since then
      local low = src:lower()
      for i = 1, #words do
        if low:find(words[i], 1, true) then return true end
      end
    end
  end
  return false
end

ExtraUI.fireItem = function(name)
  local payload = { Name = name }
  if ExtraUI.itemRemote then
    ExtraUI.itemRemote:FireServer(payload)
    return true
  elseif type(ExtraUI.itemCall) == "function" then
    ExtraUI.itemCall("PlayerActivesCommand", payload)
    return true
  end
  return false
end

-- called every boost tick: resolves pending item uses (confirmed / retry alternate name / report)
ExtraUI.itemCheck = function(now)
  for itemName, w in pairs(ExtraUI.itemWatch) do
    if now - w.at > 60 then
      ExtraUI.itemWatch[itemName] = nil -- stale (e.g. used outside a boost run)
    elseif ExtraUI.itemSeen(itemName, w.at) then
      ExtraUI.itemWatch[itemName] = nil
      ExtraUI.itemFailN[itemName] = 0
    elseif now - w.at >= (ExtraUI.ITEM_WAIT[itemName] or 4) then
      local alt = ExtraUI.ITEM_ALT[itemName]
      local nextName = alt and alt[w.tries]
      if nextName and pcall(ExtraUI.fireItem, nextName) then
        print(("[BuffTools boost] %s: no server confirmation, trying name '%s'"):format(itemName, nextName))
        w.tries = w.tries + 1
        w.at = os.clock()
      else
        ExtraUI.itemWatch[itemName] = nil
        ExtraUI.itemFailN[itemName] = (ExtraUI.itemFailN[itemName] or 0) + 1
        print(("[BuffTools boost] %s: sent but the server never confirmed it (no buff event)"):format(itemName))
        pcall(ExtraUI.boostSay, itemName .. " - not confirmed by the server")
      end
    end
  end
end

ExtraUI.useItem = function(itemName)
  local sent = false
  pcall(function()
    if not ExtraUI.itemCall and not ExtraUI.itemRemote then
      ExtraUI.itemCall = false
      local events = ReplicatedStorage:FindFirstChild("Events")
      local remote = events and events:FindFirstChild("PlayerActivesCommand")
      if not remote then
        remote = ReplicatedStorage:FindFirstChild("PlayerActivesCommand", true)
      end
      if remote and remote.FireServer then
        ExtraUI.itemRemote = remote
      end
      if not ExtraUI.itemRemote and events and events:IsA("ModuleScript") then
        local ok, mod = pcall(require, events)
        if ok and type(mod) == "table" and type(mod.ClientCall) == "function" then
          ExtraUI.itemCall = mod.ClientCall
        end
      end
    end
    local names = { itemName }
    -- BSS sometimes uses alternate display names
    if itemName == "Super Smoothie" then
      names = { "Super Smoothie", "SuperSmoothie", "Smoothie" }
    elseif itemName == "Loaded Dice" then
      names = { "Loaded Dice", "LoadedDice", "Dice" }
    elseif itemName == "Cloud Vial" then
      names = { "Cloud Vial", "CloudVial", "Cloud Vials" }
    elseif itemName == "Glitter" then
      names = { "Glitter" }
    end
    -- fire the primary name only; alternates are tried by itemCheck when the server does not confirm
    if ExtraUI.fireItem(names[1]) then
      sent = true
      if ExtraUI.ITEM_WORDS[itemName] then
        ExtraUI.itemWatch[itemName] = { at = os.clock(), tries = 1 }
      end
    end
  end)
  return sent
end

ExtraUI.boostSay = function(text)

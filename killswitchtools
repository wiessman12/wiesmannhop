local function fontWeight(obj)
  local f = obj.Font
  if f == Enum.Font.GothamBlack or f == Enum.Font.GothamBold or f == Enum.Font.SourceSansBold then
    return Enum.FontWeight.Bold
  end
  if f == Enum.Font.GothamMedium or f == Enum.Font.SourceSansSemibold then

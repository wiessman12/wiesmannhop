function RBC.showTip(text, round)
  if type(text) ~= "string" or text == "" then return end
  RBC.ensureTipGui()
  if not RBC.tipCard or not RBC.tipLabel then return end
  local lang = ExtraUI.vis.rbcLang == "ru" and "ru" or "en"
  if RBC.tipHead then
    RBC.tipHead.Text = lang == "ru" and ("СОВЕТ · Раунд " .. tostring(round or "?")) or ("RBC TIP · Round " .. tostring(round or "?"))
  end
  RBC.tipLabel.Text = text
  RBC.tipCard.Visible = true
  RBC.tipCard.BackgroundTransparency = 0.12
  RBC.tipHideAt = os.clock() + 14
end

function RBC.hideTip()
  if RBC.tipCard then
    RBC.tipCard.Visible = false
  end
  RBC.tipHideAt = 0
end

function RBC.readRoundAndActive()
  local now = os.clock()
  -- whole-PlayerGui text walk: do it rarely while idle, a bit faster inside a challenge
  local gap = RBC.inRbc and 1.6 or 6
  if type(RBC._guiAt) == "number" and (now - RBC._guiAt) < gap then
    return RBC._cachedRound, RBC._cachedActive == true
  end
  RBC._guiAt = now
  local pg = player:FindFirstChild("PlayerGui")
  if not pg then
    RBC._cachedRound, RBC._cachedActive = nil, false
    return nil, false
  end
  local bestRound, active = nil, false
  pcall(function()
    local cnt = 0
    for _, d in ipairs(pg:GetDescendants()) do
      cnt = cnt + 1
      if cnt % 1500 == 0 then task.wait() end
      if d:IsA("TextLabel") or d:IsA("TextButton") then
        local t = tostring(d.Text or "")
        if t ~= "" then
          local low = t:lower()
          if low:find("robo bear", 1, true) or low:find("robo-bear", 1, true)
            or low:find("commencing round", 1, true) or low:find("loading: round", 1, true) then
            active = true
          end
          local n = tonumber(t:match("[Rr]ound%s*:?%s*(%d+)") or t:match("Loading:%s*[Rr]ound%s*(%d+)")
            or t:match("Commencing%s+[Rr]ound%s*(%d+)") or t:match("Раунд%s*:?%s*(%d+)"))
          if n and n >= 1 and n <= 30 then
            if not bestRound or n > bestRound then
              bestRound = n
            end
            if n <= 25 then active = true end
          end
        end
      end
    end
  end)
  RBC._cachedRound, RBC._cachedActive = bestRound, active
  return bestRound, active
end

function RBC.maybeTip(round)
  if not RBC.tipsOn or not round then return end
  if RBC.lastTipRound == round then return end
  local lang = ExtraUI.vis.rbcLang == "ru" and "ru" or "en"
  if round == 14 then
    RBC.lastTipRound = round
    RBC.showTip(RBC.TIP14[lang] or RBC.TIP14.en, round)
    return
  end
  if round >= 3 and round % 3 == 0 then
    local list = RBC.TIPS[lang] or RBC.TIPS.en
    RBC.tipIndex = (RBC.tipIndex % #list) + 1
    RBC.lastTipRound = round
    RBC.showTip(list[RBC.tipIndex], round)
  end
end

function RBC.tick()
  local round, active = RBC.readRoundAndActive()
  RBC.inRbc = active == true
  if type(round) == "number" then
    RBC.round = round
  end
  if RBC.tipHideAt > 0 and os.clock() >= RBC.tipHideAt then
    RBC.hideTip()
  end
  if RBC.inRbc then
    if RBC.tipsOn then
      RBC.maybeTip(RBC.round)
    end
    RBC.setStatus("RBC " .. (RBC.round and ("round " .. tostring(RBC.round)) or "active"))
  else
    if RBC.tipHideAt == 0 or not RBC.tipsOn then
      RBC.hideTip()
    end
    RBC.setStatus(RBC.tipsOn and "waiting for RBC…" or "off")
  end
end

function RBC.setTips(on)
  RBC.tipsOn = on == true
  ExtraUI.vis.rbcTips = RBC.tipsOn
  if not RBC.tipsOn then RBC.hideTip() end
  RBC.ensureLoop()
end

function RBC.setLang(lang)
  if lang ~= "ru" and lang ~= "en" then lang = "en" end
  ExtraUI.vis.rbcLang = lang

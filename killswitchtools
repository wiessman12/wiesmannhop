ExtraUI.fillHive = function(page)
  local H = ExtraUI.hive
  H.page = page
  local R = 24
  local S3 = 1.7320508
  local fillImg = btAsset(PACK.hexFill, nil)
  local ringImg = btAsset(PACK.hexRing, nil)
  H.hasHex = fillImg ~= "" and ringImg ~= ""

  local subRow = Instance.new("Frame")
  subRow.BackgroundTransparency = 1
  subRow.BorderSizePixel = 0
  subRow.Size = UDim2.new(1, 0, 0, 30)
  subRow.LayoutOrder = 1
  subRow.Parent = page
  local subLay = Instance.new("UIListLayout")
  subLay.FillDirection = Enum.FillDirection.Horizontal
  subLay.Padding = UDim.new(0, 6)
  subLay.SortOrder = Enum.SortOrder.LayoutOrder
  subLay.Parent = subRow

  local holder = Instance.new("Frame")
  holder.LayoutOrder = 2
  holder.BackgroundTransparency = 1
  holder.BorderSizePixel = 0
  holder.Size = UDim2.new(1, 0, 0, 466)
  holder.Parent = page

  local gridW = 8 * R
  local gridH = math.floor(10.5 * S3 * R) + 2
  local grid = Instance.new("Frame")
  grid.BackgroundTransparency = 1
  grid.BorderSizePixel = 0
  grid.Size = UDim2.fromOffset(gridW, gridH)
  grid.Parent = holder

  for c = 1, 5 do
    H.cells[c] = {}
    for r = 1, 10 do
      local cx = R + (c - 1) * 1.5 * R
      local cy = S3 * R / 2 + (r - 1) * S3 * R + ((c % 2 == 1) and (S3 * R / 2) or 0)
      local b = Instance.new("ImageButton")
      b.Name = "Cell" .. c .. "_" .. r
      b.AnchorPoint = Vector2.new(0.5, 0.5)

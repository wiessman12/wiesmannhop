MorphTrack.dbg = function(key, msg, every)
  local now = os.clock()
  if every and now - (MorphTrack.dbgLast[key] or -1e9) < every then return end
  MorphTrack.dbgLast[key] = now
  print("[BuffTools alert] " .. msg)
  local L = MorphTrack.dbgLines
  L[#L + 1] = string.format("[%8.1f] %s", now, msg)
  if #L > 200 then table.remove(L, 1) end
  MorphTrack.dbgDirty = true
  MorphTrack.dbgFlush(false)
end

MorphTrack.ensureSound = function(file)
  local cached = MorphTrack.soundIds[file]
  if type(cached) == "string" and cached ~= "" then return cached end
  if type(makefolder) == "function" then
    pcall(makefolder, "BuffTools")
    pcall(makefolder, "BuffTools/sounds")
  end
  -- LOCAL FILES ONLY: this build downloads nothing. Put the .mp3 files into workspace/BuffTools/sounds/
  local locals = {
    "BuffTools/sounds/r3_" .. file,
    "BuffTools/sounds/r2_" .. file,
    "BuffTools/sounds/" .. file,
    "workspace/BuffTools/sounds/r3_" .. file,
    "workspace/BuffTools/sounds/r2_" .. file,
    "workspace/BuffTools/sounds/" .. file,
    "Workspace/BuffTools/sounds/r3_" .. file,
    "Workspace/BuffTools/sounds/r2_" .. file,
    "Workspace/BuffTools/sounds/" .. file,
    file,
    "workspace/" .. file,
    "Workspace/" .. file,
  }
  local id = nil
  for i = 1, #locals do
    local pth = locals[i]
    if type(isfile) ~= "function" or isfile(pth) then
      id = tryCustom(pth)
      if id and id ~= "" then break end
    end
  end
  if id and id ~= "" then
    MorphTrack.soundIds[file] = id
    MorphTrack.dbg("snd_ok_" .. file, "sound ready: " .. file, 60)
  else
    MorphTrack.dbg("snd_fail_" .. file, "sound NOT available: " .. file
      .. " (getcustomasset=" .. type(getcustomasset) .. ", isfile=" .. type(isfile)
      .. ") - put it into workspace/BuffTools/sounds/", 15)
  end
  return id
end
MorphTrack.playFile = function(file)
  if not MorphTrack.sndOn(file) then return end -- switched off in the Sounds tab
  task.spawn(function()
    local id = MorphTrack.ensureSound(file)
    if not id or id == "" or not Session.alive or not MorphTrack.sndOn(file) then return nil end
    local snd = MorphTrack.sounds[file]
    if not snd then
      snd = Instance.new("Sound")
      snd.Name = "BuffToolsSnd"
      snd.Volume = 1
      snd.Looped = false
      snd.Parent = game:GetService("SoundService")
      MorphTrack.sounds[file] = snd
    end
    pcall(function() snd:Stop() end)
    snd.SoundId = id
    snd.TimePosition = 0
    -- base loudness per sound (scorch / Precision are louder than 1) x the Sounds-tab sliders
    snd.Volume = MorphTrack.sndVol(file)
    local t0 = os.clock()
    while not snd.IsLoaded and os.clock() - t0 < 4 and Session.alive do task.wait(0.05) end
    pcall(function() snd:Play() end)
    if file == "cococombo.mp3" or file == "Precision.mp3" then
      MorphTrack.dbg("play_" .. file, string.format("play %s loaded=%s len=%.2fs playing=%s vol=%.1f",
        file, tostring(snd.IsLoaded), tonumber(snd.TimeLength) or 0, tostring(snd.IsPlaying), snd.Volume), 0)
    end
    return id
  end)
end

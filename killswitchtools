  bar.Position = UDim2.new(0, 50, 1, -4)
  bar.BackgroundColor3 = Color3.fromRGB(150, 40, 50)
  bar.BorderSizePixel = 0
  bar.Parent = f

  Tiles[id] = { frame = f, value = value, sub = sub, bar = bar, style = st, img = img, title = titleL }

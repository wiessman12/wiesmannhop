-- Sounds tab: one On/Off switch per sound + a master switch (state lives in MorphTrack.sndCfg, saved to bufftools_sounds.json)
ExtraUI.fillSounds = function(page)
  local M = MorphTrack
  local DIM, TXT = Color3.fromRGB(48, 18, 22), Color3.fromRGB(255, 244, 244)
  local ON = Color3.fromRGB(112, 30, 38)

  local sc = Instance.new("ScrollingFrame")
  sc.BackgroundTransparency = 1
  sc.BorderSizePixel = 0
  sc.Size = UDim2.fromScale(1, 1)
  sc.ScrollBarThickness = 5
  sc.ScrollBarImageColor3 = Color3.fromRGB(150, 40, 50)
  sc.ScrollingDirection = Enum.ScrollingDirection.Y
  sc.CanvasSize = UDim2.new()
  sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
  sc.Parent = page
  local list = Instance.new("UIListLayout")
  list.SortOrder = Enum.SortOrder.LayoutOrder
  list.Padding = UDim.new(0, 8)
  list.Parent = sc

  local head = Instance.new("TextLabel")
  head.BackgroundTransparency = 1
  head.Size = UDim2.new(1, -8, 0, 16)
  head.Font = Enum.Font.Gotham
  head.TextSize = 12
  head.TextXAlignment = Enum.TextXAlignment.Left
  head.TextColor3 = Color3.fromRGB(166, 146, 124)
  head.Text = "SOUNDS - on / off + volume (drag the slider, click the % to reset)"
  head.LayoutOrder = 1
  head.Parent = sc

  local refreshers = {}
  local function repaintAll()
    for i = 1, #refreshers do refreshers[i]() end
  end

  -- one row: [name / hint ........ [On|Off]]
  -- preview after a slider is released (Precision is a looping alert: only when it is not running right now)
  local function preview(file)
    if not file or not M.sndOn(file) then return end
    if file == "Precision.mp3" and M.precisionAlertOn then return end
    M.playFile(file)
    if file == "Precision.mp3" then
      task.delay(3, function()
        if not M.precisionAlertOn then
          local s = M.sounds[file]
          if s then pcall(function() s:Stop() end) end
        end
      end)
    end
  end

  -- vkey = key of the volume multiplier in M.sndCfg ("vol" master / "v_<key>"), file = sound used for the preview
  local function row(order, name, hint, get, set, vkey, file)
    local f = Instance.new("Frame")
    f.LayoutOrder = order
    f.Size = UDim2.new(1, -8, 0, vkey and 74 or 46)
    f.BackgroundColor3 = Color3.fromRGB(24, 20, 23)
    f.BorderSizePixel = 0
    f.Parent = sc
    corner(f, 6)
    local n = Instance.new("TextLabel")
    n.BackgroundTransparency = 1
    n.Position = UDim2.fromOffset(14, 5)
    n.Size = UDim2.new(1, -110, 0, 20)
    n.Font = Enum.Font.GothamMedium
    n.TextSize = 15
    n.TextXAlignment = Enum.TextXAlignment.Left
    n.TextTruncate = Enum.TextTruncate.AtEnd
    n.TextColor3 = Color3.fromRGB(234, 228, 225)
    n.Text = name
    n.Parent = f
    local h = Instance.new("TextLabel")
    h.BackgroundTransparency = 1
    h.Position = UDim2.fromOffset(14, 25)
    h.Size = UDim2.new(1, -110, 0, 16)
    h.Font = Enum.Font.Gotham
    h.TextSize = 12
    h.TextXAlignment = Enum.TextXAlignment.Left
    h.TextTruncate = Enum.TextTruncate.AtEnd
    h.TextColor3 = Color3.fromRGB(138, 128, 128)
    h.Text = hint
    h.Parent = f
    local b = Instance.new("TextButton")
    b.AnchorPoint = Vector2.new(1, 0.5)
    b.Position = UDim2.new(1, -12, 0.5, 0)
    b.Size = UDim2.fromOffset(74, 28)
    b.BackgroundColor3 = DIM
    b.TextColor3 = TXT
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 15
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.Parent = f
    corner(b, 6)
    local function paint()
      local on = get()
      b.Text = on and "On" or "Off"
      b:SetAttribute("BTOn", on)
      b.BackgroundColor3 = on and ON or DIM
      n.TextColor3 = on and Color3.fromRGB(234, 228, 225) or Color3.fromRGB(138, 128, 128)
    end
    b.MouseEnter:Connect(function()
      if b:GetAttribute("BTOn") ~= true then b.BackgroundColor3 = Color3.fromRGB(72, 26, 32) end
    end)
    b.MouseLeave:Connect(function()
      if b:GetAttribute("BTOn") ~= true then b.BackgroundColor3 = DIM end
    end)
    b.MouseButton1Click:Connect(function()
      set(not get())
      M.sndSave()
      pcall(M.sndApply)
      repaintAll()
    end)
    refreshers[#refreshers + 1] = paint
    paint()

    if vkey then
      -- volume slider 0..200 % (step 5 %, default 100 %); drag it, release = save + preview; click the % to reset
      local track = Instance.new("TextButton")
      track.Text = ""
      track.AutoButtonColor = false
      track.Position = UDim2.fromOffset(14, 55)
      track.Size = UDim2.new(1, -86, 0, 8)
      track.BackgroundColor3 = Color3.fromRGB(48, 40, 44)
      track.BorderSizePixel = 0
      track.Parent = f
      corner(track, 4)
      local fill = Instance.new("Frame")
      fill.BackgroundColor3 = Color3.fromRGB(150, 40, 50)
      fill.BorderSizePixel = 0
      fill.Size = UDim2.fromScale(0.5, 1)
      fill.Parent = track
      corner(fill, 4)
      local knob = Instance.new("Frame")
      knob.AnchorPoint = Vector2.new(0.5, 0.5)
      knob.Size = UDim2.fromOffset(14, 14)
      knob.Position = UDim2.fromScale(0.5, 0.5)
      knob.BackgroundColor3 = Color3.fromRGB(234, 228, 225)
      knob.BorderSizePixel = 0
      knob.Parent = track
      corner(knob, 7)
      local pct = Instance.new("TextButton")
      pct.AnchorPoint = Vector2.new(1, 0)
      pct.Position = UDim2.new(1, -12, 0, 47)
      pct.Size = UDim2.fromOffset(56, 24)
      pct.BackgroundColor3 = DIM
      pct.TextColor3 = TXT
      pct.Font = Enum.Font.GothamMedium
      pct.TextSize = 13
      pct.AutoButtonColor = false
      pct.BorderSizePixel = 0
      pct.Parent = f
      corner(pct, 5)

      local function paintVol()
        local v = tonumber(M.sndCfg[vkey]) or 1
        fill.Size = UDim2.fromScale(v / 2, 1)
        knob.Position = UDim2.fromScale(v / 2, 0.5)
        pct.Text = math.floor(v * 100 + 0.5) .. "%"
      end
      local function setFromX(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local a = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        M.sndCfg[vkey] = math.floor(a * 40 + 0.5) / 20
        paintVol()
        pcall(M.sndApplyVol)
      end
      local function isPointer(inp, move)
        local t = inp.UserInputType
        if move then return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch end
        return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
      end
      local dragging = false
      track.InputBegan:Connect(function(inp)
        if isPointer(inp, false) then
          dragging = true
          setFromX(inp.Position.X)
        end
      end)
      Session.track(UIS.InputChanged:Connect(function(inp)
        if dragging and isPointer(inp, true) then setFromX(inp.Position.X) end
      end))
      Session.track(UIS.InputEnded:Connect(function(inp)
        if dragging and isPointer(inp, false) then
          dragging = false
          M.sndSave()
          preview(file)
        end
      end))
      pct.MouseButton1Click:Connect(function()
        M.sndCfg[vkey] = 1
        paintVol()
        pcall(M.sndApplyVol)
        M.sndSave()
        preview(file)
      end)
      refreshers[#refreshers + 1] = paintVol
      paintVol()
    end
  end

  row(2, "All sounds", "master switch + master volume",
    function() return M.sndCfg.all ~= false end,
    function(v) M.sndCfg.all = v end, "vol", "Double Morph.mp3")
  for i, s in ipairs(M.SND) do
    row(2 + i, s.name, s.hint,
      function() return M.sndCfg[s.key] ~= false end,
      function(v) M.sndCfg[s.key] = v end, "v_" .. s.key, s.file)
  end
  useFonts(page)
end

-- Honey / pollen by ability. Session keeps both; the Unit button switches the table.
ExtraUI.fillStats = function(page)
  local P = FieldFx.PStats
  local ROWS = 36
  local function mkText(parent, size, color, font, align)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Font = font or Enum.Font.Gotham
    l.TextSize = size
    l.TextColor3 = color
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = parent
    return l
  end

  local head = mkText(page, 12, Color3.fromRGB(166, 146, 124))
  head.Size = UDim2.new(1, 0, 0, 16)
  head.Text = "HONEY BY ABILITY · this session"
  head.LayoutOrder = 1

  local sum = mkText(page, 14, Color3.fromRGB(255, 214, 150), Enum.Font.GothamMedium)
  sum.Size = UDim2.new(1, 0, 0, 20)
  sum.LayoutOrder = 2
  sum.Text = "waiting for honey…"

  local list = Instance.new("ScrollingFrame")
  list.LayoutOrder = 3
  list.Size = UDim2.new(1, 0, 0, 380)
  list.BackgroundColor3 = Color3.fromRGB(24, 20, 23)
  list.BorderSizePixel = 0
  list.ScrollBarThickness = 4
  list.ScrollBarImageColor3 = Color3.fromRGB(150, 40, 50)
  list.CanvasSize = UDim2.new()
  list.AutomaticCanvasSize = Enum.AutomaticSize.Y
  list.Parent = page
  corner(list, 6)
  local lp = Instance.new("UIPadding")
  lp.PaddingTop, lp.PaddingBottom, lp.PaddingLeft, lp.PaddingRight = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 8), UDim.new(0, 10)
  lp.Parent = list
  local ll = Instance.new("UIListLayout")
  ll.SortOrder = Enum.SortOrder.LayoutOrder
  ll.Padding = UDim.new(0, 2)
  ll.Parent = list

  local rows = {}
  for i = 1, ROWS do
    local r = Instance.new("Frame")
    r.LayoutOrder = i
    r.Size = UDim2.new(1, 0, 0, 22)
    r.BackgroundTransparency = 1
    r.BorderSizePixel = 0
    r.Visible = false
    r.Parent = list
    local bar = Instance.new("Frame")
    bar.BackgroundColor3 = Color3.fromRGB(112, 30, 38)
    bar.BackgroundTransparency = 0.35
    bar.BorderSizePixel = 0
    bar.Size = UDim2.new(0, 0, 1, 0)
    bar.Parent = r
    corner(bar, 4)
    local name = mkText(r, 13, Color3.fromRGB(240, 232, 232))
    name.Position = UDim2.fromOffset(6, 0)
    name.Size = UDim2.new(0.52, 0, 1, 0)
    local amt = mkText(r, 13, Color3.fromRGB(255, 214, 150), Enum.Font.GothamMedium, Enum.TextXAlignment.Right)
    amt.Position = UDim2.new(0.52, 0, 0, 0)
    amt.Size = UDim2.new(0.28, 0, 1, 0)
    local pct = mkText(r, 13, Color3.fromRGB(190, 176, 176), Enum.Font.Gotham, Enum.TextXAlignment.Right)
    pct.Position = UDim2.new(0.80, 0, 0, 0)
    pct.Size = UDim2.new(0.20, -4, 1, 0)
    rows[i] = { frame = r, bar = bar, name = name, amt = amt, pct = pct }
  end

  -- session unit is honey or pollen. lifetime is only honey-by-tag, if the save has it.
  local mode = "session"
  local unit = "honey"
  local life, lifeErr, lifeBusy = nil, nil, false

  -- returns rows {name, value}, total, subtitle
  local function view()
    if mode == "life" then
      if life then
        local lr, lt = P.lifeView(life)
        local named = {}
        for i, r in ipairs(lr) do
          local nm = r[1]
          if r[3] then nm = nm .. " ×" .. fmtHoney(r[3]) end -- token pick count from Collectibles
          named[i] = { nm, r[2] }
        end
        return named, lt, "all time · live · linked " .. ExtraUI.fmtCd(os.clock() - life.at) .. " ago"
      end
      return {}, 0, lifeBusy and "reading player data…" or (lifeErr or "press Reload")
    end
    local el = math.max(1, os.clock() - P.since)
    if unit ~= "pollen" then
      local rws, total, dup, convert = P.honeyRows()
      local sub = "waiting for honey…"
      if total > 0 then
        local hpp = P.hpp or (P.pol.total > 0 and (total / P.pol.total) or 0)
        sub = fmtHoney(total) .. " honey · " .. fmtHoney(total / el) .. "/s · "
          .. string.format("×%.2f per pollen", hpp) .. " · "
          .. string.format("duped %.0f%%", dup / total * 100) .. " · " .. ExtraUI.fmtCd(el)
      end
      return rws, total, sub
    end
    local b = P.pol
    local keys = {}
    for k in pairs(b.tot) do keys[#keys + 1] = k end
    table.sort(keys, function(a, c) return b.tot[a] > b.tot[c] end)
    local rws = {}
    for i, k in ipairs(keys) do
      local nm = k
      if k == "Smile" and b.smilePicks > 0 then nm = k .. " ×" .. tostring(b.smilePicks) end
      rws[i] = { nm, b.tot[k] }
    end
    local sub = "waiting for pollen…"
    if b.total > 0 then
      sub = fmtHoney(b.total) .. " pollen · " .. fmtHoney(b.total / el) .. "/s · "
        .. string.format("duped %.0f%%", b.dup / b.total * 100) .. " · " .. ExtraUI.fmtCd(el)
    end
    return rws, b.total, sub
  end

  local function report()
    local rws, total = view()
    local col = (mode == "session" and unit == "pollen") and "POLLEN" or "HONEY"
    local lines = { string.format("%-30s %10s %7s", "ABILITY", col, "SHARE") }
    for _, r in ipairs(rws) do
      lines[#lines + 1] = string.format("%-30s %10s %6.1f%%", r[1], fmtHoney(r[2]), total > 0 and r[2] / total * 100 or 0)
    end
    return table.concat(lines, "\n")
  end

  local function paint()
    local rws, total, sub = view()
    sum.Text = (mode == "life" and life) and (fmtHoney(total) .. " honey · " .. sub) or sub
    for i = 1, ROWS do
      local row, r = rows[i], rws[i]
      if r then
        local share = total > 0 and (r[2] / total) or 0
        row.frame.Visible = true
        row.name.Text = r[1]
        row.amt.Text = fmtHoney(r[2])
        row.pct.Text = string.format("%.1f%%", share * 100)
        row.bar.Size = UDim2.new(math.clamp(share, 0, 1), 0, 1, 0)
      else
        row.frame.Visible = false
      end
    end
  end

  local btns = Instance.new("Frame")
  btns.LayoutOrder = 4
  btns.BackgroundTransparency = 1
  btns.BorderSizePixel = 0
  btns.Size = UDim2.new(1, 0, 0, 36)
  btns.Parent = page
  local g = Instance.new("UIGridLayout")
  g.CellSize = UDim2.new(1 / 4, -6, 1, 0)
  g.CellPadding = UDim2.fromOffset(8, 0)
  g.SortOrder = Enum.SortOrder.LayoutOrder
  g.Parent = btns
  local function mkBtn(text, order, fn)
    local b = Instance.new("TextButton")
    b.LayoutOrder = order
    b.BackgroundColor3 = Color3.fromRGB(48, 18, 22)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(255, 244, 244)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.TextScaled = true
    local lim = Instance.new("UITextSizeConstraint")
    lim.MaxTextSize = 13
    lim.MinTextSize = 8
    lim.Parent = b
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.Parent = btns
    corner(b, 6)
    b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(72, 26, 32) end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = Color3.fromRGB(48, 18, 22) end)
    b.MouseButton1Click:Connect(fn)
    return b
  end

  local function loadLife()
    if lifeBusy then return end
    lifeBusy, lifeErr = true, nil
    paint()
    task.spawn(function()
      task.wait(0.05)
      local res, err = P.loadLifetime()
      lifeBusy = false
      if res then life = res else lifeErr = err or "failed" end
      pcall(paint)
    end)
  end

  local modeBtn, unitBtn, actBtn
  local function paintBtns()
    modeBtn.Text = mode == "life" and "Lifetime" or "Session"
    unitBtn.Text = unit == "pollen" and "Pollen" or "Honey"
    actBtn.Text = mode == "life" and "Reload" or "Reset"
    if mode == "life" then
      head.Text = "HONEY BY ABILITY · lifetime"
    else
      head.Text = (unit == "pollen" and "POLLEN" or "HONEY") .. " BY ABILITY · this session"
    end
  end
  modeBtn = mkBtn("Session", 1, function()
    mode = mode == "life" and "session" or "life"
    paintBtns()
    if mode == "life" and not life then loadLife() end
    paint()
  end)
  unitBtn = mkBtn("Honey", 2, function()
    unit = unit == "honey" and "pollen" or "honey"
    if mode == "life" then mode = "session" end
    paintBtns()
    paint()
  end)
  actBtn = mkBtn("Reset", 3, function()
    if mode == "life" then
      loadLife()
    else
      P.reset()
      paint()
    end
  end)
  local copyBtn
  copyBtn = mkBtn("Copy", 4, function()
    local ok = false
    if type(setclipboard) == "function" then ok = pcall(setclipboard, report()) end
    copyBtn.Text = ok and "Copied" or "No clipboard"
    task.delay(1.5, function() if copyBtn.Parent then copyBtn.Text = "Copy" end end)
  end)
  paintBtns()

  useFonts(page)
  task.spawn(function()
    while Session.alive and page.Parent do
      if page.Visible then
        pcall(paint)
        task.wait(0.5)
      else
        task.wait(0.6)
      end
    end
  end)
end


  UI.bindHover(clearBtn, Color3.fromRGB(72, 24, 30), Color3.fromRGB(110, 36, 44), Color3.fromRGB(255, 232, 234), Theme.text)
  clearBtn.MouseButton1Click:Connect(function()
    if ScorchPanel.clear then
      ScorchPanel.clear()
    end
    clearBtn.Text = "Cleared"
    task.delay(0.9, function()
      if clearBtn and clearBtn.Parent then
        clearBtn.Text = "Clear scorch logs"
      end
    end)
  end)

  -- Clear smiley logs: same button next to it (empties the Smiley log panel + its session counters)
  local clearSmileBtn = Instance.new("TextButton")
  clearSmileBtn.Size = UDim2.new(0.5, -4, 1, 0)

  resetBtn.MouseButton1Click:Connect(function()
    for k, v in pairs(ExtraUI.visDefaults) do
      ExtraUI.vis[k] = v
    end
    pcall(function() Speed.set(ExtraUI.vis.speed == true) end)
    pcall(function() AntiGlider.set(ExtraUI.vis.antiGlider == true) end)
    pcall(function() ExtraUI.Night.set(ExtraUI.vis.night == true) end)
    pcall(function() StickBug.setDrink(ExtraUI.vis.stickDrink == true) end)
    pcall(function() StickBug.setTp(ExtraUI.vis.stickTp == true) end)
    pcall(function() RBC.setLang(ExtraUI.vis.rbcLang) end)
    for _, paint in pairs(ExtraUI.rowPaint) do
      paint(true)
    end
    ExtraUI.AntiLag.applyAll()
    if type(ExtraUI.applyVisuals) == "function" then
      pcall(ExtraUI.applyVisuals)
    end
    ExtraUI.bssApply()
    pcall(ExtraUI.bssMoveMode, false)
    ExtraUI.bss.off = {}
    pcall(ExtraUI.bssApplyOffsets)
    ExtraUI.bss.orig = {}
    pcall(ExtraUI.hudSave)
    if type(ExtraUI.bss.paintMove) == "function" then pcall(ExtraUI.bss.paintMove) end
    local defaults = {
      precision = UDim2.fromOffset(16, 60),
      pmark = UDim2.fromOffset(16, 138),
      scorch = UDim2.fromOffset(16, 216),
      xflame = UDim2.fromOffset(16, 294),
      morph = UDim2.fromOffset(16, 372),
      petals = UDim2.fromOffset(16, 450),
      honey = UDim2.fromOffset(16, 528),
      __toggle = UDim2.new(0, 18, 0.55, -23),
    }
    for _, child in ipairs(gui:GetChildren()) do
      if child:GetAttribute("BTTile") then
        if child.Name == "__scorchlog" then
          local w, h = dragBoxSize(child)
          child.Position = UDim2.new(1, -ScorchPanel.cw, 0.36, 0)
          pinOnScreen(child, w, h)
        elseif child.Name == "__smilelog" then
          local w, h = dragBoxSize(child)
          child.Position = UDim2.new(1, -FieldFx.SmilePanel.cw, 0.28, 0)
          pinOnScreen(child, w, h)
        elseif defaults[child.Name] then
          child.Position = defaults[child.Name]
        end
      end
    end
    ExtraUI.apply()
    savePositions()
  end)


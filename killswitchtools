  img.Parent = badge

  if img.Image == "" then
    local glyph = Instance.new("TextLabel")
    glyph.Size = UDim2.fromScale(1, 1)
    glyph.BackgroundTransparency = 1
    glyph.Text = st.glyph
    glyph.TextColor3 = st.color
    glyph.Font = Enum.Font.GothamBlack
    glyph.TextSize = 14
    glyph.Parent = badge
    addStroke(glyph)

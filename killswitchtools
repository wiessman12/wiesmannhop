  local rbcTab = makeTab("RBC", 6)
  local hiveTab = makeTab("Hive", 7)
  local blessTab = makeTab("Blessing", 8)
  local statsTab = makeTab("Stats", 9)
  local whiteTab = makeTab("White", 10)
  local infoTab = makeTab("Info", 11)
  local notifyTab = makeTab("Notify", 12)

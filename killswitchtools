MorphTrack.dbgFlush = function(force)
  if not MorphTrack.dbgDirty then return end
  local now = os.clock()
  if not force and now - MorphTrack.dbgFlushAt < 1.5 then return end
  MorphTrack.dbgFlushAt = now
  MorphTrack.dbgDirty = false
  if type(writefile) == "function" then
    pcall(writefile, "bufftools_alerts.log", table.concat(MorphTrack.dbgLines, "\n"))
  end
